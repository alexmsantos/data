db=IMAGENS","slug":null,"url":null},"rubric":{"name":"Conteúdo comercial","url":"https://www.publico.pt/2026/07/23/estudiop/noticia/palco-ambicao-investimento-crescimento-2181595"},"id":2181595,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":22,"title":"Menos plástico, mais reciclagem: o que vai mudar nas embalagens até 2030","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2110376?tp=UH&db=IMAGENS&type=JPG","author":[{"id":6488,"nome":"Aline Flor","descricao":"Natural do Rio de Janeiro, vivo em Portugal há quase 30 anos. Criei raízes. Fui directora do Jornal Universitário do Porto, passei pela Ciência e Tecnologia no Canal Superior, editei notícias do portal AEIOU.pt. Fiz um mestrado em Cinema Documental que me abriu os olhos (e ouvidos) para a riqueza de cada encontro com o outro. Cheguei ao PÚBLICO para integrar a equipa de áudio, onde produzi podcasts em áreas desde a igualdade de género às questões europeias. Hoje sou editora do Azul, a nossa secção dedicada à crise climática e sustentabilidade, e aventurei-me num segundo mestrado: Economia e Gestão do Ambiente. Gosto de ouvir e de contar as histórias que ficam à margem e acredito que temos sempre algo a aprender quando encaramos o desafio de traduzir no preto e branco dos caracteres as infinitas tonalidades que nos rodeiam.","email":"aline.flor@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"aline-flor","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Aline Flor z.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1530339?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#114;&#111;&#108;&#102;&#46;&#101;&#110;&#105;&#108;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Novo regulamento europeu de embalagens entra em vigor de forma faseada até 2030, proibindo PFAS, plástico descartável e excesso de embalagem e obrigando à reciclabilidade.","url":"/2026/08/19/azul/noticia/menos-plastico-reciclagem-vai-mudar-embalagens-ate-2030-2185383","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Reciclagem","url":"https://www.publico.pt/2026/08/19/azul/noticia/menos-plastico-reciclagem-vai-mudar-embalagens-ate-2030-2185383"},"id":2185383,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":23,"title":"Movimento exige coerência entre restauro dos rios e novas construções no Tejo","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2110616?tp=UH&db=IMAGENS&type=JPG","author":[{"id":490,"nome":"Carlos Dias","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"carlos-dias","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"O Plano Nacional de Restauro da Natureza propõe a remoção de açudes, moinhos e levadas, mas ao mesmo tempo contempla a construção de grandes barragens.","url":"/2026/08/19/azul/noticia/movimento-exige-coerencia-restauro-rios-novas-construcoes-tejo-2185482","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Barragens","url":"https://www.publico.pt/2026/08/19/azul/noticia/movimento-exige-coerencia-restauro-rios-novas-construcoes-tejo-2185482"},"id":2185482,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":24,"title":"Reportagem do PÚBLICO sobre barracas vence Prémio Literário Orlando Gonçalves","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2110588?tp=UH&db=IMAGENS&type=JPG","author":[{"id":90,"nome":"Lusa","descricao":"","email":"","