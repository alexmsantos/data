scricao":"","email":"gina.pereira@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Editora de Sociedade","profissaoNaAltura":"","slug":"gina-pereira","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#105;&#101;&#114;&#101;&#112;&#46;&#97;&#110;&#105;&#103;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Governo mantém que pretende aumentar a capacidade de resposta nesta área, assegurando que processo decorre com rigor técnico e institucional. Os dois projectos-piloto em vigor estão aquém do esperado.","url":"/2026/08/20/sociedade/noticia/novos-centros-avaliacao-medica-renovar-cartas-conducao-nao-sairam-papel-2184459","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Saúde","url":"https://www.publico.pt/2026/08/20/sociedade/noticia/novos-centros-avaliacao-medica-renovar-cartas-conducao-nao-sairam-papel-2184459"},"id":2184459,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":7,"title":"Quase 50 queixas de racismo por analisar: comissão acusa PSD de bloqueio","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2110617?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1081,"nome":"Patrícia Carvalho","descricao":"Nasci no Porto, fiz a licenciatura em Ciências da Comunicação na Universidade Nova de Lisboa, entre 1993 e 1997, e estagiei no Jornal do Letras. Apesar da insistência de chefes e colegas para ficar pela capital, preferi voltar a casa e estive com a equipa que abriu o 24horas no Porto. Saí ao fim de um ano, para O Comércio do Porto, onde fiquei até ao seu encerramento, em 2005. Antes de ingressar no PÚBLICO, em 2008, colaborei com várias publicações, incluindo a Grande Reportagem, Visão, Notícias de Sábado e Sábado. No PÚBLICO, integro, desde a minha chegada, a equipa do Local Porto, mas fui sempre participando em outras áreas do jornal, com trabalhos para o P2 ou a Pública (que, entretanto, terminaram), a Fugas ou, mais recentemente, a revista 2.","email":"patricia.carvalho@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"patricia-carvalho","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Patricia Carvalho.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1381570?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#104;&#108;&#97;&#118;&#114;&#97;&#99;&#46;&#97;&#105;&#99;&#105;&#114;&#116;&#97;&#112;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Instalações atribuídas pela Assembleia da República ficam num 2.º andar só acessível “por uma escada íngreme e estreita” e não permitem ter “porta aberta ao público”, acusa relatório.","url":"/2026/08/20/sociedade/noticia/40-queixas-racismo-resposta-presidente-comissao-acusa-psd-travar-funcionamento-organismo-2185498","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Racismo","url":"https://www.publico.pt/2026/08/20/sociedade/noticia/40-queixas-racismo-resposta-presidente-comissao-acusa-psd-travar-funcionamento-organismo-2185498"},"id":2185498,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":8,"title":"Concorrência quer fim do domínio da CP e Fertagus na ferrovia","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2110879?tp=UH&db=IMAGENS&type=JPG","author":[{"id":19360,"nome":"Diogo Cavaleiro","descricao":"Estagiei no PÚBLICO em 2009 no Local Lisboa, tendo no ano seguinte entrado no <em>Jornal de Negócios</em>, onde fiquei por quase nove anos. O sector bancário foi aquele em que me especializei, tendo publicado um livro – <em>Caixa Negra</em> – sobre décadas de gestão e polémica na Caixa Geral de Depósitos, em 2017. Em 2019, segui para o <em>Expresso</em>, continuando na mesma área, onde fiquei até Maio de 2025. Regresso agora ao PÚBLICO para continuar esse trabalho, integrando a secção de Economia. Licenciado em Ciências da Comunicação, tenho pós-graduações em Ciência Política – Relações Internacionais, na vertente de Estudos Europeus, e em Compliance.","email":"diogo.cavaleiro@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"diogo-cavaleiro","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Diogo Cavaleiro.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/2051033?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#114;&#105;&#101;&#108;&#97;&#118;&#97;&#99;&#46;&#111;&#103;&#111;&#105;&#100;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Autoridade da Concorrência deixa 19 recomendações para uma ferrovia mais liberalizada, não só por via de concursos para prestar serviço público, como pela concorrência nas rotas mais atractivas.","url":"/2026/08/20/economia/noticia/concorrencia-quer-fim-dominio-cp-fertagus-acena-regras-flexiveis-novos-operadores-2185625","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Ferrovia","url":"https://www.publico.pt/2026/08/20/economia/noticia/concorrencia-quer-fim-dominio-cp-fertagus-acena-regras-flexiveis-novos-operadores-2185625"},"id":2185625,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":9,"title":"INEM compra 1400 monitores para todas as ambulâncias fazerem electrocardiogramas","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2110843?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1050,"nome":"Mariana Oliveira","descricao":"Nasci no Porto em 1978 e fiz a licenciatura em Direito na Faculdade de Direito da Universidade do Porto. Quando optei por este curso, já tinha a intenção de me tornar jornalista, seguindo o conselho de alguns profissionais da classe. Depois de terminar a licenciatura, candidatei-me à Formação Geral – Especialização em Jornalismo no Centro Protocolar de Formação Profissional para Jornalistas (Cenjor), em Lisboa. Por isso vivi na capital quase oito meses, entre Dezembro de 2001 e Julho de 2002. Nesse mês, decidi regressar ao Porto para fazer o estágio integrado nessa formação. Fui jornalista estagiária no PÚBLICO entre Julho e Outubro e comecei a trabalhar em Fevereiro de 2003. No início, cobri mais intensivamente áreas ligadas à protecção civil. Actualmente, dedico-me à área da Justiça.","email":"meoliveira@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"mariana-oliveira","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#105;&#101;&#118;&#105;&#108;&#111;&#101;&#109;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"O instituto também quer bombeiros a administrar fármaco usados em casos graves de baixo nível de açúcar no sangue. Formação arranca em Setembro.","url":"/2026/08/20/sociedade/noticia/inem-compra-1400-monitores-ambulancias-poderem-electrocardiogramas-2185605","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"INEM","url":"https://www.publico.pt/2026/08/20/sociedade/noticia/inem-compra-1400-monitores-ambulancias-poderem-electrocardiogramas-2185605"},"id":2185605,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":10,"title":"Portugal tem “das electricid