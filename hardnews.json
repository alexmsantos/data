Image":false,"isExternal":true,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#101;&#117;&#113;&#105;&#98;&#109;&#97;&#99;&#111;&#109;&#101;&#100;&#105;&#112;","contribuicao":null,"tipo":"EXTERNO"},{"id":7325,"nome":"Joana Gonçalves","descricao":"Comecei na Rádio Renascença, em 2018, depois de um estágio que também passou pelas redações do Expresso e SIC. Na RR trabalhei na edição da tarde, mas foi na secção de Multimédia que aprendi que também na rádio há lugar para a imagem. Cheguei ao PÚBLICO em 2022.","email":"jmgoncalves@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Jornalista multimédia","profissaoNaAltura":"Jornalista multimédia","slug":"joana-goncalves","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#118;&#108;&#97;&#99;&#110;&#111;&#103;&#109;&#106;","contribuicao":null,"tipo":"INTERNO"},{"id":18382,"nome":"José Carvalheiro","descricao":"","email":"Jose.Carvalheiro@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Motion designer","profissaoNaAltura":"Motion designer","slug":"jose-carvalheiro","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#114;&#105;&#101;&#104;&#108;&#97;&#118;&#114;&#97;&#67;&#46;&#101;&#115;&#111;&#74;","contribuicao":null,"tipo":"INTERNO"}],"shares":0,"description":"<p>Quase meio milh&atilde;o de pessoas fugiu de Espanha nos primeiros meses de 1939.</p>\r\n","url":"/2026/08/30/video/destino-milhares-portugueses-indesejaveis-apos-ascensao-franco-20260828-130232","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Vídeo","url":"/video-"},"id":98165,"type":"VIDEO","isMultipleRubric":false,"tag":null,"size":30},{"pos":18,"title":"Receitas do turismo acentuam abrandamento no semestre","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2112683?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1068,"nome":"Luís Villalobos","descricao":"Comecei a trabalhar como jornalista profissional em 1992, na secção de economia do Semanário. Em 1994 apostei na vida de free-lancer, enquanto frequentava o curso de História, tendo colaborado para vários jornais e revistas. Em 2000 entrei para a revista Fortuna, da qual já era colaborador. Três anos depois tive a minha estreia nos diários, no Diário Económico, de onde transitei como editor para a Exame no final de 2005. Em 2007, cheguei ao PÚBLICO, para editar o suplemento de Economia. Actualmente, sou redactor da secção. Ganhei três prémios, o último dos quais na categoria nacional de imprensa e online do Ano Europeu do Combate à Pobreza e Exclusão Social. Sou co-autor do livro, “Negócios Vigiados”, sobre a PIDE e as empresas, e coordenei a obra “Quero um emprego!”, de Elisabete Sá, Raquel Almeida Correia e Ana Rute Silva.","email":"luis.villalobos@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"luis-villalobos","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Luis Villalobos.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1527219?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":",Sistema de gerenciamento de conteúdo","translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#111;&#98;&#111;&#108;&#97;&#108;&#108;&#105;&#118;&#46;&#115;&#105;&#117;&#108;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Receitas do turismo subiram 4,2% no primeiro semestre para 12.871 milhões de euros. Excluíndo os anos de queda, como na pandemia, é preciso recuar a 2002 para encontrar um crescimento mais baixo.","url":"/2026/08/30/economia/noticia/receitas-turismo-acentuam-abrandamento-semestre-2186474","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Conjuntura","url":"https://www.publico.pt/2026/08/30/economia/noticia/receitas-turismo-acentuam-abrandamento-semestre-2186474"},"id":2186474,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":19,"title":"Domingos Simões Pereira diz que o pior da prisão foi “a gestão do vazio”","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2112687?tp=UH&db=IMAGENS&type=JPG","author":[{"id":3527,"nome":"António Rodrigues","descricao":"","email":"antonio.rodrigues@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"antonio-rodrigues","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"antonio-rodrigues-removebg-preview.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1750085?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#117;&#103;&#105;&#114;&#100;&#111;&#114;&#46;&#111;&#105;&#110;&#111;&#116;&#110;&#97;","contribuicao":"texto","tipo":"INTERNO"},{"id":3976,"nome":"Nuno Ferreira Santos","descricao":"","email":"nuno.santos@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Fotojornalista","profissaoNaAltura":"","slug":"nuno-ferreira-santos","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#111;&#116;&#110;&#97;&#115;&#46;&#111;&#110;&#117;&#110;","contribuicao":"fotografia","tipo":"INTERNO"}],"shares":0,"description":"Líder do PAIGC lança um livro em Lisboa a propor a re