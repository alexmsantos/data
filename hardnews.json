ored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Reportagem","url":"/80-anos-cortina-ferro"},"id":2183435,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":18,"title":"Tornar as doenças grandes outra vez","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2110934?tp=UH&db=IMAGENS&type=JPG","author":[{"id":3110,"nome":"David Marçal","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Bioquímico e divulgador de ciência","profissaoNaAltura":"Bioquímico e divulgador de ciência","slug":"david-marcal","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"David Marcal z.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1718490?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":"Larry Hagman","translations":null},"hasImage":true,"isExternal":true,"encodedEmail":"","contribuicao":"","tipo":"EXTERNO"}],"shares":0,"description":"Por trás de tudo isto está o populismo, que trata os cientistas como uma elite a abater, e as instituições do Estado de direito, desde logo os tribunais, como obstáculos a contornar.","url":"/2026/08/21/ciencia/ensaio/tornar-doencas-2185602","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Ensaio","url":"/perder-amigos-rapidamente"},"id":2185602,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":19,"title":"Morreu John Irvin (1940-2026), que fez de Alec Guinness <em>A Toupeira</em>","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2110930?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1036,"nome":"Jorge Mourinha","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Crítico","profissaoNaAltura":"Crítico","slug":"jorge-mourinha","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"jmour