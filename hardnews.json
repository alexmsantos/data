[{"pos":0,"title":"Agastado por “bloco fatal” entre PS e Chega, Governo nega crise política","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2132474?tp=UH&db=IMAGENS&type=JPG","author":[{"id":15507,"nome":"Ana Bacelar Begonha","descricao":"","email":"ana.begonha@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"ana-bacelar-begonha","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#104;&#110;&#111;&#103;&#101;&#98;&#46;&#97;&#110;&#97;","contribuicao":"","tipo":"INTERNO"},{"id":3898,"nome":"Liliana Borges","descricao":"","email":"liliana.borges@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"liliana-pascoal-borges","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"liliana-borges.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1172095?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#103;&#114;&#111;&#98;&#46;&#97;&#110;&#97;&#105;&#108;&#105;&#108;","contribuicao":"","tipo":"INTERNO"},{"id":157,"nome":"Maria Lopes","descricao":"Entrei para o PÚBLICO, vinda da universidade, quando se vivia a excitação das vésperas da primeira Exposição Mundial em Portugal. Calcorreei a Expo-98 de fio a pavio, de caderno, caneta e, por vezes, de Polaroid na mão. Esses poucos meses ensinaram-me a conjugar o verbo tão português “desenrascar-se”.\r\nNestes mais de 20 anos, passei depois pelas secções Local, Media (por duas vezes) e Economia. Estive no lançamento do suplemento Digital – que apesar do nome existiu apenas em papel – e pertenci à equipa do irreverente projecto Sexta, o jornal gratuito que o PÚBLICO partilhou com A Bola, em 2007 e 2008. Em simultâneo, durante dez anos, escrevi também para o Motores (da Fugas), vivendo os automóveis sob uma perspectiva menos técnica e mais prazenteira. Desde 2009 que integro a secção de Política e tento manter debaixo de olho o panorama dos media. \r\n\r\n","email":"maria.lopes@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"maria-lopes","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Maria_C_Lopes.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737865?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#112;&#111;&#108;&#46;&#97;&#105;&#114;&#97;&#109;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"PS e Chega voltaram a impor derrotas à AD na fase de especialidade do Orçamento do Estado para 2027. Luís Montenegro dramatizou o risco de défice, mas garantiu que o executivo continuará a governar.","url":"/2026/11/20/politica/noticia/agastado-bloco-fatal-ps-chega-governo-nega-crise-politica-2195712","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Orçamento do Estado 2027","url":"https://www.publico.pt/2026/11/20/politica/noticia/agastado-bloco-fatal-ps-chega-governo-nega-crise-politica-2195712"},"id":2195712,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":1,"title":"O Alentejo à mesa de Natal com dois novos Grande Reserva da CARMIM","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2127090?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"Há vinhos que acompanham a refeição e outros que a tornam especial. Os grandes vinhos fazem ambas. É neste encontro entre vinho e gastronomia que a CARMIM apresenta os novos Monsaraz Grande Reserva.","url":"/2026/11/14/estudiop/noticia/alentejo-mesa-natal-dois-novos-reserva-carmim-2193200","comments":1,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":{"id":0,"name":"Carmim","ImageUrl":"https://imagens.publico.pt/imagens.aspx/2128659?tp=UH&db=IMAGENS","slug":null,"url":null},"rubric":{"name":"Conteúdo comercial","url":"https://www.publico.pt/2026/11/14/estudiop/noticia/alentejo-mesa-natal-dois-novos-reserva-carmim-2193200"},"id":2193200,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":2,"title":"Nas renovadas salas do museu de Arte Antiga o luxo tem séculos e vai do altar à cama","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2132569?tp=UH&db=IMAGENS&type=JPG","author":[{"id":488,"nome":"Lucinda Canelas","descricao":"Quando cheguei aqui, Lisboa estava a preparar-se para a grande exposição dos oceanos e a cidade mudava à beira-rio. Os quatro primeiros meses foram intensos, no recinto da Expo e fora dele, nos festivais que invadiam teatros e auditórios, sempre de Polaroid na mochila. O interesse pela arte, sobretudo a dança, já lá estava, mas pelo caminho foi crescendo e foi mudando. Talvez porque acabei por conversar com coreógrafos que me habituei a admirar nos livros e nos palcos, porque uma reportagem me levou a um sítio arqueológico que eu ainda não conhecia e uma exposição me fez descobrir um fotógrafo, um escritor, um artista ou um historiador de arte com muita coisa para contar sobre os mestres da pintura antiga. Sair em reportagem para caminhar no campo à procura de um mosteiro medieval ou de um castelo nas margens do Guadiana parece-me quase sempre boa ideia.","email":"lcanelas@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"lucinda-canelas","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#97;&#108;&#101;&#110;&#97;&#99;&#108;","contribuicao":"Texto","tipo":"INTERNO"},{"id":3920,"nome":"Daniel Rocha","descricao":"","email":"drocha@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Fotojornalista","profissaoNaAltura":"","slug":"daniel-rocha","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Daniel_Rocha.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737766?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#104;&#99;&#111;&#114;&#100;","contribuicao":"Fotografia","tipo":"INTERNO"}],"shares":0,"description":"Cruzes e cálices para rituais religiosos, uma cama feita no Japão que é única e um Cristo sedutor. As artes decorativas dão-se a ver de novo e como novas neste museu nacional. A partir deste sábado.","url":"/2026/11/20/culturaipsilon/noticia/renovadas-salas-museu-arte-antiga-luxo-seculos-vai-altar-cama-2195794","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Museu Nacional de Arte Antiga","url":"https://www.publico.pt/2026/11/20/culturaipsilon/noticia/renovadas-salas-museu-arte-antiga-luxo-seculos-vai-altar-cama-2195794"},"id":2195794,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":3,"title":"Do 5G ao 6G: as redes do futuro também vão observar o que acontece à sua volta","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2131216?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"As oportunidades económicas, os riscos e a soberania tecnológica estarão em debate no Fórum INESC TEC do Outono, a 25 de Novembro, no Porto.","url":"/2026/11/16/estudiop/notici