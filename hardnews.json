ia-neves","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#118;&#101;&#110;&#46;&#97;&#105;&#102;&#111;&#115;","contribuicao":"","tipo":"INTERNO"},{"id":890,"nome":"Reuters","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"reuters","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":"","tipo":"AGENCIAS"}],"shares":0,"description":"Moscovo afirma que <em>chat </em> de encontros no Telegram foi utilizado pelos serviços secretos ucranianos para recrutar jovens russos para acções de sabotagem e operações terroristas.","url":"/2026/07/29/mundo/noticia/russia-acusa-fundador-telegram-campo-batalha-virtual-auxilio-terrorismo-2183358","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Guerra na Ucrânia","url":"https://www.publico.pt/2026/07/29/mundo/noticia/russia-acusa-fundador-telegram-campo-batalha-virtual-auxilio-terrorismo-2183358"},"id":2183358,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":19,"title":"Milhares na China pagam por ferramentas de IA para “despir com um clique”","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2106096?tp=UH&db=IMAGENS&type=JPG","author":[{"id":19739,"nome":"Laura Ferreira","descricao":"","email":"laura.ferreira@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"laura-ferreira","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#105;&#101;&#114;&#114;&#101;&#102;&#46;&#97;&#114;&#117;&#97;&#108;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Milhares de pessoas estão a pagar por tutoriais que explicam c