[{"pos":0,"title":"A dez dias do início das aulas, o desafio é encontrar professores, diz Fenprof","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2113054?tp=UH&db=IMAGENS&type=JPG","author":[{"id":495,"nome":"Andreia Sanches","descricao":"Entrei no PÚBLICO em 1996. Tinha 22 anos, terminado o curso de Ciências da Comunicação na Universidade Nova de Lisboa e estava no jornal onde queria, de facto, começar a fazer jornalismo. Estagiei no Internacional, quando ainda fazíamos fila para aceder ao computador da redacção que estava ligado à Internet. Seguiu-se a Educação, onde fiquei vários anos, quando aquela era uma secção autónoma, diária. Já na Sociedade, o leque de temas sobre os quais passei a escrever alargou-se – a pobreza e as desigualdades, a exclusão e as políticas de protecção social são alguns dos que tenho acompanhado de forma mais sistemática. Em 2013 foi publicado o meu primeiro livro. Chama-se \"Os Anjos Não Comem Chocolate\" e tem como ponto de partida uma reportagem que fiz no PÚBLICO sobre pais que perderam os seus filhos. Ao longo dos últimos anos desempenhei funções de editora do P2, editora da Sociedade, editora-executiva e directora-adjunta.","email":"asanches@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Redactora principal","profissaoNaAltura":"","slug":"andreia-sanches","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"andreia-sanches-nova.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1748990?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":"Andreia C. Faria","translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#104;&#99;&#110;&#97;&#115;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Edifícios sem condições, alunos com necessidades especiais sem apoios, sobrecarga de profissionais, são alguns dos problemas apontados por Feliciano Costa.","url":"/2026/09/01/sociedade/noticia/fenprof-dez-dias-inicio-aulas-desafio-encontrar-professores-2186679","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Professores","url":"https://www.publico.pt/2026/09/01/sociedade/noticia/fenprof-dez-dias-inicio-aulas-desafio-encontrar-professores-2186679"},"id":2186679,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":1,"title":"Mesmo sem novas medidas, saldo orçamental agrava-se em 4800 milhões em 2027","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2113117?tp=UH&db=IMAGENS&type=JPG","author":[{"id":12819,"nome":"Marta Moitinho Oliveira","descricao":"","email":"marta.oliveira@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Directora-adjunta","profissaoNaAltura":"","slug":"marta-moitinho-oliveira","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"1527220-removebg-preview.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1818311?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#105;&#101;&#118;&#105;&#108;&#111;&#46;&#97;&#116;&#114;&#97;&#109;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Deputados já têm cálculos que servem de ponto de partida para o Orçamento do Estado para 2027. Finanças admitem gastar quase 2000 milhões de euros a mais em pensões no próximo ano.","url":"/2026/09/01/economia/noticia/novas-medidas-saldo-orcamental-agravase-4800-milhoes-euros-2027-2186705","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Orçamento do Estado","url":"https://www.publico.pt/2026/09/01/economia/noticia/novas-medidas-saldo-orcamental-agra