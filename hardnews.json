&#117;&#113;&#115;&#101;&#109;&#46;&#97;&#110;&#97;&#111;&#106;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Insatisfeito com as explicações de Luís Neves, Chega sugere que ministro da Administração Interna e ministra da Justiça sejam ouvidos a 4 ou a 5 de Agosto. IL viu pedido semelhante recusado.","url":"/2026/07/30/politica/noticia/chega-quer-ouvir-urgencia-luis-neves-rita-judice-comissao-permanente-parlamento-2183493","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Parlamento","url":"https://www.publico.pt/2026/07/30/politica/noticia/chega-quer-ouvir-urgencia-luis-neves-rita-judice-comissao-permanente-parlamento-2183493"},"id":2183493,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":10,"title":"Embarcação está a arder no estuário do Tejo","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2106337?tp=UH&db=IMAGENS&type=JPG","author":[{"id":973,"nome":"PÚBLICO","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"publico","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":"","tipo":"EXTERNO"}],"shares":0,"description":"Uma pequena embarcação encontra-se a arder no estuário do rio Tejo, na zona de Cruz Quebrada, Algés, mostram imagens das estações televisivas.","url":"/2026/07/30/local/noticia/embarcacao-arder-estuario-tejo-2183517","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Lisboa","url":"https://www.publico.pt/2026/07/30/local/noticia/embarcacao-arder-estuario-tejo-2183517"},"id":2183517,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":11,"title":"A humanidade já gastou tudo o que a Terra tinha para dar este ano","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2105718?tp=UH&db=IMAGENS&type=JPG","author":[{"id":6488,"nome":"Aline Flor","descricao":"Natural do Rio de Janeiro, vivo em Portugal há quase 30 anos. Criei raízes. Fui directora do Jornal Universitário do Porto, passei pela Ciência e Tecnologia no Canal Superior, editei notícias do portal AEIOU.pt. Fiz um mestrado em Cinema Documental que me abriu os olhos (e ouvidos) para a riqueza de cada encontro com o outro. Cheguei ao PÚBLICO para integrar a equipa de áudio, onde produzi podcasts em áreas desde a igualdade de género às questões europeias. Hoje sou editora do Azul, a nossa secção dedicada à crise climática e sustentabilidade, e aventurei-me num segundo mestrado: Economia e Gestão do Ambiente. Gosto de ouvir e de contar as histórias que ficam à margem e acredito que temos sempre algo a aprender quando encaramos o desafio de traduzir no preto e branco dos caracteres as infinitas tonalidades que nos rodeiam.","email":"aline.flor@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"aline-flor","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Aline Flor z.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1530339?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#114;&#111;&#108;&#102;&#46;&#101;&#110;&#105;&#108;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"A partir de amanhã, a humanidade vive a crédito: consome recursos que só deveriam estar disponíveis em 2027. O défice acumulado equivale a mais de 20 anos da regeneração total do planeta.","url":"/2026/07/30/azul/noticia/dia-sobrecarga-terra-humanidade-ja-gastou-planeta-dar-ano-2183237","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Sustentabilidade","url":"https://www.publico.pt/2026/07/30/azul/noticia/dia-sobrecarga-terra-humanidade-ja-gastou-planeta-dar-ano-2183237"},"id":2183237,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":12,"title":"Número de mortos após sismo no Japão sobe para 30. Calor e sede são novo inimigo","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2106289?tp=UH&db=IMAGENS&type=JPG","author":[{"id":890,"nome":"Reuters","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"reuters","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":"","tipo":"AGENCIAS"}],"shares":0,"description":"Violento sismo obrigou algumas das principais fabricantes de automóveis do mundo, como a Toyota a Honda ou a Nissan, a suspender parte da produção.","url":"/2026/07/30/mundo/noticia/numero-mortos-apos-sismo-japao-sobe-30-calor-sede-sao-novo-inimigo-2183485","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Japão","url":"https://www.publico.pt/2026/07/30/mundo/noticia/numero-mortos-apos-sismo-japao-sobe-30-calor-sede-sao-novo-inimigo-2183485"},"id":2183485,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":13,"title":"A delirante festa existencial dos Mangualde, muito mais do que pós-hardcore","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2105828?tp=UH&db=IMAGENS&type=JPG","author":[{"id":19366,"nome":"Filipe Costa","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"filipe-costa","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":"","tipo":"EXTERNO"}],"shares":0,"description":"O indomável álbum de estreia do trio portuense é uma peça essencial do contínuo punk-hardcore português.","url":"/2026/07/30/culturaipsilon/critica/delirante-festa-existencial-mangualde-poshardcore-2176491","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Crítica","url":"/musica"},"id":2176491,"type":"NOTICIA","isMultipleRubric":true,"tag":{"id":708,"nome":"Música","slug":"musica","tagEn":"","isPrincipal":false,"isVisible":true,"urlRoute":"/tmusica","isPrincipalParaArtigo":true,"isTimeLine":false,"forcaConteudoAberto":false,"follow_type":null,"descricao":null,"imagem":null,"html":null,"isForForuns":true,"isUsedInForuns":false},"size":30},{"pos":14,"title":"Um em cada três veículos vendidos em 2026 vai ser eléctrico, prevê AIE","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2106309?tp=UH&db=IMAGENS&type=JPG","author":[{"id":90,"nome":"Lusa","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"lusa","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"","contribuicao":"","tipo":"AGENCIA"},{"id":973,"nome":"PÚBLICO","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"publico","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":"","tipo":"EXTERNO"}],"shares":0,"description":"A evolução é atribuída à pressão económica resultante dos efeitos da guerra no Médio Oriente, pelos elevados preços dos combustíveis e alterações nas políticas públicas que afectam o sector automóvel.","url":"/2026/07/30/enter/noticia/tres-veiculos-vendidos-2026-vai-electrico-preve-aie-2183490","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Carros eléctricos","url":"https://www.publico.pt/2026/07/30/enter/noticia/tres-veiculos-vendidos-2026-vai-electrico-preve-aie-2183490"},"id":2183490,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":15,"title":"Proibição do uso de telemóveis vai ser alargada até ao 9.º ano, diz ministro","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2106287?tp=UH&db=IMAGENS&type=JPG","author":[{"id":90,"nome":"Lusa","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"lusa","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"","contribuicao":"","tipo":"AGENCIA"}],"shares":0,"description":"Escolas terão o primeiro período de aulas para se adaptar e fazer a transição para a nova medida, que passará assim a aplicar-se até ao 9.º ano e que entrará em vigor a 1 Janeiro de 2027.","url":"/2026/07/30/sociedade/noticia/proibicao-uso-telemoveis-vai-alargada-ate-9-ano-ministro-2183483","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Ministério da Educação","url":"https://www.publico.pt/2026/07/30/sociedade/noticia/proibicao-uso-telemoveis-vai-alargada-ate-9-ano-ministro-2183483"},"id":2183483,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":16,"title":"Universidade de Aveiro: viver uma experiência que prepara para a profissão e o futuro","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2105694?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"Com cerca de 2500 vagas, 58 licenciaturas e duas novas licenciaturas, a UA combina uma formação sólida com experiência prática e uma ligação próxima às empresas e à sociedade.","url":"/2026/07/28/estudiop/noticia/universidade-aveiro-viver-experiencia-prepara-profissao-futuro-2183220","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":{"id":0,"name":"Universidade de Aveiro","ImageUrl":"https://imagens.publico.pt/imagens.aspx/2105099?tp=UH&db=IMAGENS","slug":null,"url":null},"rubric":{"name":"Conteúdo comercial","url":"https://www.publico.pt/2026/07/28/estudiop/noticia/universidade-aveiro-viver-experiencia-prepara-profissao-futuro-2183220"},"id":2183220,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":17,"title":"Luís Neves admite eventuais irregularidades, mas sem ‘mínimo motivo para ser arguido’","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2106202?tp=UH&db=IMAGENS&type=JPG","author":[{"id":963,"nome":"Ana Henriques","descricao":"","email":"abhenriques@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"ana-henriques","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Ana_Henriques.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737742?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#117;&#113;&#105;&#114;&#110;&#101;&#104;&#98;&#97;","contribuicao":"","tipo":"INTERNO"},{"id":4038,"nome":"João Pedro Pincha","descricao":"Se não tivesse passado seis meses em Barcelona, provavelmente nunca me teria interessado por escrever sobre Lisboa. Foi na Catalunha que descobri, enquanto estagiava na televisão local, que a esquina mais próxima pode ser tão interessante como o outro lado do mundo. Meses depois, quando entrei no PÚBLICO pela primeira vez, já só queria estagiar na secção Local. E assim me iniciei a acompanhar tudo o que se passava na capital. Ainda passei brevemente pelo <i>O Corvo</i> antes de ajudar a fundar o <i>Observador</i>, onde estive quase três anos. Depois de cinco anos a acompanhar para o PÙBLICO a actualidade lisboeta e arredores, escrevo agora para a secção Mundo.","email":"joao.pincha@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"joao-pedro-pincha","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Joao P Pincha.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1332529?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#104;&#99;&#110;&#105;&#112;&#46;&#111;&#97;&#111;&#106;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Ministro diz sentir-se “empoderado” e nunca ter pensado demitir-se. Nega ter beneficiado empreiteiro de quem é amigo e afirma que poupou dinheiro ao Estado com a deslocação do atrelado para Barcelos.","url":"/2026/07/29/sociedade/noticia/luis-neves-transferencia-atrelado-barcelos-puro-acto-boa-gestao-2183430","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Polícia Judiciária","url":"https://www.publico.pt/2026/07/29/sociedade/noticia/luis-neves-transferencia-atrelado-barcelos-puro-acto-boa-gestao-2183430"},"id":2183430,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":18,"title":"EUA lançam novos ataques contra o Irão após ofensiva iraniana na Jordânia\r\n","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2106274?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1026,"nome":"Agências","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"agencias","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":"","tipo":"AGENCIAS"}],"shares":0,"description":"Forças norte-americanas anunciaram ter atacado dezenas de alvos dos Guardas da Revolução do Irão, incluindo centros de comando militar e instalações de <em>drones</em>, numa operação que durou duas horas.","url":"/2026/07/30/mundo/noticia/eua-lancam-novos-ataques-irao-apos-ofensiva-iraniana-jordania-2183479","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Médio Oriente","url":"https://www.publico.pt/2026/07/30/mundo/noticia/eua-lancam-novos-ataques-irao-apos-ofensiva-iraniana-jordania-2183479"},"id":2183479,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":19,"title":"Ataques russos a várias cidades da Ucrânia fazem pelo menos 13 mortos","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2106283?tp=UH&db=IMAGENS&type=JPG","author":[{"id":11214,"nome":"Sofia Neves","descricao":"","email":"sofia.neves@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"sofia-neves","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#118;&#101;&#110;&#46;&#97;&#105;&#102;&#111;&#115;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Alertas soaram em grande parte do território ucraniano. Ataques na cidade ocidental de Lviv levaram a vizinha Polónia a fazer descolar aviões de combate para proteger o seu espaço aéreo.","url":"/2026/07/30/mundo/noticia/ataques-russos-varias-cidades-ucrania-fazem-menos-13-mortos-2183481","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Ucrânia","url":"https://www.publico.pt/2026/07/30/mundo/noticia/ataques-russos-varias-cidades-ucrania-fazem-menos-13-mortos-2183481"},"id":2183481,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":20,"title":"Economia voltou a acelerar: crescimento de 0,8% no segundo trimestre","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2106290?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1053,"nome":"Sérgio Aníbal","descricao":"Sou jornalista desde 1998, tendo começado pouco tempo depois de ter concluído a minha licenciatura em economia no ISEG. Nesse ano, fiz um estágio não-remunerado de três meses no Semanário Económico, jornal onde acabei por ficar durante seis anos, como redactor, primeiro, e como editor da secção de Economia, no final. Passei depois pelo Jornal de Negócios e pelo Diário de Notícias, chegando finalmente ao PÚBLICO em 2006. Sempre a cobrir temas económicos. Nos últimos anos, a crise financeira internacional e a crise da dívida soberana europeia têm ocupado grande parte do meu tempo e atenção.","email":"sergio.anibal@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"sergio-anibal","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Sergio_Anibal.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737905?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#108;&#97;&#98;&#105;&#110;&#97;&#46;&#111;&#105;&#103;&#114;&#101;&#115;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Com a ajuda do consumo privado, Portugal regressou às taxas de crescimento mais elevadas que vinha apresentando ao longo de 2025, deixando para trás a quase estagnação do arranque deste ano.\r\n","url":"/2026/07/30/economia/noticia/economia-voltou-acelerar-crescimento-08-segundo-trimestre-2183489","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"PIB","url":"https://www.publico.pt/2026/07/30/economia/noticia/economia-voltou-acelerar-crescimento-08-segundo-trimestre-2183489"},"id":2183489,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":21,"title":"Bruxelas vai financiar obras do PRR que estejam 90% completas","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2106222?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1022,"nome":"Victor Ferreira","descricao":"Teria sido médico, se desse mais ouvidos aos meus pais, ou matemático ou bioquímico, se me tivesse aplicado a concluir os primeiros cursos superiores em que me matriculei. Porém, no Verão dos meus 18 anos, entrei pela primeira vez numa redacção. Era um jornal local, Guimarães, onde ainda hoje vive a minha família. Essa curta experiência, enquanto esperava pela universidade, mudou as minhas aspirações. Anos depois, pendurei um hipotético futuro de bata branca à volta de microscópios e abracei o sonho de transformar o mundo no meu laboratório. Porque o jornalismo é isso: um ensaio permanente. Desde 1999, já experimentei um pouco de tudo, do noticiário local ao desporto, fiz reportagem por todo o país, na Europa, em África, nos Estados Unidos. Tenho um MBA pela Porto Business School, com especialização em Comportamento Organizacional.","email":"voferreira@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"victor-ferreira","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Vitor Ferreira.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/2001908?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#105;&#101;&#114;&#114;&#101;&#102;&#111;&#118;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Nova regra prevê que investimentos considerados em “conclusão substancial” podem ser aceites para comprovar marcos e metas e manterão financiamento europeu correspondente ao seu nível de execução.","url":"/2026/07/30/economia/noticia/bruxelas-vai-financiar-obras-prr-90-completas-2183436","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Plano de Recuperação e Resiliência","url":"https://www.publico.pt/2026/07/30/economia/noticia/bruxelas-vai-financiar-obras-prr-90-completas-2183436"},"id":2183436,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":22,"title":"Empresas têm 476 milhões a resgatar do Fundo de Compensação do Trabalho até Dezembro","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2106223?tp=UH&db=IMAGENS&type=JPG","author":[{"id":3150,"nome":"Raquel Martins","descricao":"Aos 15 anos decidi que queria mudar o mundo e, para desgosto da minha professora de Português, quis ser jornalista. Fiz o curso de Ciências da Comunicação na Universidade Nova, frequentei o Cenjor e andei indecisa entre a rádio e a imprensa. Depois de uma breve passagem pela rádio (Antena 3 e Rádio Expo), acabei por entrar no jornalismo económico um pouco por acaso. Primeiro, no Diário Económico – onde escrevi sobre ambiente, autarquias, política e, mais tarde, sobre trabalho e função pública – depois no Jornal de Negócios. Foi por isso que, em 2009, fiz uma formação na Universidade Católica sobre legislação laboral. Estou no PÚBLICO desde 2010. Acompanho os assuntos relacionados com trabalho, emprego e administração pública (há quem diga, com humor, que o Código do Trabalho é o meu livro de cabeceira.) Defendo que o jornalismo tem um papel cada vez mais importante na descodificação da avalanche de informação que todos os dias circula nas mais diversas plataformas.","email":"raquel.martins@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"raquel-martins","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"raquel-martins-removebg-preview.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1991256?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":"Debi Thomas","translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#110;&#105;&#116;&#114;&#97;&#109;&#46;&#108;&#101;&#117;&#113;&#97;&#114;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Em causa estão 476,6 milhões de euros que as empresas podem perder. Maior parte do dinheiro já mobilizado, que totaliza 173,5 milhões, serviu para pagar formação dos trabalhadores.","url":"/2026/07/30/economia/noticia/empresas-nao-resgataram-73-verbas-fundo-compensacao-trabalho-prazo-cessa-final-ano-2183450","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Trabalho","url":"https://www.publico.pt/2026/07/30/economia/noticia/empresas-nao-resgataram-73-verbas-fundo-compensacao-trabalho-prazo-cessa-final-ano-2183450"},"id":2183450,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":23,"title":"Mais de oito mil pessoas retiradas de Creta, fogo perto de Bordéus não progrediu","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2106303?tp=UH&db=IMAGENS&type=JPG","author":[{"id":90,"nome":"Lusa","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"lusa","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"","contribuicao":"","tipo":"AGENCIA"}],"shares":0,"description":"Incêndio em Creta matou dois bombeiros, dezenas de animais e destruiu várias casas. Grande fogo perto de Bordéus tem frentes activas, mas autoridades estão optimistas. Fogos em Madrid estão contidos.","url":"/2026/07/30/azul/noticia/oito-mil-pessoas-retiradas-creta-fogo-perto-bordeus-nao-progrediu-2183486","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Incêndios","url":"https://www.publico.pt/2026/07/30/azul/noticia/oito-mil-pessoas-retiradas-creta-fogo-perto-bordeus-nao-progrediu-2183486"},"id":2183486,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":24,"title":"