icao":"","email":"sofia.marvao@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"sofia-marvao","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#97;&#118;&#114;&#97;&#109;&#46;&#97;&#105;&#102;&#111;&#115;","contribuicao":null,"tipo":"INTERNO"},{"id":6488,"nome":"Aline Flor","descricao":"Natural do Rio de Janeiro, vivo em Portugal há quase 30 anos. Criei raízes. Fui directora do Jornal Universitário do Porto, passei pela Ciência e Tecnologia no Canal Superior, editei notícias do portal AEIOU.pt. Fiz um mestrado em Cinema Documental que me abriu os olhos (e ouvidos) para a riqueza de cada encontro com o outro. Cheguei ao PÚBLICO para integrar a equipa de áudio, onde produzi podcasts em áreas desde a igualdade de género às questões europeias. Hoje sou jornalista do Azul, a nossa secção dedicada à crise climática e sustentabilidade, e aventurei-me num segundo mestrado: Economia e Gestão do Ambiente. Gosto de ouvir e de contar as histórias que ficam à margem e acredito que temos sempre algo a aprender quando encaramos o desafio de traduzir no preto e branco dos caracteres as infinitas tonalidades que nos rodeiam.","email":"aline.flor@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"aline-flor","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Aline Flor z.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1530339?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#114;&#111;&#108;&#102;&#46;&#101;&#110;&#105;&#108;&#97;","contribuicao":null,"tipo":"INTERNO"}],"shares":0,"description":"<p>A Austr&aacute;lia foi a vencedora do F&oacute;ssil do Dia, um pr&eacute;mio sat&iacute;rico da COP31, por continuar a aprovar projectos de explora&ccedil;&atilde;o de carv&atilde;o.</p>\r\n","url":"/2026/11/16/video/australia-vence-premio-inaccao-climatica-lidera-negociacoes-cop31-20261116-213113","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"COP31","url":"/cop31"},"id":98559,"type":"VIDEO","isMultipleRubric":false,"tag":null,"size":30},{"pos":28,"title":"Milhares manifestam-se em Praga contra cortes de financiamento nos meios de comunicação públicos","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/canal_videos/videoPortal/Images/202611/thumbiste98557.jpg?tp=VIDEOS","author":[{"id":20623,"nome":"Madalena Grilo Teles","descricao":"","email":"madalena.teles@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Técnica de gravação audiovisual estagiária","profissaoNaAltura":"Técnica de gravação audiovisual estagiária","slug":"madalena-grilo-teles","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#108;&#101;&#116;&#46;&#97;&#110;&#101;&#108;&#97;&#100;&#97;&#109;","contribuicao":null,"tipo":"INTERNO"},{"id":890,"nome":"Reuters","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"","profissaoNaAltura":"","slug":"reuters","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":null,"tipo":"AGENCIAS"}],"shares":0,"description":"<p>Centenas de milhares de pessoas manifestaram-se este domingo para defender a independ&ecirc;ncia da televis&atilde;o e r&aacute;dio p&uacute;blicas.</p>\r\n","url":"/2026/11/16/video/milhares-manifestamse-praga-cortes-financiamento-meios-comunicacao-publicos-20261116-151120","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Vídeo","url":"/video-"},"id":98557,"type":"VIDEO","isMultipleRubric":false,"tag":null,"size":30},{"pos":29,"title":"Manifestantes em Lisboa contam como os preços das casas condicionam escolhas de vida","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/canal_videos/videoPortal/Images/202611/frame_manif98553.jpg?tp=VIDEOS","author":[{"id":20623,"nome":"Madalena Grilo Teles","descricao":"","email":"madalena.teles@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Técnica de gravação audiovisual estagiária","profissaoNaAltura":"Técnica de gravação audiovisual estagiária","slug":"madalena-grilo-teles","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#108;&#101;&#116;&#46;&#97;&#110;&#101;&#108;&#97;&#100;&#97;&#109;","contribuicao":null,"tipo":"INTERNO"},{"id":3925,"nome":"Joana Bourgard","descricao":"Sou jornalista desde 2007 e, ao longo destes anos de profissão, é a terceira vez que estou no PÚBLICO. Comecei como estagiária, na secção de Fotografia do jornal. Prossegui fotojornalismo no Jornal de Notícias, no Porto, onde fiquei três anos. Foi nessa altura que apareceram os smartphones e as primeiras máquinas fotográficas digitais com a possibilidade de captar imagem em movimento. Tornei-me jornalista multimédia e regressei para Lisboa para fazer parte da equipa de vídeo do PÚBLICO, em 2010. Passado quatro anos juntei-me à equipa multimédia da Rádio Renascença. Por fim, 15 anos depois do estágio no PÚBLICO, regressei em 2022 para editar a secção de Multimédia. Em 2007 fiz parte fundação da <a href=\"https://wilder.pt\">Wilder.pt</a>, um projecto de jornalismo independente dedicado à natureza e biodiversidade.","email":"joana.bourgard@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Editora de Multimédia","profissaoNaAltura":"Editora de Multimédia","slug":"joana-bourgard","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Joana_Bourgard.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737812?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#100;&#114;&#97;&#103;&#114;&#117;&#111;&#98;&#46;&#97;&#110;&#97;&#111;&#106;","contribuicao":null,"tipo":"INTERNO"}],"shares":0,"description":"<p>Melina mudou-se para Leiria e Jo&atilde;o&nbsp;teve de escolher outra universidade.</p>\r\n","url":"/2026/11/14/video/manifestantes-lisboa-contam-valores-casas-condicionam-escolas-vida-20261114-181525","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Vídeo","url":"/video-"},"id":98553,"type":"VIDEO","isMultipleRubric":false,"tag":null,"size":30}]
