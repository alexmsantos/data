email":"manuel.monteiro@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista estagiário","profissaoNaAltura":"","slug":"manuelc-monteiro","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#114;&#105;&#101;&#116;&#110;&#111;&#109;&#46;&#108;&#101;&#117;&#110;&#97;&#109;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Autocarro ficou capotado na Estrada Nacional 260, na zona de Baleizão. Vítima mortal é o motorista do autocarro acidentado, que terá sofrido uma doença súbita.","url":"/2026/10/30/sociedade/noticia/despiste-autocarro-concelho-beja-provoca-sete-feridos-gravidade-2193163","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Beja","url":"https://www.publico.pt/2026/10/30/sociedade/noticia/despiste-autocarro-concelho-beja-provoca-sete-feridos-gravidade-2193163"},"id":2193163,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":15,"title":"Gaza: as pessoas estão a voltar a ter apenas uma refeição por dia","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2127115?tp=UH&db=IMAGENS&type=JPG","author":[{"id":349,"nome":"Maria João Guimarães","descricao":"Sou jornalista desde 1998, no PÚBLICO, onde tenho podido ler, ouvir, contar, e viver histórias. Lembro-me da primeira, como estagiária: a de um afinador de acordeões no Intendente. Do pequeno largo de Lisboa passei para o Internacional e continuei a ouvir pessoas que tornam o mundo menos preto e branco. Escrevi sobre o muro em Israel e o muro de Berlim. Sobre racismo em Israel, na Alemanha, na Grécia. Falei com jovens alemães precários, com jovens gregos desempregados, com jovens a tentar saídas profissionais em Gaza. \r\nVivi em Berlim no ano académico de 2015/16, com uma bolsa para um programa para jornalistas da Universidade Livre. Vi um conjunto de reportagens sobre a Grécia distinguido com o Prémio de Reportagem Norberto Lopes da Casa da Imprensa 2011/2012, a reportagem “Uma geração a tentar sair de Gaza para dizer: sou de Gaza” com o Prémio de Jornalismo Direitos Humanos & Integração 2019 (imprensa escrita), e a cobertura das eleições alemãs de 2021 com o Prémio de Jornalismo Luso-Alemão 2022.","email":"maria.joao.guimaraes@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"maria-joao-guimaraes","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Maria_J_Guimaraes.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737866?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#97;&#114;&#97;&#109;&#105;&#117;&#103;&#46;&#111;&#97;&#111;&#106;&#46;&#97;&#105;&#114;&#97;&#109;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Responsável do Programa Alimentar Mundial diz que a situação no território palestiniano é “inaceitável”.","url":"/2026/10/30/mundo/noticia/gaza-pessoas-estao-voltar-apenas-refeicao-dia-2193232","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Médio Oriente","url":"https://www.publico.pt/2026/10/30/mundo/noticia/gaza-pessoas-estao-voltar-apenas-refeicao-dia-2193232"},"id":2193232,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":16,"title":"“Doutora Larsen” no AXN: novos casos e mistérios antigos","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2126142?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"Amy Larsen tem novos casos complexos para resolver e um passado que não recorda por inteiro. A chegada de um novo cirurgião, com quem partilha uma história de q