//imagens.publico.pt/imagens.aspx/2110930?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1036,"nome":"Jorge Mourinha","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Crítico","profissaoNaAltura":"Crítico","slug":"jorge-mourinha","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"jmourinha-removebg-preview.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/2074861?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":",Os Cavalheiros","translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Uma carreira discreta no cinema não apagará nunca que o realizador britânico, falecido aos 86 anos, dirigiu uma das mais aclamadas séries televisivas de sempre, a partir de John Le Carré","url":"/2026/08/20/culturaipsilon/noticia/morreu-john-irvin-19402026-fez-alec-guinness-toupeira-2185636","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Cinema","url":"https://www.publico.pt/2026/08/20/culturaipsilon/noticia/morreu-john-irvin-19402026-fez-alec-guinness-toupeira-2185636"},"id":2185636,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":19,"title":"Dominique Perrault: “O subsolo é um mundo que tem a sua própria paisagem”","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2110647?tp=UH&db=IMAGENS&type=JPG","author":[{"id":101,"nome":"Sérgio C. Andrade","descricao":"Licenciado em Filosofia (Universidade do Porto); professor do ensino secundário (1979-88). Jornalista profissional desde 1988, com carreira em O Primeiro de Janeiro (1988-89) e PÚBLICO (desde 1989); colaborador n’O Comércio do Porto, Expresso e Grande Reportagem; co-fundador das revistas Cinema Novo e A Grande Ilusão. Autor dos livros O Porto na História do Cinema (2002), Ao Correr do Tempo – Duas Décadas com Manoel de Oliveira (2008) e Serralves – 20 Anos e Outras Histórias (2009). Autor do documentário Manoel de Oliveira, O Caso Dele (2007). Co-autor do Dicionário de Personalidades Portuenses do Século XX (2001) e de As Casas da Música no Porto – Vols. I, II e III (2009-2011).","email":"sandrade@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"sergio-c-andrade","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Sergio_Andrade.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737904?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#101;&#100;&#97;&#114;&#100;&#110;&#97;&#115;","contribuicao":"entrevista","tipo":"INTERNO"},{"id":3917,"nome":"Nelson Garrido","descricao":"Nasci em Vila Nova de Gaia, Portugal. Em 1996 concluí o bacharelato em Tecnologias da Comunicação Audiovisual. No mesmo ano, frequentei uma formação avançada em fotografia na escola Karel de Grote-Hogescholl Antwerpen, na Bélgica, e fiz um estágio em fotografia digital e de grande formato no Studio Brison, também na Bélgica. Em Portugal, trabalhei em regime de freelancer com várias revistas, na área da fotografia de reportagem e de arquitectura. Em 2000, concluí a licenciatura em Comunicação Social e em 2005 a Licenciatura em Fotografia. Em 2005, ganhei três menções honrosas no concurso de fotojornalismo da revista Visão e venci a categoria de fotografia de arquitectura do Euro Press Photo Awards da Fuji Film. Fui premiado no Prémio Estação Imagem|Mora em 2010 e 2011. Desde 1999, sou fotojornalista no PÚBLICO.","email":"ngarrido@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Fotojornalista","profissaoNaAltura":"","slug":"nelson-garrido","im