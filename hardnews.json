Plus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"publico","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":"","tipo":"EXTERNO"}],"shares":0,"description":"Departamento de Estado afirma que medida pode ser anulada caso o Brasil conceda o aval diplomático para que o indicado de Trump assuma a embaixada dos EUA em Brasília.","url":"/2026/08/05/mundo/noticia/administracao-trump-revoga-visto-embaixadora-brasil-washington-2184068","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Diplomacia","url":"https://www.publico.pt/2026/08/05/mundo/noticia/administracao-trump-revoga-visto-embaixadora-brasil-washington-2184068"},"id":2184068,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":18,"title":"Puccini, a criada dedicada e os príncipes do costume na <em>Turandot </em>que abre o Operafest","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2107392?tp=UH&db=IMAGENS&type=JPG","author":[{"id":488,"nome":"Lucinda Canelas","descricao":"Quando cheguei aqui, Lisboa estava a preparar-se para a grande exposição dos oceanos e a cidade mudava à beira-rio. Os quatro primeiros meses foram intensos, no recinto da Expo e fora dele, nos festivais que invadiam teatros e auditórios, sempre de Polaroid na mochila. O interesse pela arte, sobretudo a dança, já lá estava, mas pelo caminho foi crescendo e foi mudando. Talvez porque acabei por conversar com coreógrafos que me habituei a admirar nos livros e nos palcos, porque uma reportagem me levou a um sítio arqueológico que eu ainda não conhecia e uma exposição me fez descobrir um fotógrafo, um escritor, um artista ou um historiador de arte com muita coisa para contar sobre os mestres da pintura antiga. Sair em reportagem para caminhar no campo à procura de um mosteiro medieval ou de um castelo nas margens do Guadiana parece-me quase sempre boa ideia.","email":"lcanelas@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"lucinda-canelas","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#97;&#108;&#101;&#110;&#97;&#99;&#108;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Encenação e cenografia da alemã Daniela Kerck combina o original com episódios da vida do popular compositor italiano. Festival prolonga-se até 11 de Setembro.","url":"/2026/08/04/culturaipsilon/noticia/puccini-criada-dedicada-principes-costume-turandot-abre-operafest-2184024","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Música","url":"https://www.publico.pt/2026/08/04/culturaipsilon/noticia/puccini-criada-dedicada-principes-costume-turandot-abre-operafest-2184024"},"id":2184024,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":19,"title":"Escavações regressaram ao Fórum Romano de Beja após interregno de nove anos","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2105946?tp=UH&db=IMAGENS&type=JPG&x=1341&y=17","author":[{"id":490,"nome":"Carlos Dias","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"carlos-dias","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Um dos mais importantes testemunhos arqueológicos do Alentejo está liberto de ervas, arbustos e entulho. Cidadãos de Beja vão ter palavra sobre o que pretendem fazer do espaço.","url":"/2026/08/05/local/noticia/escavacoes-regressaram-forum-romano-beja-apos-interregno-nove-anos-2183317","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":