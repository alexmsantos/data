pensos no tempo.","url":"/2026/08/12/ciencia/noticia/fezse-noite-dia-portugal-viu-sol-esconderse-26-segundos-2184886","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Astronomia","url":"https://www.publico.pt/2026/08/12/ciencia/noticia/fezse-noite-dia-portugal-viu-sol-esconderse-26-segundos-2184886"},"id":2184886,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":14,"title":"As imagens do eclipse que maravilhou Portugal — e não só","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2109412?tp=UH&db=IMAGENS&type=JPG","author":[{"id":973,"nome":"PÚBLICO","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"","profissaoNaAltura":"","slug":"publico","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":null,"tipo":"EXTERNO"}],"shares":0,"description":"","url":"/2026/08/13/fotogaleria/imagens-eclipse-passou-portugal-415874","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Fotogaleria","url":"https://www.publico.pt/2026/08/13/fotogaleria/imagens-eclipse-passou-portugal-415874"},"id":415874,"type":"FOTOGALERIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":15,"title":"Por breves segundos, o eclipse antecipou o anoitecer em Portugal","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2109340?tp=UH&db=IMAGENS&type=JPG","author":[{"id":14261,"nome":"Carolina Amado","descricao":"","email":"carolina.amado@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"carolina-amado","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#100;&#97;&#109;&#97;&#46;&#97;&#110;&#105;&#108;&#111;&#114;&#97;&#99;","contribuicao":"","tipo":"INTERNO"},{"id":19987,"nome":"Mafalda Fidalgo","descricao":"","email":"mafalda.fidalgo@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista estagiária","profissaoNaAltura":"","slug":"mafalfa-fidalgo","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#103;&#108;&#97;&#100;&#105;&#102;&#46;&#97;&#100;&#108;&#97;&#102;&#97;&#109;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Eclipe total do Sol foi visível em Rio de Onor e Guadramil. No restante território continental, a percentagem de ocultação do Sol oscilou entre os 92% e os 99%.","url":"/2026/08/12/ciencia/noticia/olhos-ceu-eclipse-solar-comeca-minutos-2184864","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Eclipse","url":"https://www.publico.pt/2026/08/12/ciencia/noticia/olhos-ceu-eclipse-solar-comeca-minutos-2184864"},"id":2184864,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":16,"title":"Rio de Onor ficou às escuras: “É a primeira vez que vejo o eclipse”","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/canal_videos/videoPortal/Images/202608/82378798113.jpg?tp=VIDEOS","author":[{"id":7325,"nome":"Joana Gonçalves","descricao":"Licenciei-me em Ciências da Comunicação pela Universidade Nova de Lisboa e concluí, em 2018, uma pós-graduação em Jornalismo Multiplataforma. No mesmo ano comecei a trabalhar na Renascença, a redacção onde me formei, e aprendi que também na rádio há lugar para a imagem. Cheguei ao PÚBLICO em 2022.","email":"jmgoncalves@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Jornalista multimédia","profissaoNaAltura":"Jornalista multimédia","slug":"joana-goncalves","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#118;&#108;&#97;&#99;&#110;&#111;&#103;&#109;&#106;","contribuicao":null,"tipo":"INTERNO"},{"id":7026,"nome":"Tiago Ramalho","descricao":"","email":"tiago.ramalho@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"tiago-ramalho","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"tiagoramalho.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1328997?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#104;&#108;&#97;&#109;&#97;&#114;&#46;&#111;&#103;&#97;&#105;&#116;","contribuicao":null,"tipo":"INTERNO"},{"id":3917,"nome":"Nelson Garrido","descricao":"Nasci em Vila Nova de Gaia, Portugal. Em 1996 concluí o bacharelato em Tecnologias da Comunicação Audiovisual. No mesmo ano, frequentei uma formação avançada em fotografia na escola Karel de Grote-Hogescholl Antwerpen, na Bélgica, e fiz um estágio em fotografia digital e de grande formato no Studio Brison, também na Bélgica. Em Portugal, trabalhei em regime de freelancer com várias revistas, na área da fotografia de reportagem e de arquitectura. Em 2000, concluí a licenciatura em Comunicação Social e em 2005 a Licenciatura em Fotografia. Em 2005, ganhei três menções honrosas no concurso de fotojornalismo da revista Visão e venci a categoria de fotografia de arquitectura do Euro Press Photo Awards da Fuji Film. Fui premiado no Prémio Estação Imagem|Mora em 2010 e 2011. Desde 1999, sou fotojornalista no PÚBLICO.","email":"ngarrido@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Fotojornalista","profissaoNaAltura":"Fotojornalista","slug":"nelson-garrido","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Nelson_Garrido.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737874?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#100;&#105;&#114;&#114;&#97;&#103;&#110;","contribuicao":null,"tipo":"INTERNO"},{"id":3925,"nome":"Joana Bourgard","descricao":"Sou jornalista desde 2007 e, ao longo destes anos de profissão, é a terceira vez que estou no PÚBLICO. Comecei como estagiária, na secção de Fotografia do jornal. Prossegui fotojornalismo no Jornal de Notícias, no Porto, onde fiquei três anos. Foi nessa altura que apareceram os smartphones e as primeiras máquinas fotográficas digitais com a possibilidade de captar imagem em movimento. Tornei-me jornalista multimédia e regressei para Lisboa para fazer parte da equipa de vídeo do PÚBLICO, em 2010. Passado quatro anos juntei-me à equipa multimédia da Rádio Renascença. Por fim, 15 anos depois do estágio no PÚBLICO, regressei em 2022 para editar a secção de Multimédia. Em 2007 fiz parte fundação da <a href=\"https://wilder.pt\">Wilder.pt</a>, um projecto de jornalismo independente dedicado à natureza e biodiversidade.","email":"joana.bourgard@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Editora de Multimédia","profissaoNaAltura":"Editora de Multimédia","slug":"joana-bourgard","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Joana_Bourgard.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737812?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#100;&#114;&#97;&#103;&#114;&#117;&#111;&#98;&#46;&#97;&#110;&#97;&#111;&#106;","contribuicao":null,"tipo":"INTERNO"}],"shares":0,"description":"<p><!--StartFragment-->Centenas de pessoas celebraram os 26 segundos de eclipse total em Portugal.<!--EndFragment--></p>\r\n","url":"/2026/08/12/ciencia/video/rio-onor-ficou-escuras-primeira-vejo-eclipse-20260812-221844","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Vídeo","url":"/video-"},"id":98113,"type":"VIDEO","isMultipleRubric":false,"tag":null,"size":30},{"pos":17,"title":"“O amigo Paulo Raimundo” em Cuba para homenagear Fidel Castro","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2109262?tp=UH&db=IMAGENS&type=JPG","author":[{"id":973,"nome":"PÚBLICO","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"publico","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":"","tipo":"EXTERNO"}],"shares":0,"description":"Presidente de Cuba, Miguel Díaz-Canel, divulgou um vídeo em que surge a receber o secretário-geral do PCP, que está em Havana para participar no I Colóquio Internacional sobre o líder revolucionário.","url":"/2026/08/13/mundo/noticia/amigo-paulo-raimundo-cuba-homenagear-fidel-castro-2184873","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Cuba","url":"https://www.publico.pt/2026/08/13/mundo/noticia/amigo-paulo-raimundo-cuba-homenagear-fidel-castro-2184873"},"id":2184873,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":18,"title":"Em dez anos, automóveis terão de conter 25% de plástico reciclado","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2109489?tp=UH&db=IMAGENS&type=JPG","author":[{"id":14221,"nome":"Europa Press","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"europa-press","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":"","tipo":"EXTERNO"}],"shares":0,"description":"A cada ano, entre dez e 12 milhões de veículos chegam ao fim da sua vida útil na Europa e passam a ser considerados resíduos.","url":"/2026/08/13/azul/noticia/ue-passa-aplicar-regras-carros-contenham-25-plastico-reciclado-10-anos-2184927","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Indústria","url":"https://www.publico.pt/2026/08/13/azul/noticia/ue-passa-aplicar-regras-carros-contenham-25-plastico-reciclado-10-anos-2184927"},"id":2184927,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":19,"title":"Funcionária bancária suspeita de roubar dinheiro a clientes. PJ detém cinco pessoas","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2109488?tp=UH&db=IMAGENS&type=JPG","author":[{"id":90,"nome":"Lusa","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"lusa","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"","contribuicao":"","tipo":"AGENCIA"}],"shares":0,"description":"Verbas roubadas a clientes seriam distribuídas por “mulas”, que transferiam por sua vez o dinheiro a outras pessoas.","url":"/2026/08/13/sociedade/noticia/funcionaria-bancaria-suspeita-roubar-dinheiro-clientes-pj-detem-cinco-pessoas-2184928","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Crime","url":"https://www.publico.pt/2026/08/13/sociedade/noticia/funcionaria-bancaria-suspeita-roubar-dinheiro-clientes-pj-detem-cinco-pessoas-2184928"},"id":2184928,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":20,"title":"Ratos, pragas e contentores a transbordar: queixas sobre lixo urbano aumentam 10%","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2109207?tp=