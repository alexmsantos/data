gura":null,"altura":null,"nome":"Ana_Henriques.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737742?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#117;&#113;&#105;&#114;&#110;&#101;&#104;&#98;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Auditoria às contas de 2023 da PJ revela vários atropelos à lei em matéria de contratação pública, mas também de transparência e execução orçamental. Decisão cabe ao Ministério Público.","url":"/2026/08/05/sociedade/noticia/luis-neves-arrisca-julgado-tribunal-contas-infraccoes-financeiras-pj-2184194","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Justiça","url":"https://www.publico.pt/2026/08/05/sociedade/noticia/luis-neves-arrisca-julgado-tribunal-contas-infraccoes-financeiras-pj-2184194"},"id":2184194,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":5,"title":"Serviços de segurança queriam mais videovigilância na AR, partidos discordaram","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2107777?tp=UH&db=IMAGENS&type=JPG","author":[{"id":157,"nome":"Maria Lopes","descricao":"Entrei para o PÚBLICO, vinda da universidade, quando se vivia a excitação das vésperas da primeira Exposição Mundial em Portugal. Calcorreei a Expo-98 de fio a pavio, de caderno, caneta e, por vezes, de Polaroid na mão. Esses poucos meses ensinaram-me a conjugar o verbo tão português “desenrascar-se”.\r\nNestes mais de 20 anos, passei depois pelas secções Local, Media (por duas vezes) e Economia. Estive no lançamento do suplemento Digital – que apesar do nome existiu apenas em papel – e pertenci à equipa do irreverente projecto Sexta, o jornal gratuito que o PÚBLICO partilhou com A Bola, em 2007 e 2008. Em simultâneo, durante dez anos, escrevi também para o Motores (da Fugas), vivendo os automóveis sob uma perspectiva menos técnica e mais prazenteira. Desde 2009 que integro a secção de Política e tento manter debaixo de olho o panorama dos media. \r\n\r\n","email":"maria.lopes@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"maria-lopes","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Maria_C_Lopes.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737865?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#112;&#111;&#108;&#46;&#97;&#105;&#114;&#97;&#109;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Proposta para a instalação de câmaras nos corredores continua a esbarrar nos argumentos da privacidade e liberdade dos deputados.","url":"/2026/08/05/politica/noticia/servicos-seguranca-propuseram-reforco-videovigilancia-parlamento-partidos-discordaram-2184138","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Assembleia da República","url":"https://www.publico.pt/2026/08/05/politica/noticia/servicos-seguranca-propuseram-reforco-videovigilancia-parlamento-partidos-discordaram-2184138"},"id":2184138,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":6,"title":"As redes sociais marcaram a data de uma nova corrida a Ceuta: é 15 de Agosto","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2107763?tp=UH&db=IMAGENS&type=PNG","author":[{"id":17560,"nome":"Leonor Alhinho","descricao":"","email":"leonor.alhinho@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"leonor-alhinho","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#104;&#110;&#105;&#104;&#108;&#97;&#46;&#114;&#111;&#110;&#111;&#101;&#108;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Grupos de WhatsApp, Facebook e Instagram apontam para 15 de Agosto como a nova data para tentar entrar em Ceuta a nado. O PÚBLICO confirmou junto de migrantes que o apelo voltou a circular.","url":"/2026/08/05/mundo/noticia/redes-sociais-marcaram-data-nova-corrida-ceuta-15-agosto-2184181","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Ceuta","url":"https://www.publico.pt/2026/08/05/mundo/noticia/redes-sociais-marcaram-data-nova-corrida-ceuta-15-agosto-2184181"},"id":2184181,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":7,"title":"Sally Haslanger: “As pessoas não estão condenadas a odiar o outro”","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2107164?tp=UH&db=IMAGENS&type=JPG","author":[{"id":3997,"nome":"Isabel Lucas","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"isabel-lucas","imagem":{"w":216,"h":216,"largura":216,"altura":216,"nome":"isabel lucas.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1962986?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":",Viagem ao sonho americano: A América pelos livros","translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"","contribuicao":"entrevista","tipo":"INTERNO"},{"id":3917,"nome":"Nelson Garrido","descricao":"Nasci em Vila Nova de Gaia, Portugal. Em 1996 concluí o bacharelato em Tecnologias da Comunicação Audiovisual. No mesmo ano, frequentei uma formação avançada em fotografia na escola Karel de Grote-Hogescholl Antwerpen, na Bélgica, e fiz um estágio em fotografia digital e de grande formato no Studio Brison, também na Bélgica. Em Portugal, trabalhei em regime de freelancer com várias revistas, na área da fotografia de reportagem e de arquitectura. Em 2000, concluí a licenciatura em Comunicação Social e em 2005 a Licenciatura em Fotografia. Em 2005, ganhei três menções honrosas no concurso de fotojornalismo da revista Visão e venci a categoria de fotografia de arquitectura do Euro Press Photo Awards da Fuji Film. Fui premiado no Prémio Estação Imagem|Mora em 2010 e 2011. Desde 1999, sou fotojornalista no PÚBLICO.","email":"ngarrido@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Fotojornalista","profissaoNaAltura":"","slug":"nelson-garrido","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Nelson_Garrido.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737874?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#100;&#105;&#114;&#114;&#97;&#103;&#110;","contribuicao":"fotografia","tipo":"INTERNO"}],"shares":0,"description":"Uma das vozes mais influentes da filosofia feminista, estuda como género, raça e ideologia organizam a vida social. Conversa sobre a palavra <em>woke</em>, a liberdade académica e a esperança.","url":"/2026/08/05/culturaipsilon/entrevista/sally-haslanger-pessoas-nao-estao-condenadas-odiar-2183842","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Entrevista","url":"/pensamento"},"id":2183842,"type":"NOTICIA","isMultipleRubric":true,"tag":{"id":7984,"nome":"Pensamento","slug":"pensamento","tagEn":"","isPrincipal":false,"isVisible":true,"urlRoute":"/tpensamento","isPrincipalParaArtigo":true,"isTimeLine":false,"forcaConteudoAberto":false,"follow_type":null,"descricao":null,"imagem":null,"html":null,"isForForuns":false,"isUsedInForuns":false},"size":30},{"pos":8,"title":"O Cristo de Viseu que fingia ajoelhar-se, cair da cruz, sacrificar-se pela humanidade","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2107797?tp=UH&db=IMAGENS&type=JPG","author":[{"id":136,"nome":"Joana Amaral Cardoso","descricao":"Comecei na secção de Sociedade em 1999, dali fui para o Publico.pt e como colaboradora da revista Pública escrevi sobre tendências sociais e Manias. Em 2006 comecei a debruçar-me sobre uma das áreas que mais me interessam – o audiovisual. Depois, já na secção de Cultura, onde sou hoje jornalista, juntei a isto tudo a cultura popular, o cinema, a moda, o design e interesso-me em aplicar a lente do género a muitos fenómenos.  Em 2009 editei a secção de Televisão da revista TimeOut e mais recentemente dei aulas de Jornalismo de Moda. No Público também editei a secção da Cultura online, fui subeditora da revista Pública e co-editora da revista Fugas. E vejo demasiada televisão.","email":"joana.cardoso@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"joana-amaral-cardoso","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#115;&#111;&#100;&#114;&#97;&#99;&#46;&#97;&#110;&#97;&#111;&#106;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"É tesouro nacional, está quase à porta do Museu Nacional Grão Vasco, mas a sua história é pouco conhecida. Um Cristo articulado do século XIII impressionava e tentava converter os populares nas ruas.","url":"/2026/08/05/culturaipsilon/noticia/viseu-ha-cristo-fingia-ajoelhar-cair-cruz-sacrificarse-humanidade-2184120","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"O museu que nem sempre vemos","url":"https://www.publico.pt/2026/08/05/culturaipsilon/noticia/viseu-ha-cristo-fingia-ajoelhar-cair-cruz-sacrificarse-humanidade-2184120"},"id":2184120,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":9,"title":"Sharif Ahmadzai, de refugiado inspirador a suspeito de homicídio em Atenas","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2107675?tp=UH&db=IMAGENS&type=PNG","author":[{"id":12425,"nome":"Inês Duarte de Freitas","descricao":"","email":"ines.freitas@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"ines-duarte-freitas","imagem":{"w":344,"h":320,"largura":344,"altura":320,"nome":"WhatsApp_Image_2023-02-01_at_13.49.04-removebg-preview.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1775300?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#97;&#116;&#105;&#101;&#114;&#102;&#46;&#115;&#101;&#110;&#105;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"O jovem de 26 anos chegou à ilha de Lesbos há uma década e, desde então, ajudava outros refugiados na Grécia através da associação Love Every Nation. Elisabeth-Jane Ross era uma das voluntárias.","url":"/2026/08/05/impar/noticia/sharif-ahmadzai-refugiado-inspirador-suspeito-homicidio-atenas-2184136","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":{"name":"impar"},"brand":null,"rubric":{"name":"Grécia","url":"https://www.publico.pt/2026/08/05/impar/noticia/sharif-ahmadzai-refugiado-inspirador-suspeito-homicidio-atenas-2184136"},"id":2184136,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30}]
