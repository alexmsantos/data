.","email":"nsousa@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Editor de Desporto","profissaoNaAltura":"Editor de Desporto","slug":"nuno-sousa","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"nsousa.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1951120?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":",Liga Europa da UEFA","translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#115;&#117;&#111;&#115;&#110;","contribuicao":null,"tipo":"INTERNO"}],"shares":0,"description":"<p>Numa altura em que Cristiano anuncia a sa&iacute;da da selec&ccedil;&atilde;o nacional, muito se tem falado de uma poss&iacute;vel quebra de receitas para a FPF.</p>\r\n","url":"/2026/11/09/desporto/video/dinheiro-cristiano-trouxe-afinal-cofres-fpf-20261106-200156","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Vídeo","url":"/video-"},"id":98527,"type":"VIDEO","isMultipleRubric":false,"tag":null,"size":30},{"pos":28,"title":"Nvidia investiga caso extraconjugal do CEO com suposta espiã chinesa. Acções da empresa em queda","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/canal_videos/videoPortal/Images/202611/thumbsite98531.jpg?tp=VIDEOS","author":[{"id":20623,"nome":"Madalena Grilo Teles","descricao":"","email":"madalena.teles@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Técnica de gravação audiovisual estagiária","profissaoNaAltura":"Técnica de gravação audiovisual estagiária","slug":"madalena-grilo-teles","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#108;&#101;&#116;&#46;&#97;&#110;&#101;&#108;&#97;&#100;&#97;&#109;","contribuicao":