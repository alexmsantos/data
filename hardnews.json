os":22,"title":"O código da cura","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2121699?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"Um novo centro de investiga&ccedil;&atilde;o re&uacute;ne alguns dos maiores especialistas mundiais que est&atilde;o a explorar como o sistema imunit&aacute;rio pode contribuir para diagn&oacute;sticos mais precisos e terapias mais eficazes.","url":"https://www.publico.pt/estudiop/conteudo_patrocinado/codigo-cura","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Conteúdo Comercial","url":"/estudiop_saude_bem_estar"},"id":27321,"type":"EXTERNOS","isMultipleRubric":false,"tag":null,"size":30},{"pos":23,"title":"O que propõe o Orçamento do Estado para 2027 para os jovens?","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/canal_videos/videoPortal/Images/202610/Capa 398357.png?tp=VIDEOS","author":[{"id":13909,"nome":"Michelle Coelho","descricao":"","email":"michelle.coelho@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Redes sociais","profissaoNaAltura":"Redes sociais","slug":"-michelle-coelho","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#104;&#108;&#101;&#111;&#99;&#46;&#101;&#108;&#108;&#101;&#104;&#99;&#105;&#109;","contribuicao":null,"tipo":"INTERNO"},{"id":20485,"nome":"Gonçalo Taborda","descricao":"","email":"goncalo.taborda@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Jornalista. Redes sociais","profissaoNaAltura":"Jornalista. Redes sociais","slug":"goncalo-taborda","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#100;&#114;&#111;&#98;&#97;&#116;&#46;&#111;&#108;&#97;&#99;&#110;&#111;&#103;","contribuicao":null,"tipo":"INTERNO"},{"id":5669,"nome":"Claudia Carvalho Silva","descricao":"Nasci em Neuchâtel, na Suíça – daí que escreva o meu nome sem acento. Mais tarde, já em Portugal, estive dividida entre as ciências e as letras, num ímpeto constante de querer fazer e aprender tudo ao mesmo tempo. Decidi deixar de lado a certeza de que o coração não tem vontade e estudar Jornalismo na Faculdade de Letras da Universidade de Coimbra. Passei pelo jornal universitário <i>A Cabra</i>, a revista <i>Via Latina</i> e o Festival Caminhos do Cinema Português. E, no final de 2015, cheguei ao PÚBLICO para estagiar na secção Local, onde descobri algumas das histórias que Lisboa tem para contar. Depois de abraçar o desafio online, integrei a equipa fundadora do Azul, o nosso projecto dedicado à crise climática, que editei durante dois anos. Agora, estou no P3. E aprendo todos os dias.","email":"claudia.silva@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"claudia-carvalho-silva","imagem":{"w":null,"h":null,"largura":437,"altura":572,"nome":"CLAUDIACARVALHOSILVA_REDIMENSIONADA-removebg-preview.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1440637?tp=UH&db=IMAGENS&type=PNG","is_vertical":true,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#118;&#108;&#105;&#115;&#46;&#97;&#105;&#100;&#117;&#97;&#108;&#99;","contribuicao":null,"tipo":"INTERNO"}],"shares":0,"description":"<p>O documento vai ser discutido nos dias 27 e 28 na Assembleia da Rep&uacute;blica.</p>\r\n","url":"/2026/10/09/p3/video/propoe-orcamento-estado-2027-jovens-20261009-133233","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":{"name":"p3"},"brand":null,"rubric":{"name":"Vídeo","url":"/video-"},"id":98357,"type":"VIDEO","isMultipleRubric