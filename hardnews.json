das-manifestantes-vi-forca-fisica-2192589"},"id":2192589,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":6,"title":"Vucic concede derrota e diz que estudantes venceram eleições na Sérvia","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2125766?tp=UH&db=IMAGENS&type=JPG","author":[{"id":19168,"nome":"Francisco José Costa","descricao":"","email":"francisco.costa@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"francisco-jose-costa","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#116;&#115;&#111;&#99;&#46;&#111;&#99;&#115;&#105;&#99;&#110;&#97;&#114;&#102;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Aleksandar Vucic, ex-Presidente sérvio, concedeu a derrota nas eleições legislativas antecipadas deste domingo, 25 de Outubro, na Sérvia. Lista dos Estudantes quer redemocratizar o país.","url":"/2026/10/25/mundo/noticia/resultados-oficiais-vucic-concede-derrota-estudantes-venceram-eleicoes-servia-2192602","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Balcãs","url":"https://www.publico.pt/2026/10/25/mundo/noticia/resultados-oficiais-vucic-concede-derrota-estudantes-venceram-eleicoes-servia-2192602"},"id":2192602,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":7,"title":"Sporting perdeu e voltou a ficar de mãos vazias","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2125786?tp=UH&db=IMAGENS&type=JPG","author":[{"id":206,"nome":"Marco Vaza","descricao":"O desporto tem vencedores e perdedores, heróis e vilões e a história nem sempre é sobre o que ganha. Eu escrevo sobre aquele que marca o golo decisivo, sobre aquele que corre mais do que os outros, sobre aquele que não desiste ou sobre aquele que desistiu quando estava perto do fim. Já assisti ao vivo a grandes goleadas, recordes do mundo, estreias de futuras estrelas e despedidas de mitos. Entrei no PÚBLICO como estagiário em 1999 para a secção de Desporto, onde continuo, depois de uma comissão entre 2006 e 2009 como editor da revista de domingo. Para além de centenas de jogos de futebol, já estive em duas edições dos Jogos Olímpicos (Atenas 2004 e Londres 2012), numa edição dos Mundiais de atletismo (Helsínquia 2005) e noutras competições de muitas modalidades. O desporto dos outros é a minha profissão.","email":"mvaza@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"marco-vaza","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Marco_Vaza.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737861?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#122;&#97;&#118;&#109;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"“Leões” perdem em casa por 1-2 com o Académico de Viseu e já estão a nove pontos do líder FC Porto. João Guilherme, com dois golos, foi a grande figura dos visitantes.","url":"/2026/10/25/desporto/cronica_de_jogo/sporting-voltou-ficar-maos-vazias-2192605","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Crónica de jogo","url":"/futebol0"},"id":2192605,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30}]
