id":3976,"nome":"Nuno Ferreira Santos","descricao":"","email":"nuno.santos@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Fotojornalista","profissaoNaAltura":"","slug":"nuno-ferreira-santos","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#111;&#116;&#110;&#97;&#115;&#46;&#111;&#110;&#117;&#110;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Uma engenheira informática, nascida na Suíça, perdeu-se de amores numa praia de Quarteira, ao ver um jogo entre Portugal e a Alemanha: “Apaixonei-me pelo Christoffer.” O resto veio por acréscimo.","url":"/2026/08/18/economia/reportagem/amor-barraca-negocio-pes-areia-2185302","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Reportagem","url":"/p2-verao"},"id":2185302,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":19,"title":"Jardim do Morro, o miradouro mais procurado de Gaia, vai ter hora para abrir e fechar","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2110484?tp=UH&db=IMAGENS&type=JPG","author":[{"id":120,"nome":"Sandra Silva Costa","descricao":"Nunca fui bairrista mas também nunca fui de renegar as origens: nasci numa aldeia, Maceda, no concelho de Ovar, e lá vivi até aos 20 anos, mais coisa menos coisa. Nessa altura já estudava Jornalismo, na Universidade de Coimbra. Entrei para o PÚBLICO aos 22, tinha cabelos curtos e um mar de sonhos na cabeça. Vim estagiar, com experiência quase zero — mas justiça seja feita ao Jornal de Ovar, que me deu a primeira oportunidade, ainda nos tempos da faculdade. Estágio cumprido, integrei a secção de Educação, na altura uma editoria autónoma. Estávamos em 1998. Passei ainda pela Sociedade, como jornalista e como editora, até que, em 2008, assumi a edição da Fugas, onde fiquei até Dezembro de 2024. Em Janeiro de 2025, integrei a equipa do Local Porto.","email":"scosta@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"sandra-silva-costa","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"sc.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1091354?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#116;&#115;&#111;&#99;&#115;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Câmara recebeu inúmeras “queixas dos moradores” nos últimos meses. Obras incluem vedação, duas entradas e casas de banho, e deverão terminar em Maio de 2027, a tempo de celebrar os 100 anos do jardim.","url":"/2026/08/18/local/noticia/jardim-morro-miradouro-procurado-gaia-vai-hora-abrir-fechar-2185361","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Turismo","url":"https://www.publico.pt/2026/08/18/local/noticia/jardim-morro-miradouro-procurado-gaia-vai-hora-abrir-fechar-2185361"},"id":2185361,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":20,"title":"Peritos alertam para efeitos do passe ferroviário sem reforço da oferta","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2110331?tp=UH&db=IMAGENS&type=JPG","author":[{"id":366,"nome":"Carlos Cipriano","descricao":"","email":"carlos.cipriano@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"carlos-cipriano","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#110;&#97;&#105;&#114;&#112;&#105;&#99;&#46;&#115;&#111;&#108;&#114;&#97;&#99;","contribuicao":"