twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"tiago-ramalho","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"tiagoramalho.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1328997?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#104;&#108;&#97;&#109;&#97;&#114;&#46;&#111;&#103;&#97;&#105;&#116;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"A esmagadora maioria do país não pôde ver, mas num cantinho do nordeste transmontano, em Rio de Onor, a Lua eclipsou o Sol por breves segundos — quase suspensos no tempo.","url":"/2026/08/12/ciencia/noticia/fezse-noite-dia-portugal-viu-sol-esconderse-26-segundos-2184886","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Astronomia","url":"https://www.publico.pt/2026/08/12/ciencia/noticia/fezse-noite-dia-portugal-viu-sol-esconderse-26-segundos-2184886"},"id":2184886,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":18,"title":"As imagens do eclipse que maravilhou Portugal — e não só","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2109412?tp=UH&db=IMAGENS&type=JPG","author":[{"id":973,"nome":"PÚBLICO","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"","profissaoNaAltura":"","slug":"publico","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":null,"tipo":"EXTERNO"}],"shares":0,"description":"","url":"/2026/08/13/fotogaleria/imagens-eclipse-passou-portugal-415874","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Fotogaleria","url":"https://www.publico.pt/2026/08/13/fotogaleria/imagens-eclipse-passou-portugal-415874"},"id":415874,"type":"FOTOGALERIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":19,"title":"Rio de Onor ficou às escuras: “É a primeira vez que vejo o eclipse”","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/canal_videos/videoPortal/Images/202608/82378798113.jpg?tp=VIDEOS","author":[{"id":7325,"nome":"Joana Gonçalves","descricao":"Licenciei-me em Ciências da Comunicação pela Universidade Nova de Lisboa e concluí, em 2018, uma pós-graduação em Jornalismo Multiplataforma. No mesmo ano comecei a trabalhar na Renascença, a redacção onde me formei, e aprendi que também na rádio há lugar para a imagem. Cheguei ao PÚBLICO em 2022.","email":"jmgoncalves@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Jornalista multimédia","profissaoNaAltura":"Jornalista multimédia","slug":"joana-goncalves","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#118;&#108;&#97;&#99;&#110;&#111;&#103;&#109;&#106;","contribuicao":null,"tipo":"INTERNO"},{"id":7026,"nome":"Tiago Ramalho","descricao":"","email":"tiago.ramalho@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"tiago-ramalho","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"tiagoramalho.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1328997?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#104;&#108;&#97;&#109;&#97;&#114;&#46;&#111;&#103;&#97;&#105;&#116;","contribuicao":null,"tipo":"INTERNO"},{"id":3917,"nome":"Nelson Garrido","descricao":"Nasci em Vila Nova de Gaia, Portugal. Em 1996 concluí o bacharelato em Tecnologias da Comunicação Audiovisual. No mesmo ano, frequentei uma formação avançada em fotografia na escola Karel de Grote-Hogescholl Antwerpen, na Bélgica, e fiz um estágio em fotografia digital e de grande formato no Studio Brison, também na Bélgica. Em Portugal, trabalhei em regime de freelancer com várias revistas, na área da fotografia de reportagem e de arquitectura. Em 2000, concluí a licenciatura em Comunicação Social e em 2005 a Licenciatura em Fotografia. Em 2005, ganhei três menções honrosas no concurso de fotojornalismo da revista Visão e venci a categoria de fotografia de arquitectura do Euro Press Photo Awards da Fuji Film. Fui premiado no Prémio Estação Imagem|Mora em 2010 e 2011. Desde 1999, sou fotojornalista no PÚBLICO.","email":"ngarrido@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Fotojornalista","profissaoNaAltura":"Fotojornalista","slug":"nelson-garrido","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Nelson_Garrido.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737874?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#100;&#105;&#114;&#114;&#97;&#103;&#110;","contribuicao":null,"tipo":"INTERNO"},{"id":3925,"nome":"Joana Bourgard","descricao":"Sou jornalista desde 2007 e, ao longo destes anos de profissão, é a terceira vez que estou no PÚBLICO. Comecei como estagiária, na secção de Fotografia do jornal. Prossegui fotojornalismo no Jornal de Notícias, no Porto, onde fiquei três anos. Foi nessa altura que apareceram os smartphones e as primeiras máquinas fotográficas digitais com a possibilidade de captar imagem em movimento. Tornei-me jornalista multimédia e regressei para Lisboa para fazer parte da equipa de vídeo do PÚBLICO, em 2010. Passado quatro anos juntei-me à equipa multimédia da Rádio Renascença. Por fim, 15 anos depois do estágio no PÚBLICO, regressei em 2022 para editar a secção de Multimédia. Em 2007 fiz parte fundação da <a href=\"https://wilder.pt\">Wilder.pt</a>, um projecto de jornalismo independente dedicado à natureza e biodiversidade.","email":"joana.bourgard@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Editora de Multimédia","profissaoNaAltura":"Editora de Multimédia","slug":"joana-bourgard","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Joana_Bourgard.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737812?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#100;&#114;&#97;&#103;&#114;&#117;&#111;&#98;&#46;&#97;&#110;&#97;&#111;&#106;","contribuicao":null,"tipo":"INTERNO"}],"shares":0,"description":"<p><!--StartFragment-->Centenas de pessoas celebraram os 26 segundos de eclipse total em Portugal.<!--EndFragment--></p>\r\n","url":"/2026/08/12/ciencia/video/rio-onor-ficou-escuras-primeira-vejo-eclipse-20260812-221844","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Vídeo","url":"/video-"},"id":98113,"type":"VIDEO","isMultipleRubric":false,"tag":null,"size":30},{"pos":20,"title":"Cidadãos vão poder pedir indemnizações às entidades públicas que os lesaram","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2109227?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1050,"nome":"Mariana Oliveira","descricao":"Nasci no Porto em 1978 e fiz a licenciatura em Direito na Faculdade de Direito da Universidade do Porto. Quando optei por este curso, já tinha a intenção de me tornar jornalista, seguindo o conselho de alguns profissionais da classe. Depois de terminar a licenciatura, candidatei-me à Formação Geral – Especialização em Jornalismo no Centro Protocolar de Formação Profissional para Jornalistas (Cenjor), em Lisboa. Por isso vivi na capital quase oito meses, entre Dezembro de 2001 e Julho de 2002. Nesse mês, decidi regressar ao Porto para fazer o estágio integrado nessa formação. Fui jornalista estagiária no PÚBLICO entre Julho e Outubro e comecei a trabalhar em Fevereiro de 2003. No início, cobri mais intensivamente áreas ligadas à protecção civil. Actualmente, dedico-me à área da Justiça.","email":"meoliveira@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"mariana-oliveira","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#105;&#101;&#118;&#105;&#108;&#111;&#101;&#109;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Governo quer criar mecanismo para resolver casos de responsabilidade civil extracontratual fora dos tribunais. Casos serão instruídos por novo Conselho de Consultores do Centro Jurídico do Estado.\r\n","url":"/2026/08/13/sociedade/noticia/cidadaos-vao-pedir-indemnizacoes-entidades-publicas-lesaram-2184858","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Justiça","url":"https://www.publico.pt/2026/08/13/sociedade/noticia/cidadaos-vao-pedir-indemnizacoes-entidades-publicas-lesaram-2184858"},"id":2184858,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":21,"title":"Entre menores, asilo e expulsões, Espanha tenta gerir o que sobrou da crise de Ceuta","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2109532?tp=UH&db=IMAGENS&type=JPG","author":[{"id":19691,"nome":"Manuel Monteiro","descricao":"","email":"Manuel.Monteiro@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"manuelc-monteiro","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#114;&#105;&#101;&#116;&#110;&#111;&#77;&#46;&#108;&#101;&#117;&#110;&#97;&#77;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Governo espanhol reúne-se com as comunidades autónomas para distribuir os 2.500 menores chegados a Ceuta. Cinco mil pessoas aguardam resposta, duas semanas depois da crise.","url":"/2026/08/13/mundo/noticia/menores-asilo-expulsoes-espanha-tenta-gerir-sobrou-crise-ceuta-2184932","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Migrações","url":"https://www.publico.pt/2026/08/13/mundo/noticia/menores-asilo-expulsoes-espanha-tenta-gerir-sobrou-crise-ceuta-2184932"},"id":2184932,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":22,"title":"Morte de titular do contrato abre a porta a actualização de rendas antigas","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2109375?tp=UH&db=IMAGENS&type=JPG","author":[{"id":459,"nome":"Rosa Soares","descricao":"","email":"rsoares@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"rosa-soares","imagem":{"w":null,"h":null,"largura":472,"altura":472,"nome":"rosa soares.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1390182?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#114;&#97;&#111;&#115;&#114;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Proposta de lei entregue na AR prevê também a revisão do regime do direito de preferência dos arrendatários na compra e venda de imóveis arrendados.","url":"/2026/08/13/economia/noticia/morte-titular-contrato-abre-porta-actualizacao-rendas-antigas-2184872","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Arrendamento","url":"https://www.publico.pt/2026/08/13/economia/noticia/morte-titular-contrato-abre-porta-actualizacao-rendas-antigas-2184872"},"id":2184872,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":23,"title":"Europa enfrenta a quinta vaga de calor de 2026","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2109475?tp=UH&db=IMAGENS&type=JPG","author":[{"id":177,"nome":"Andréia Azevedo Soares","descricao":"Nasci no Rio de Janeiro, onde estudei jornalismo na Universidade Federal. Mudei-me para Portugal em 1999. Trabalho no PÚBLICO desde 2000, com duas interrupções – uma para um doutoramento em Comunicação de Ciência no Imperial College, em Londres, e outra para colaborar com a revista científica WHO Bulletin, em Genebra. Já fui estagiária, colaboradora, repórter e sub-editora em diferentes secções deste jornal. A ciência e a literatura são as áreas sobre as quais mais gosto de escrever; fascina-me o modo como o escritor e o cientista se empenham para detalhar e compreender o mundo que nos rodeia, incluindo os seres vivos que nele habitam.\r\n\r\n\r\n\r\n","email":"aasoares@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"andreia-azevedo-soares","imagem":{"w":null,"h":null,"largura":501,"altura":498,"nome":"andreia_soares-removebg-preview.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1725026?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#114;&#97;&#111;&#115;&#97;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Mais de 135 milhões de pessoas deverão estar expostas esta quinta-feira a temperaturas acima dos 35 graus Celsius, sobretudo em França, Itália, Espanha e Reino Unido.\r\n\r\n","url":"/2026/08/13/azul/noticia/europa-enfrenta-quinta-vaga-calor-2026-2184926","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Onda de calor","url":"https://www.publico.pt/2026/08/13/azul/noticia/europa-enfrenta-quinta-vaga-calor-2026-2184926"},"id":2184926,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":24,"title":"Regras para manter apoio a obras inacabadas do PRR entram em vigor amanhã","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2109501?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1022,"nome":"Victor Ferreira","descricao":"Teria sido médico, se desse mais ouvidos aos meus pais, ou matemático ou bioquímico, se me tivesse aplicado a concluir os primeiros cursos superiores em que me matriculei. Porém, no Verão dos meus 18 anos, entrei pela primeira vez numa redacção. Era um jornal local, Guimarães, onde ainda hoje vive a minha família. Essa curta experiência, enquanto esperava pela universidade, mudou as minhas aspirações. Anos depois, pendurei um hipotético futuro de bata branca à volta de microscópios e abracei o sonho de transformar o mundo no meu laboratório. Porque o jornalismo é isso: um ensaio permanente. Desde 1999, já experimentei um pouco de tudo, do noticiário local ao desporto, fiz reportagem por todo o país, na Europa, em África, nos Estados Unidos. Tenho um MBA pela Porto Business School, com especialização em Comportamento Organizacional.","email":"voferreira@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"victor-ferreira","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Vitor Ferreira.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/2001908?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#105;&#101;&#114;&#114;&#101;&#102;&#111;&#118;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Entidades públicas e IPSS com obras quase feitas podem passar para o Portugal 2030, se cumprirem requisitos obrigatórios. Excepcionalmente, eventuais dívidas do PRR não impedirão candidaturas.","url":"/2026/08/13/economia/noticia/regras-manter-apoio-obras-inacabadas-prr-entram-vigor-amanha-2184941","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Plano de Recuperação e Resiliência","url":"https://www.publico.pt/2026/08/13/economia/noticia/regras-manter-apoio-obras-inacabadas-prr-entram-vigor-amanha-2184941"},"id":2184941,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":25,"title":"Alunos com necessidades específicas sem vaga: “Estou com medo de que não tenha aulas”","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2109234?tp=UH&db=IMAGENS&type=JPG","author":[{"id":6039,"nome":"Cristiana Faria Moreira","descricao":"","email":"cristiana.moreira@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"cristiana-faria-moreira","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Cristiana Faria Moreira.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1602146?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#105;&#101;&#114;&#111;&#109;&#46;&#97;&#110;&#97;&#1