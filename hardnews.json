[{"pos":0,"title":"Com 410 ataques, apanha da azeitona na Cisjordânia vive pior ano de sempre","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2131964?tp=UH&db=IMAGENS&type=JPG","author":[{"id":14261,"nome":"Carolina Amado","descricao":"","email":"carolina.amado@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"na Cisjordânia ","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"carolina-amado","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#100;&#97;&#109;&#97;&#46;&#97;&#110;&#105;&#108;&#111;&#114;&#97;&#99;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Colheita da azeitona ainda é uma das bases da cultura e economia palestinianas, mas violência por parte de colonos torna cada vez mais arriscada a ida de famílias para os seus olivais.","url":"/2026/11/22/mundo/reportagem/410-ataques-colonos-tao-violento-colher-azeitonas-cisjordania-2194784","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Reportagem","url":"/palestina"},"id":2194784,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":1,"title":"Vozes humanitárias: o som da esperança","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2131318?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"<!--StartFragment--><span data-olk-copy-source=\"MessageBody\" style=\"color: black; font-family: Aptos;\">Da S&iacute;ria ao Haiti, passando pelo Burundi, a Uni&atilde;o Europeia &eacute; uma pe&ccedil;a essencial da ajuda em contextos de crise em todo o mundo.&nbsp;</span><!--EndFragment-->","url":"https://www.publico.pt/estudiop/conteudo_patrocinado/som-esperanca","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Conteúdo Comercial","url":"/estudiop_sociedade"},"id":27353,"type":"EXTERNOS","isMultipleRubric":false,"tag":null,"size":30},{"pos":2,"title":"Katja Hoyer: “O mal pode acontecer quando as pessoas boas não fazem nada”","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2132541?tp=UH&db=IMAGENS&type=JPG","author":[{"id":361,"nome":"Teresa de Sousa","descricao":"Estreei-me, por puro acaso, como jornalista em 1977 no Jornal Novo. A redacção precisava de gente com espírito combativo suficiente para contrariar uma visão do mundo que ainda era dominada pela influência da esquerda comunista e “terceiro-mundista” e que prevalecia na imprensa portuguesa dos anos seguintes ao PREC. Estávamos em plena guerra fria. Já tinha escrito sobre política internacional nos jornais de extrema-esquerda – em Paris, antes do 25 de Abril; em Lisboa, depois. E lá fui cumprir a minha tarefa, um pouco desconfiada. Entrei como estagiária. Três meses depois, estava a editar a secção de Política Internacional. Aprendi imenso. Nunca mais deixei o jornalismo. Seguiram-se a RDP e o Expresso. Muitas campanhas eleitorais. Muita análise política. Até que o mundo me voltou a chamar. O PÚBLICO nasceu também para responder diariamente às mudanças tectónicas que aconteciam na Europa. Gorbatchov, a queda do Muro. A implosão da União Soviética. Tive a sorte de cobrir alguns desses acontecimentos – em Berlim ou em Moscovo. A História “acelerava” na Europa. A Europa passou a ser uma das minhas áreas fundamentais de especialização. Estudei Economia no velho ISCEF. Escrevi alguns livros. O primeiro, uma biografia de Mário Soares. O último, uma longa conversa com ele sobre a crise portuguesa. Outros, em co-autoria, sobre Portugal e a Europa. Tive a oportunidade de entrevistar alguns intelectuais e académicos europeus e americanos. Aprendi imenso com eles.","email":"teresa.de.sousa@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"teresa-de-sousa","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"teresa-de-sousa.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1748287?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#115;&#117;&#111;&#115;&#46;&#101;&#100;&#46;&#97;&#115;&#101;&#114;&#101;&#116;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Através da vida de pessoas comuns de Weimar, centro nevrálgico do poder nazi, a historiadora Katja Hoyer conta como nesta cidade alemã foi possível que o bem e o mais inominável horror prosperassem.","url":"/2026/11/22/culturaipsilon/entrevista/katja-hoyer-mal-acontecer-pessoas-boas-nao-fazem-nada-2195591","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Entrevista","url":"/alemanha"},"id":2195591,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":3,"title":"Transporte de petróleo em queda enquanto Irão aumenta ataques a petroleiros em Ormuz","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2132768?tp=UH&db=IMAGENS&type=JPG","author":[{"id":19168,"nome":"Francisco José Costa","descricao":"","email":"francisco.costa@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"francisco-jose-costa","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#116;&#115;&#111;&#99;&#46;&#111;&#99;&#115;&#105;&#99;&#110;&#97;&#114;&#102;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Cada vez menos navios arriscam atravessar o estreito sob bloqueio iraniano, com mais três petroleiros atingidos no sábado. Teerão diz que bloqueio dos EUA a portos iranianos “tem de ser quebrado”.","url":"/2026/11/22/mundo/noticia/estreito-ormuz-transporte-petroleo-queda-irao-aumenta-ataques-petroleiros-2195877","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Estreito de Ormuz","url":"https://www.publico.pt/2026/11/22/mundo/noticia/estreito-ormuz-transporte-petroleo-queda-irao-aumenta-ataques-petroleiros-2195877"},"id":2195877,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":4,"title":"Domina a arte de preparar um bom café em casa?","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2131233?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"Preparar um bom café é uma arte feita de pequenos detalhes. Da escolha dos grãos à moagem e à extracção, cada etapa conta para chegar à chávena perfeita.","url":"/2026/11/17/estudiop/noticia/domina-arte-preparar-bom-cafe-casa-2195106","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":{"id":0,"name":"Delonghi","ImageUrl":"https://imagens.publico.pt/imagens.aspx/2131350?tp=UH&db=IMAGENS","slug":null,"url":null},"rubric":{"name":"Conteúdo comercial","url":"https://www.publico.pt/2026/11/17/estudiop/noticia/domina-arte-preparar-bom-cafe-casa-2195106"},"id":2195106,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":5,"title":"Onda de derrotas populistas vai fazer o Chega mudar?","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2132732?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1085,"nome":"Bárbara Reis","descricao":"Fui para o Expresso porque queria ser fotógrafa, mas acabei por aprender a escrever. Tinha 17 anos. O PÚBLICO nasceu dois anos depois e os fundadores “trouxeram-me”. Trabalhei no Internacional, cobri eleições, fui à Somália no início da guerra civil e escrevi muito sobre sida. Um dia perguntaram-me se queria ser correspondente em Nova Iorque. Fiquei cinco anos. Foi a era Clinton, mas também a das negociações na ONU entre Portugal e a Indonésia sobre Timor. Passei tantas horas nos corredores do Conselho de Segurança que acabei por aterrar em Díli com passaporte das Nações Unidas. Era o que fazia sentido: trabalhar com Sérgio Vieira de Mello e ver o país nascer. Fui por seis meses para dar formação a jornalistas, mas fiquei dois anos como porta-voz da missão. Regressei ao PÚBLICO em 2002. Editei a Cultura, ajudei a lançar o P2, fui executiva da direcção. Fui directora de 2009 a 2016.","email":"breis@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Redactora principal","profissaoNaAltura":"Redactora principal","slug":"barbara-reis","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"barbara-reis-nova.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1739850?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":"Bárbara Reis","translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#105;&#101;&#114;&#98;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"O Chega está a ficar “mole”? Deve mudar? Radicalizar? Moderar? Militantes discutem o que o partido deve fazer para evitar a onda das últimas derrotas populistas na Europa e EUA.","url":"/2026/11/22/politica/noticia/onda-derrotas-populistas-vai-chega-mudar-2195858","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"VII Convenção do Chega","url":"https://www.publico.pt/2026/11/22/politica/noticia/onda-derrotas-populistas-vai-chega-mudar-2195858"},"id":2195858,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":6,"title":"Ventura quer Chega a passar de partido de “ressentimento” para “projecto de governo”","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2132763?tp=UH&db=IMAGENS&type=JPG","author":[{"id":18186,"nome":"Joana Mesquita","descricao":"","email":"joana.mesquita@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"joana-mesquita","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#116;&#105;&#117;&#113;&#115;&#101;&#109;&#46;&#97;&#110;&#97;&#111;&#106;","contribuicao":"","tipo":"INTERNO"},{"id":3520,"nome":"David Santiago","descricao":"","email":"david.santiago@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Editor de Política","profissaoNaAltura":"","slug":"david-santiago","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"David Santiago.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1765612?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#103;&#97;&#105;&#116;&#110;&#97;&#115;&#46;&#100;&#105;&#118;&#97;&#100;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"VII Convenção Nacional do Chega termina neste domingo com discurso de André Ventura. Moções temáticas (92) foram todas aprovadas.","url":"/2026/11/22/politica/noticia/ventura-quer-chega-passar-partido-ressentimento-projecto-governo-2195875","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"VII Convenção do Chega","url":"https://www.publico.pt/2026/11/22/politica/noticia/ventura-quer-chega-passar-partido-ressentimento-projecto-governo-2195875"},"id":2195875,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":7,"title":"Quatro dias para celebrar a Casa da Arquitetura","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2131494?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"Nono aniversário com programação gratuita entre 19 e 22 de Novembro.","url":"/2026/11/17/estudiop/noticia/quatro-dias-celebrar-casa-arquitetura-2195256","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":{"id":0,"name":"CASA DA ARQUITETURA","ImageUrl":"https://imagens.publico.pt/imagens.aspx/2099922?tp=UH&db=IMAGENS","slug":null,"url":null},"rubric":{"name":"Conteúdo comercial","url":"https://www.publico.pt/2026/11/17/estudiop/noticia/quatro-dias-celebrar-casa-arquitetura-2195256"},"id":2195256,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":8,"title":"PSD, PS e Chega trocam acusações sobre responsabilidade e preocupação social","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2132765?tp=UH&db=IMAGENS&type=JPG","author":[{"id":9556,"nome":"PÚBLICO e Lusa","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"publico-e-lusa","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"","contribuicao":"","tipo":"EXTERNOP3"}],"shares":0,"description":"Hugo Soares diz que “PS é viciado em impostos e o Chega viciado no PS”. Mendonça Mendes garante que PS tudo fará para garantir excedente. Ventura acusa PSD de não se preocupar com custo de vida.","url":"/2026/11/22/politica/noticia/hugo-soares-ps-viciado-impostos-chega-viciado-ps-2195878","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Orçamento do Estado 2027","url":"https://www.publico.pt/2026/11/22/politica/noticia/hugo-soares-ps-viciado-impostos-chega-viciado-ps-2195878"},"id":2195878,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":9,"title":"COP31 termina sem acordo após bloqueio da UE e outros países","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2132761?tp=UH&db=IMAGENS&type=JPG","author":[{"id":6488,"nome":"Aline Flor","descricao":"Natural do Rio de Janeiro, vivo em Portugal há quase 30 anos. Criei raízes. Fui directora do Jornal Universitário do Porto, passei pela Ciência e Tecnologia no Canal Superior, editei notícias do portal AEIOU.pt. Fiz um mestrado em Cinema Documental que me abriu os olhos (e ouvidos) para a riqueza de cada encontro com o outro. Cheguei ao PÚBLICO para integrar a equipa de áudio, onde produzi podcasts em áreas desde a igualdade de género às questões europeias. Hoje sou jornalista do Azul, a nossa secção dedicada à crise climática e sustentabilidade, e aventurei-me num segundo mestrado: Economia e Gestão do Ambiente. Gosto de ouvir e de contar as histórias que ficam à margem e acredito que temos sempre algo a aprender quando encaramos o desafio de traduzir no preto e branco dos caracteres as infinitas tonalidades que nos rodeiam.","email":"aline.flor@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"em Istambul","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"aline-flor","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Aline Flor z.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1530339?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#114;&#111;&#108;&#102;&#46;&#101;&#110;&#105;&#108;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"COP31 é oficialmente a cimeira do clima mais longa de sempre. União Europeia, Panamá, Ilhas Marshall e Noruega rejeitaram formalmente a proposta de decisão final, impedindo a sua adopção por consenso.","url":"/2026/11/22/azul/noticia/pacto-antalia-rejeitado-cop31-apos-bloqueio-ue-paises-2195871","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"COP31","url":"https://www.publico.pt/2026/11/22/azul/noticia/pacto-antalia-rejeitado-cop31-apos-bloqueio-ue-paises-2195871"},"id":2195871,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":10,"title":"«Outlander» prossegue a viagem por uma América em revolução","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2131699?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"Na segunda metade da 7.ª temporada de «Outlander», Jamie, Claire e Ian voltam a Lallybroch, enquanto Roger e Buck procuram Jemmy no passado. Na América, há personagens com o futuro por resolver.","url":"/2026/11/18/estudiop/noticia/outlander-prossegue-viagem-america-revolucao-2195339","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":{"id":0,"name":"AXN","ImageUrl":"https://imagens.publico.pt/imagens.aspx/1953085?tp=UH&db=IMAGENS","slug":null,"url":null},"rubric":{"name":"Conteúdo comercial","url":"https://www.publico.pt/2026/11/18/estudiop/noticia/outlander-prossegue-viagem-america-revolucao-2195339"},"id":2195339,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":11,"title":"PP e Vox mantêm maioria absoluta nas sondagens, resta saber como poderão governar","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2132660?tp=UH&db=IMAGENS&type=JPG","author":[{"id":19168,"nome":"Francisco José Costa","descricao":"","email":"francisco.costa@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"francisco-jose-costa","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#116;&#115;&#111;&#99;&#46;&#111;&#99;&#115;&#105;&#99;&#110;&#97;&#114;&#102;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"O mais provável é coligação em que o Vox tenha “capacidade de decisão e de reclamar ministérios alinhados com a sua ideologia”, aponta Juan Manfredi, professor na Universidade de Castilla-La Mancha.","url":"/2026/11/22/mundo/noticia/eleicoes-espanha-pp-vox-mantem-maioria-absoluta-sondagens-resta-saber-poderao-governar-2195830","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Eleições Espanha 2026","url":"https://www.publico.pt/2026/11/22/mundo/noticia/eleicoes-espanha-pp-vox-mantem-maioria-absoluta-sondagens-resta-saber-poderao-governar-2195830"},"id":2195830,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":12,"title":"Marc Márquez campeão pela oitava vez: transformou o impossível no inevitável\r\n","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2132771?tp=UH&db=IMAGENS&type=JPG","author":[{"id":206,"nome":"Marco Vaza","descricao":"O desporto tem vencedores e perdedores, heróis e vilões e a história nem sempre é sobre o que ganha. Eu escrevo sobre aquele que marca o golo decisivo, sobre aquele que corre mais do que os outros, sobre aquele que não desiste ou sobre aquele que desistiu quando estava perto do fim. Já assisti ao vivo a grandes goleadas, recordes do mundo, estreias de futuras estrelas e despedidas de mitos. Entrei no PÚBLICO como estagiário em 1999 para a secção de Desporto, onde continuo, depois de uma comissão entre 2006 e 2009 como editor da revista de domingo. Para além de centenas de jogos de futebol, já estive em duas edições dos Jogos Olímpicos (Atenas 2004 e Londres 2012), numa edição dos Mundiais de atletismo (Helsínquia 2005) e noutras competições de muitas modalidades. O desporto dos outros é a minha profissão.","email":"mvaza@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"marco-vaza","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Marco_Vaza.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737861?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#122;&#97;&#118;&#109;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"O piloto espanhol da Ducati jogou pelo seguro em Portimão (foi 8.º) e garantiu mais um título em MotoGP, juntando-se a Giacomo Agostini no topo da lista dos supercampeões do motociclismo.","url":"/2026/11/22/desporto/noticia/marc-marquez-campeao-oitava-transformou-impossivel-inevitavel-2195879","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"MotoGP","url":"https://www.publico.pt/2026/11/22/desporto/noticia/marc-marquez-campeao-oitava-transformou-impossivel-inevitavel-2195879"},"id":2195879,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":13,"title":"Uma lei europeia do oceano","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2131743?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"<!--StartFragment--><span data-olk-copy-source=\"MessageBody\" style=\"font-family: Aptos, Aptos_EmbeddedFont, Aptos_MSFontService, Calibri, Helvetica, sans-serif; font-size: 12pt; color: rgb(0, 0, 0);\">&nbsp;A Europa depende do mar como de poucas outras coisas, mas continua a decidir sobre ele de forma dispersa e n&atilde;o articulada.</span><!--EndFragment-->","url":"https://www.publico.pt/estudiop/conteudo_patrocinado/lei-oceano","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"CONTEÚDO COMERCIAL","url":"/estudiop_sustentabilidade"},"id":27354,"type":"EXTERNOS","isMultipleRubric":false,"tag":null,"size":30},{"pos":14,"title":"Miguel Castelo-Branco: “A empatia venceu a força”","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2132503?tp=UH&db=IMAGENS&type=JPG","author":[{"id":20255,"nome":"Alexandra Carita","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura"