":416098,"type":"FOTOGALERIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":7,"title":"Taxistas das chegadas do Aeroporto de Lisboa já têm mesmo de aplicar preços fixos","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2123302?tp=UH&db=IMAGENS&type=JPG","author":[{"id":217,"nome":"Samuel Alemão","descricao":"","email":"smalemao@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"samuel-alemao","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Samuel Alemao.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1990666?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#97;&#109;&#101;&#108;&#97;&#109;&#115;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Sistema prevê valores dentro da cidade e para cada destino da tabela “táxi-voucher” do Turismo de Lisboa. Todos os outros não abrangidos continuam a ser cobrados a taxímetro.","url":"/2026/10/15/local/noticia/taxistas-chegadas-aeroporto-lisboa-ja-aplicar-precos-fixos-2191503","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Transportes","url":"https://www.publico.pt/2026/10/15/local/noticia/taxistas-chegadas-aeroporto-lisboa-ja-aplicar-precos-fixos-2191503"},"id":2191503,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":8,"title":"PGL da AESE Business School: Investir na formação para progredir na carreira","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2116738?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"Destinado a profissionais em transição, este curso potencia as capacidades de liderança. Novas edições acontecem em Lisboa, já a partir de Outubro, e no Porto, em Fevereiro de 2027.","url":"/2026/10/13/estudiop/noticia/pgl-aese-business-school-investir-formacao-progredir-carreira-2188488","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":{"id":0,"name":"AESE","ImageUrl":"https://imagens.publico.pt/imagens.aspx/1689069?tp=UH&db=IMAGENS","slug":null,"url":null},"rubric":{"name":"Conteúdo comercial","url":"https://www.publico.pt/2026/10/13/estudiop/noticia/pgl-aese-business-school-investir-formacao-progredir-carreira-2188488"},"id":2188488,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":9,"title":"Vodafone critica Anacom, opõe-se a Huawei fora do 5G e espera mudanças na Sport TV","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2123294?tp=UH&db=IMAGENS&type=JPG","author":[{"id":19360,"nome":"Diogo Cavaleiro","descricao":"Estagiei no PÚBLICO em 2009 no Local Lisboa, tendo no ano seguinte entrado no <em>Jornal de Negócios</em>, onde fiquei por quase nove anos. O sector bancário foi aquele em que me especializei, tendo publicado um livro – <em>Caixa Negra</em> – sobre décadas de gestão e polémica na Caixa Geral de Depósitos, em 2017. Em 2019, segui para o <em>Expresso</em>, continuando na mesma área, onde fiquei até Maio de 2025. Regresso agora ao PÚBLICO para continuar esse trabalho, integrando a secção de Economia. Licenciado em Ciências da Comunicação, tenho pós-graduações em Ciência Política – Relações Internacionais, na vertente de Estudos Europeus, e em Compliance.","email":"diogo.cavaleiro@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"diogo-cavaleiro","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Diogo Cavaleiro.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/2051033?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"