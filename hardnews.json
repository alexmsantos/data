[{"pos":0,"title":"Grupo de trabalho propõe gestão individualizada das pensões","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2110490?tp=UH&db=IMAGENS&type=JPG","author":[{"id":3150,"nome":"Raquel Martins","descricao":"Aos 15 anos decidi que queria mudar o mundo e, para desgosto da minha professora de Português, quis ser jornalista. Fiz o curso de Ciências da Comunicação na Universidade Nova, frequentei o Cenjor e andei indecisa entre a rádio e a imprensa. Depois de uma breve passagem pela rádio (Antena 3 e Rádio Expo), acabei por entrar no jornalismo económico um pouco por acaso. Primeiro, no Diário Económico – onde escrevi sobre ambiente, autarquias, política e, mais tarde, sobre trabalho e função pública – depois no Jornal de Negócios. Foi por isso que, em 2009, fiz uma formação na Universidade Católica sobre legislação laboral. Estou no PÚBLICO desde 2010. Acompanho os assuntos relacionados com trabalho, emprego e administração pública (há quem diga, com humor, que o Código do Trabalho é o meu livro de cabeceira.) Defendo que o jornalismo tem um papel cada vez mais importante na descodificação da avalanche de informação que todos os dias circula nas mais diversas plataformas.","email":"raquel.martins@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"raquel-martins","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"raquel-martins-removebg-preview.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1991256?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":"Debi Thomas","translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#110;&#105;&#116;&#114;&#97;&#109;&#46;&#108;&#101;&#117;&#113;&#97;&#114;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Relatório prevê uma mudança profunda do sistema de pensões, apostando num modelo mais individualizado e propondo várias soluções complementares. Governo afasta-se, para já, do documento.","url":"/2026/08/19/economia/noticia/grupo-trabalho-propoe-contas-individuais-mantem-sistema-publico-reparticao-2185442","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Segurança Social","url":"https://www.publico.pt/2026/08/19/economia/noticia/grupo-trabalho-propoe-contas-individuais-mantem-sistema-publico-reparticao-2185442"},"id":2185442,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":1,"title":"Carregar um eléctrico é demorado? A prova dos 15 Minutos no Kauai EV","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2100713?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"O tempo de espera do carregamento é, frequentemente, o maior obstáculo apontado à transição para a mobilidade eléctrica. Mas a Hyundai está a transformar uma “eternidade” em “oportunidade”.","url":"/2026/07/30/estudiop/noticia/demora-eterna-pergunta-electricos-resposta-2180752","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":{"id":0,"name":"HYUNDAI","ImageUrl":"https://imagens.publico.pt/imagens.aspx/2089885?tp=UH&db=IMAGENS","slug":null,"url":null},"rubric":{"name":"Conteúdo comercial","url":"https://www.publico.pt/2026/07/30/estudiop/noticia/demora-eterna-pergunta-electricos-resposta-2180752"},"id":2180752,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":2,"title":"Mais de 1800 operadores ilegais de jogo <em>online</em> notificados para encerrar","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2110464?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1081,"nome":"Patrícia Carvalho","descricao":"Nasci no Porto, fiz a licenciatura em Ciências da Comunicação na Universidade Nova de Lisboa, entre 1993 e 1997, e estagiei no Jornal do Letras. Apesar da insistência de chefes e colegas para ficar pela capital, preferi voltar a casa e estive com a equipa que abriu o 24horas no Porto. Saí ao fim de um ano, para O Comércio do Porto, onde fiquei até ao seu encerramento, em 2005. Antes de ingressar no PÚBLICO, em 2008, colaborei com várias publicações, incluindo a Grande Reportagem, Visão, Notícias de Sábado e Sábado. No PÚBLICO, integro, desde a minha chegada, a equipa do Local Porto, mas fui sempre participando em outras áreas do jornal, com trabalhos para o P2 ou a Pública (que, entretanto, terminaram), a Fugas ou, mais recentemente, a revista 2.","email":"patricia.carvalho@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"patricia-carvalho","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Patricia Carvalho.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1381570?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#104;&#108;&#97;&#118;&#114;&#97;&#99;&#46;&#97;&#105;&#99;&#105;&#114;&#116;&#97;&#112;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Lucros das empresas legais de jogo <em>online</em> não páram de crescer, com os jogos de fortuna e azar a representarem quase o dobro das apostas desportivas à cota.","url":"/2026/08/19/sociedade/noticia/jogo-ilegal-desde-2015-notificados-encerramento-1800-operadores-online-2185358","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Apostas online","url":"https://www.publico.pt/2026/08/19/sociedade/noticia/jogo-ilegal-desde-2015-notificados-encerramento-1800-operadores-online-2185358"},"id":2185358,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":3,"title":"Quatro bombeiros feridos com gravidade em despi