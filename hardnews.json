[{"pos":0,"title":"Baixa de Lisboa prepara-se para perder todo o mundo financeiro","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2111113?tp=UH&db=IMAGENS&type=JPG","author":[{"id":19360,"nome":"Diogo Cavaleiro","descricao":"Estagiei no PÚBLICO em 2009 no Local Lisboa, tendo no ano seguinte entrado no <em>Jornal de Negócios</em>, onde fiquei por quase nove anos. O sector bancário foi aquele em que me especializei, tendo publicado um livro – <em>Caixa Negra</em> – sobre décadas de gestão e polémica na Caixa Geral de Depósitos, em 2017. Em 2019, segui para o <em>Expresso</em>, continuando na mesma área, onde fiquei até Maio de 2025. Regresso agora ao PÚBLICO para continuar esse trabalho, integrando a secção de Economia. Licenciado em Ciências da Comunicação, tenho pós-graduações em Ciência Política – Relações Internacionais, na vertente de Estudos Europeus, e em Compliance.","email":"diogo.cavaleiro@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"diogo-cavaleiro","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Diogo Cavaleiro.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/2051033?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#114;&#105;&#101;&#108;&#97;&#118;&#97;&#99;&#46;&#111;&#103;&#111;&#105;&#100;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Banco de Portugal vai sair e põe um fim à Baixa como pólo financeiro, um desfecho que há décadas vem sendo desenhado, apesar de até ter havido um plano para dar centralidade à zona.","url":"/2026/08/24/economia/noticia/baixa-lisboa-preparase-perder-mundo-financeiro-2185735","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"