al-20261013-170438","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Vídeo","url":"/video-"},"id":98369,"type":"VIDEO","isMultipleRubric":false,"tag":null,"size":30},{"pos":26,"title":"Para Teixeira da Mota, Alberto João Jardim era um <em>\"tiranete\"</em>","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/canal_videos/videoPortal/Images/202610/thumb limpa98365.jpg?tp=VIDEOS","author":[{"id":3890,"nome":"Francisco Teixeira da Mota","descricao":"Sou advogado em Lisboa há mais de 30 anos e do PÚBLICO e dos seus jornalistas desde o primeiro dia. Procuro alargar os limites da liberdade de expressão no nosso país, tanto nos tribunais nacionais como junto do Tribunal Europeu dos Direitos do Homem. Acho que o direito, tal como a vida, não tem de ser, obrigatoriamente, cinzento e pesado, pelo que a minha coluna Escrever Direito – que se debruça semanalmente sobre realidades jurídicas e judiciais – procura ser leve e, por vezes, divertida. A partir de investigações sobre processos judiciais, escrevi dois livros: Alves Reis, Uma História Portuguesa e Henrique Galvão, Um Herói Português.","email":"francisco@teixeiradamota.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Advogado","profissaoNaAltura":"Advogado","slug":"francisco-teixeira-da-mota","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"teixeira_da_mota_z-nova.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1739384?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#97;&#116;&#111;&#109;&#97;&#100;&#97;&#114;&#105;&#101;&#120;&#105;&#101;&#116;&#64;&#111;&#99;&#115;&#105;&#99;&#110;&#97;&#114;&#102;","contribuicao":null,"tipo":"COLUNISTAS"},{"id":18082,"nome":"Leonor Caldeira","descricao":"Jurista, feminista e ecologista. Acredita que o Direito e os Tribunais são ferramentas capazes de provocar progresso social e ecológico e que a advocacia pode (e deve) dar um grande contributo nessa tarefa. Depois de trabalhar numa sociedade de advogados em Lisboa e numa ONG de direito do ambiente em Bruxelas, dedica-se agora à prática da advocacia de forma independente em Portugal. Em 2022, recebeu o Prémio Mandela da Associação ProPública — Direito e Cidadania. Desde 2023 é cronista na Revista Sábado.","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"","profissaoNaAltura":"","slug":"leonor-caldeira","imagem":{"w":null,"h":null,"largura":630,"altura":396,"nome":"WhatsApp_Image_2024-03-05_at_16.32.28-removebg-preview (1).png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1889311?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"","contribuicao":null,"tipo":"EXTERNOP3"},{"id":20656,"nome":"Luís Varela","descricao":"","email":"luis.varela@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"","profissaoNaAltura":"","slug":"luis-varela","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#108;&#101;&#114;&#97;&#118;&#46;&#115;&#105;&#117;&#108;","contribuicao":null,"tipo":"INTERNO"}],"shares":0,"description":"<p>Um &quot;tiranete&quot; que intimidava a oposi&ccedil;&atilde;o e instrumentalizava os tribunais, Alberto Jo&atilde;o&nbsp;Jardim aos olhos de Teixeira da Mota.</p>\r\n","url":"/2026/10/13/video/teixeira-mota-alberto-joao-jardim-tiranete-20261012-173132","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Vídeo","url":"/video-"},"id":98365,"type":"VIDEO","isMultipleRubric":false,"tag":null,"size":30},{"pos":27,"title":"Polí