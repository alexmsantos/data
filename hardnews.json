k":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"fernando-costa","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"fernando costa.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1868660?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#116;&#115;&#111;&#99;&#46;&#111;&#100;&#110;&#97;&#110;&#114;&#101;&#102;","contribuicao":null,"tipo":"INTERNO"}],"shares":0,"description":"<p><span style=\"font-family: Georgia, &quot;Times New Roman&quot;, serif; font-size: 20px;\">Uma leitura abusiva de um estudo levou &agrave; dissemina&ccedil;&atilde;o da narrativa falsa.</span></p>\r\n","url":"/2026/08/03/video/protector-solar-provoca-cancro-pele-nao-narrativa-falsa-20260803-161240","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Vídeo","url":"/video-"},"id":98095,"type":"VIDEO","isMultipleRubric":false,"tag":null,"size":30},{"pos":26,"title":"Joana Marques e a polémica com Mafalda Matos sobre autismo: “Se calhar, 50% acharam piada e 50% acharam deplorável”","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/canal_videos/videoPortal/Images/202608/ASL_JoanaMarques98094.jpg?tp=VIDEOS","author":[{"id":281,"nome":"Ana Sá Lopes","descricao":"Sempre quis ser jornalista, ao mesmo tempo que automobilista de Fórmula 1 (não tenho carta de condução) e arqueóloga, por causa de Michel Vaillant e Blake e Mortimer. Acabei por começar a escrever coisas no jornal da terra onde vivi desde criança, a Gazeta das Caldas, de Caldas da Rainha. Como toda a minha geração de jornalistas, andei pelas rádios piratas, a Rádio Litoral Oeste e a Rádio Margem. Concorri a um concurso de estagiários para o extinto semanário \"O Jornal\" e para meu júbilo fui uma das seleccionadas. Fui muito feliz por lá, como na fundação do PÚBLICO, um momento transcendental na vida de todos os que passámos por isso. No PÚBLICO trabalhei essencialmente na secção política, fui jornalista parlamentar, \"fiz\" o PSD, umas reportagens razoáveis em Angola e Timor-Leste e fui durante uns anos editora de política. Saí do jornal no fim de 2005, passei dois anos no Diário de Notícias, onde fui redactora-principal e depois editora de política. Saí do DN em 2008 para fazer parte da equipa fundadora do i. No i fui directora adjunta de Janeiro de 2011 até à minha saída em  Julho de 2018, quando o director Manuel Carvalho me convidou para ser directora-adjunta do PÚBLICO. Com a remodelação da direcção editorial do PÚBLICO, passei a redactora principal em Setembro deste ano.","email":"ana.sa.lopes@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Redactora-principal","profissaoNaAltura":"Redactora-principal","slug":"ana-sa-lopes","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"ana-sa-lopes-nova.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1739858?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":"Ana Sousa Dias","translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#112;&#111;&#108;&#46;&#97;&#115;&#46;&#97;&#110;&#97;","contribuicao":null,"tipo":"INTERNO"},{"id":19752,"nome":"Tiago Orato","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Sonoplasta","profissaoNaAltura":"Sonoplasta","slug":"tiago-orato","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"","contribuicao":null,"tipo":"INTERNO"},{"id":13909,"nome":"Michelle Coelho","descricao":"","email":"michelle.coelho@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Redes sociais","profissaoNaAltura":"Redes sociais","slug":"-michelle-coelho","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#104;&#108;&#101;&#111;&#99;&#46;&#101;&#108;&#108;&#101;&#104;&#99;&#105;&#109;","contribuicao":null,"tipo":"INTERNO"}],"shares":0,"description":"<p>A humorista reage &agrave; pol&eacute;mica em torno de um <em>sketch </em>sobre a actriz Mafalda Matos e garante estar de consci&ecirc;ncia tranquila.</p>\r\n","url":"/2026/08/03/video/joana-marques-polemica-mafalda-matos-autismo-calhar-50-acharam-piada-50-acharam-deploravel-20260803-160432","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Vídeo","url":"/video-"},"id":98094,"type":"VIDEO","isMultipleRubric":false,"tag":null,"size":30},{"pos":27,"title":"Milhares de migrantes chegaram a Ceuta, em 24 horas, quase metade já regressou a Marrocos","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/canal_videos/videoPortal/Images/202607/ceuta298077.jpg?tp=VIDEOS","author":[{"id":16905,"nome":"Marta Sofia Ribeiro","descricao":"","email":"marta.ribeiro@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"marta-sofia-ribeiro","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#114;&#105;&#101;&#98;&#105;&#114;&#46;&#97;&#116;&#114;&#97;&#109;","contribuicao":null,"tipo":"INTERNO"},{"id":18382,"nome":"José Carvalheiro","descricao":"","email":"Jose.Carvalheiro@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Motion designer","profissaoNaAltura":"Motion designer","slug":"jose-carvalheiro","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#114;&#105;&#101;&#104;&#108;&#97;&#118;&#114;&#97;&#67;&#46;&#101;&#115;&#111;&#74;","contribuicao":null,"tipo":"INTERNO"},{"id":890,"nome":"Reuters","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"","profissaoNaAltura":"","slug":"reuters","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":null,"tipo":"AGENCIAS"}],"shares":0,"description":"<p>Imagens partilhadas pela ag&ecirc;ncia Reuters mostram milhares de pessoas a tentar entrar no enclave espanhol, a nado e por via terrestre.&nbsp;</p>\r\n","url":"/2026/07/31/europa/video/quase-50-mil-migrantes-entraram-ceuta-24-horas-sanchez-fala-ataque-soberania-territorial-20260731-124110","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Vídeo","url":"/video-"},"id":98077,"type":"VIDEO","isMultipleRubric":false,"tag":null,"size":30},{"pos":28,"title":"<i>Soy Cuba</i>: este filme de 1964 poderia ter mudado a história do cinema?","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/canal_videos/videoPortal/Images/202607/soycuba98078.jpg?tp=VIDEOS","author":[{"id":885,"nome":"Vasco Câmara","descricao":"Foi depois de ter entrado pela casa que Gloria Swanson teve em Sintra, onde vi junto à piscina um animal empalhado, que me deixaram, aqui no PÚBLICO, meter as mãos no cinema. Isto foi no início deste projecto jornalístico. Eu fui um dos 25 estagiários admitidos depois de um curso de meses que começou com 500 candidatos de todo o país. Após a história da estrela dos anos 20 que vinha descansar perto da praia das Maçãs, alguém me disse: “Faça as malas, amanhã vai para Cannes”. E foi, no ano do fósforo a arder no ecrã gigante do Palais des Festivals, o ano de “Wild at Heart” de Lynch. Se não fossem os filmes não saberia o que estaria a fazer aqui – e isso é verdade para o bigger picture: sem os filmes não saberia o que fazer.","email":"vasco.camara@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"vasco-camara","imagem":{"w":null,"h":null,"largura":216,"altura":216,"nome":"vasco-camara-removebg-preview.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1747423?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":",Cannes","translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#97;&#109;&#97;&#99;&#46;&#111;&#99;&#115;&#97;&#118;","contribuicao":null,"tipo":"INTERNO"},{"id":633,"nome":"Alexandra Prado Coelho","descricao":"Quando entrei no PÚBLICO, em 1989, entre os estagiários que participaram na aventura da fundação do jornal, queria muito trabalhar na secção Internacional. O mundo estava a mudar, em Berlim o Muro caía, Saddam Hussein invadia o Kuwait , usávamos telex e nem sonhávamos com a Internet. Durante 15 anos viajei pelo Médio Oriente, Rússia, Europa, Afeganistão. Depois, foi tempo de mudar e passei para a Cultura, onde escrevi sobre cinema, teatro, arquitectura, design, literatura. Em 2011 passei a acompanhar a área da alimentação – dos produtores aos restaurantes, das novas tendências gastronómicas à saúde. Porque, se há tema que cruza todos os países, culturas e pessoas, é o da comida.","email":"apc@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"alexandra-prado-coelho","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Alexandra Prado Coelho z.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1526725?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#99;&#112;&#97;","contribuicao":null,"tipo":"INTERNO"},{"id":20485,"nome":"Gonçalo Taborda","descricao":"","email":"goncalo.taborda@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"Redes sociais","profissaoNaAltura":"Redes sociais","slug":"goncalo-taborda","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#100;&#114;&#111;&#98;&#97;&#116;&#46;&#111;&#108;&#97;&#99;&#110;&#111;&#103;","contribuicao":null,"tipo":"INTERNO"}],"shares":0,"description":"<p>Um filme para descobrir a 13 de Agosto, num programa de cl&aacute;ssicos que chega agora &agrave;s salas de cinema.</p>\r\n","url":"/2026/07/31/video/escuro-filme-cubano-1964-mudado-historia-cinema-20260731-155940","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Vídeo","url":"/video-"},"id":98078,"type":"VIDEO","isMultipleRubric":false,"tag":null,"size":30},{"pos":29,"title":"Centenas de pessoas chegam a nado a Ceuta e autarca pede estado de “emergência nacional”","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/canal_videos/videoPortal/Images/202607/ceuta98074.jpg?tp=VIDEOS","author":[{"id":973,"nome":"PÚBLICO","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":null,"profissaoActual":"","profissaoNaAltura":"","slug":"publico","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":null,"tipo":"EXTERNO"}],"shares":0,"description":"<p>O executivo da cidade aut&oacute;noma adianta que nos &uacute;ltimos dez dias chegaram mais de 1500 migrantes, muitos deles menores de idade.</p>\r\n","url":"/2026/07/30/mundo/video/centenas-pessoas-chegaram-ceuta-madrugada-cem-sao-menores-20260