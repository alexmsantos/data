[{"pos":0,"title":"Graça Carvalho: “Comprometemo-nos com 35% de electrificação, mas serão 35% limpos”","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2131902?tp=UH&db=IMAGENS&type=JPG","author":[{"id":6488,"nome":"Aline Flor","descricao":"Natural do Rio de Janeiro, vivo em Portugal há quase 30 anos. Criei raízes. Fui directora do Jornal Universitário do Porto, passei pela Ciência e Tecnologia no Canal Superior, editei notícias do portal AEIOU.pt. Fiz um mestrado em Cinema Documental que me abriu os olhos (e ouvidos) para a riqueza de cada encontro com o outro. Cheguei ao PÚBLICO para integrar a equipa de áudio, onde produzi podcasts em áreas desde a igualdade de género às questões europeias. Hoje sou jornalista do Azul, a nossa secção dedicada à crise climática e sustentabilidade, e aventurei-me num segundo mestrado: Economia e Gestão do Ambiente. Gosto de ouvir e de contar as histórias que ficam à margem e acredito que temos sempre algo a aprender quando encaramos o desafio de traduzir no preto e branco dos caracteres as infinitas tonalidades que nos rodeiam.","email":"aline.flor@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"em Antália, Turquia","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"aline-flor","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Aline Flor z.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1530339?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#114;&#111;&#108;&#102;&#46;&#101;&#110;&#105;&#108;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Portugal vai aderir à meta de electrificação da COP31, apesar de a meta não exigir energia limpa. A ministra defende que a transição justa dispensa um novo mecanismo de financiamento.","url":"/2026/11/18/azul/entrevista/graca-carvalho-comprometemonos-35de-electrificacao-serao-35-limpos-2195370","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Maria da Graça Carvalho","url":""},"id":2195370,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":1,"title":"O Baixo Alentejo visto por uma lente diferente","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2130320?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"<p class=\"xxxxxxxmsonormal\">Tr&ecirc;s dias de testes, mais de 500 imagens, um veredicto: sim, o mundo &eacute; melhor a cores, sobretudo quando elas o retratam com uma fidelidade impressionante.","url":"https://www.publico.pt/estudiop/conteudo_patrocinado/oppo-alentejo","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Conteúdo Comercial","url":"/estudiop_tecnologia"},"id":27351,"type":"EXTERNOS","isMultipleRubric":false,"tag":null,"size":30},{"pos":2,"title":"AD alerta para “coligações negativas” no OE2027, mas sai “mais descansada” pelo Chega","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2131806?tp=UH&db=IMAGENS&type=JPG","author":[{"id":15507,"nome":"Ana Bacelar Begonha","descricao":"","email":"ana.begonha@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"ana-bacelar-begonha","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#104;&#110;&#111;&#103;&#101;&#98;&#46;&#97;&#110;&#97;","contribuicao":"","tipo":"INTERNO"},{"id":19357,"nome":"Filipe Santa-Bárbara","descricao":"","email":"filipe.santabarbara@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"filipe-santabarbara","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#97;&#98;&#114;&#97;&#98;&#97;&#116;&#110;&#97;&#115;&#46;&#101;&#112;&#105;&#108;&#105;&#102;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"No arranque da especialidade, oposição concorda nas críticas ao Governo, mas aparentemente não se entende num caminho alternativo. Governo avisa que “equilíbrio” financeiro é “limite inultrapassável”.","url":"/2026/11/18/politica/noticia/ad-alerta-coligacoes-negativas-oe2027-sai-descansada-chega-2195395","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Orçamento do Estado 2027","url":"https://www.publico.pt/2026/11/18/politica/noticia/ad-alerta-coligacoes-negativas-oe2027-sai-descansada-chega-2195395"},"id":2195395,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":3,"title":"Aprovadas propostas para criar novo acelerador de carreiras na função pública\r\n\r\n","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2131881?tp=UH&db=IMAGENS&type=JPG","author":[{"id":3150,"nome":"Raquel Martins","descricao":"Aos 15 anos decidi que queria mudar o mundo e, para desgosto da minha professora de Português, quis ser jornalista. Fiz o curso de Ciências da Comunicação na Universidade Nova, frequentei o Cenjor e andei indecisa entre a rádio e a imprensa. Depois de uma breve passagem pela rádio (Antena 3 e Rádio Expo), acabei por entrar no jornalismo económico um pouco por acaso. Primeiro, no Diário Económico – onde escrevi sobre ambiente, autarquias, política e, mais tarde, sobre trabalho e função pública – depois no Jornal de Negócios. Foi por isso que, em 2009, fiz uma formação na Universidade Católica sobre legislação laboral. Estou no PÚBLICO desde 2010. Acompanho os assuntos relacionados com trabalho, emprego e administração pública (há quem diga, com humor, que o Código do Trabalho é o meu livro de cabeceira.) Defendo que o jornalismo tem um papel cada vez mais importante na descodificação da avalanche de informação que todos os dias circula nas mais diversas plataformas.","email":"raquel.martins@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"raquel-martins","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"raquel-martins-removebg-preview.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1991256?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":"Debi Thomas","translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#110;&#105;&#116;&#114;&#97;&#109;&#46;&#108;&#101;&#117;&#113;&#97;&#114;","contribuicao":"","tipo":"INTERNO"},{"id":90,"nome":"Lusa","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"lusa","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"","contribuicao":"","tipo":"AGENCIA"}],"shares":0,"description":"Propostas do PS e do BE alargam a todos os trabalhadores do Estado o descongelamento de carreiras nas mesmas condições em que foi aplicado aos professores.","url":"/2026/11/18/economia/noticia/aprovadas-propostas-criar-novo-acelerador-carreiras-funcao-publica-2195445","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Função Pública","url":"https://www.publico.pt/2026/11/18/economia/noticia/aprovadas-propostas-criar-novo-acelerador-carreiras-funcao-publica-2195445"},"id":2195445,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":4,"title":"“Queremos que o oceano deixe de ser uma nota de rodapé nas negociações do clima”","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2130457?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"Sérgio Carvalho, Director Adjunto para Assuntos Internacionais da Fundação Oceano Azul, defende que a COP31 deve dar maior peso político à protecção do mar.","url":"/2026/11/14/estudiop/noticia/queremos-oceano-deixe-nota-rodape-negociacoes-clima-2194733","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":{"id":0,"name":"Fundação Oceano Azul","ImageUrl":"https://imagens.publico.pt/imagens.aspx/2128021?tp=UH&db=IMAGENS","slug":null,"url":null},"rubric":{"name":"Conteúdo comercial","url":"https://www.publico.pt/2026/11/14/estudiop/noticia/queremos-oceano-deixe-nota-rodape-negociacoes-clima-2194733"},"id":2194733,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":5,"title":"Aprovada a suspensão da comissão de reembolso antecipado de créditos à habitação","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2131936?tp=UH&db=IMAGENS&type=JPG","author":[{"id":90,"nome":"Lusa","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"lusa","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"","contribuicao":"","tipo":"AGENCIA"}],"shares":0,"description":"Proposta do PS para garantir, de forma permanente, que quem amortiza o crédito à habitação não paga uma comissão pelo reembolso antecipado foi também aprovada.","url":"/2026/11/18/economia/noticia/aprovada-suspensao-comissao-reembolso-antecipado-creditos-habitacao-2195472","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Orçamento do Estado 2027","url":"https://www.publico.pt/2026/11/18/economia/noticia/aprovada-suspensao-comissao-reembolso-antecipado-creditos-habitacao-2195472"},"id":2195472,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":6,"title":"PS força conversão de eventual “bónus” nas pensões numa act