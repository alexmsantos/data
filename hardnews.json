/17/enter/noticia/leapmotor-prepara-automoveis-bateria-auxiliar-12-volts-2188420"},"id":2188420,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":12,"title":"Andebol: FC Porto vence Partizan e soma primeiros pontos na Champions","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2116691?tp=UH&db=IMAGENS&type=JPG","author":[{"id":973,"nome":"PÚBLICO","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"publico","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":"","tipo":"EXTERNO"}],"shares":0,"description":"“Dragões” foram superiores aos sérvios durante quase todo o encontro, já venciam ao intervalo e impuseram-se por uma margem de quatro golos.","url":"/2026/09/17/desporto/noticia/andebol-fc-porto-vence-partizan-soma-pontos-champions-2188451","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Andebol","url":"https://www.publico.pt/2026/09/17/desporto/noticia/andebol-fc-porto-vence-partizan-soma-pontos-champions-2188451"},"id":2188451,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":13,"title":"Benfica deixa fugir triunfo e o acesso à Liga dos Campeões de basquetebol","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2116693?tp=UH&db=IMAGENS&type=JPG","author":[{"id":973,"nome":"PÚBLICO","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"publico","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":"","tipo":"EXTERNO"}],"shares":0,"description":"“Encarnados” desbarataram vantagem de nove pontos últimos minutos e perderam com o Rasta Vechata na segunda pré-eliminatória. Agora, vão disputar a FIBA Europe Cup.","url":"/2026/09/17/desporto/noticia/benfica-deixa-fug