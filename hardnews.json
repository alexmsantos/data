tojornalismo da revista Visão e venci a categoria de fotografia de arquitectura do Euro Press Photo Awards da Fuji Film. Fui premiado no Prémio Estação Imagem|Mora em 2010 e 2011. Desde 1999, sou fotojornalista no PÚBLICO.","email":"ngarrido@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Fotojornalista","profissaoNaAltura":"","slug":"nelson-garrido","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Nelson_Garrido.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737874?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#100;&#105;&#114;&#114;&#97;&#103;&#110;","contribuicao":"fotografia","tipo":"INTERNO"}],"shares":0,"description":"Uma queda na casa de banho mudou a vida de um dos psicólogos mais conceituados do país. “As pessoas achavam que tinha perdido qualidades e passaram a falar-me muito devagarinho”, testemunha.","url":"/2026/08/16/impar/entrevista/eduardo-sa-sociedade-estase-borrifar-deficientes-nao-sao-pessoas-2184953","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":{"name":"impar"},"brand":null,"rubric":{"name":"Entrevista","url":"/p2-verao-2026"},"id":2184953,"type":"NOTICIA","isMultipleRubric":true,"tag":{"id":17749,"nome":"P2 Verão 2026","slug":"p2-verao-2026","tagEn":"","isPrincipal":false,"isVisible":true,"urlRoute":"/tp2-verao-2026","isPrincipalParaArtigo":true,"isTimeLine":false,"forcaConteudoAberto":false,"follow_type":null,"descricao":null,"imagem":null,"html":null,"isForForuns":false,"isUsedInForuns":false},"size":30},{"pos":3,"title":"Militares contra criação de uma bolsa de reservistas voluntários nas Forças Armadas\r\n","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2110025?tp=UH&db=IMAGENS&type=JPG","author":[{"id":18463,"nome":"Susete