s-2184242"},"id":2184242,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":23,"title":"Houve festa na aldeia de Cem Soldos: quatro dias a celebrar os 20 anos do Bons Sons","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2108786?tp=UH&db=IMAGENS&type=JPG","author":[{"id":12716,"nome":"Daniel Dias","descricao":"","email":"daniel.dias@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"daniel-dias","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#97;&#105;&#100;&#46;&#108;&#101;&#105;&#110;&#97;&#100;","contribuicao":"texto","tipo":"INTERNO"},{"id":3984,"nome":"Miguel Manso","descricao":"Nasci em Évora em 1978. Tinha dez anos quando me ofereceram a primeira máquina fotográfica. Aprendi a usá-la fotografando paisagens do Alentejo. Já em Lisboa, desisti do curso de Engenharia Civil para fazer o curso de Fotojornalismo no Cenjor. Estagiei no PÚBLICO, em 2006, trabalhei depois na Visão e no Metro. Regressei ao PÚBLICO há 11 anos. Alguns dos momentos que mais me marcaram neste percurso foram os trabalhos que fiz durante a Primavera Árabe, na Tunísia, as eleições na Grécia, em 2015, que deram a vitória a Alexis Tsipras, e a cobertura, durante algumas semanas, da guerra na Ucrânia, em 2022. Sou desde 2019 editor da secção de Fotografia.","email":"miguel.manso@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"EDITOR DE FOTOGRAFIA","profissaoNaAltura":"","slug":"miguel-manso","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#115;&#110;&#97;&#109;&#46;&#108;&#101;&#117;&#103;&#105;&#109;","contribuicao":"fotografia","tipo":"INTERNO"}],"shares":0,"description":"O fado dançado de Jonas e a música singular dos Cremalheira do Apocalipse protagonizaram alguns dos melhores momentos da 13.ª edição do festival inteiramente dedicado à música portuguesa.","url":"/2026/08/10/culturaipsilon/reportagem/festa-aldeia-cem-soldos-quatro-dias-celebrar-20-anos-bons-sons-2184673","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Reportagem","url":"/musica"},"id":2184673,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":24,"title":"Loco de Alexandre Silva vai fazer jantares a metade do preço para estudantes","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2108870?tp=UH&db=IMAGENS&type=JPG","author":[{"id":7010,"nome":"Fugas","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"fugas","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"A iniciativa está aberta todos os dias a estudantes de escolas públicas e privadas e não só da área de cozinha, mas também de pastelaria, restaurante/sala e hotelaria.","url":"/2026/08/11/fugas/noticia/loco-alexandre-silva-vai-jantares-metade-preco-estudantes-cozinha-2184711","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":{"name":"fugas"},"brand":null,"rubric":{"name":"Gastronomia","url":"https://www.publico.pt/2026/08/11/fugas/noticia/loco-alexandre-silva-vai-jantares-metade-preco-estudantes-cozinha-2184711"},"id":2184711,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":25,"title":"Em entrevista à <em>Esquire </em>Brad Pitt fala de álcool, suicídio e luto","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2108857?tp=UH&db=IMAGENS&type=JPG","author":[{"id":18338,"nome":"Rita Caetano","descricao":"","email":"rscaetano@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissa