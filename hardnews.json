"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":"texto","tipo":"EXTERNO"},{"id":3620,"nome":"Manuel Roberto","descricao":"","email":"manuel.roberto@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Fotojornalista","profissaoNaAltura":"","slug":"manuel-roberto","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Manuel Roberto.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1059727?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#116;&#114;&#101;&#98;&#111;&#114;&#46;&#108;&#101;&#117;&#110;&#97;&#109;","contribuicao":"fotografia","tipo":"INTERNO"}],"shares":0,"description":"Sem orientações comuns, mulheres com endometriose enfrentam dificuldades no acesso a tratamentos e apoio adequados. DGS admite atraso e garante que as normas estarão publicadas até ao final do ano.","url":"/2026/08/30/sociedade/noticia/nao-alta-ano-atraso-normas-endometriose-continuam-publicar-2184282","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Saúde","url":"https://www.publico.pt/2026/08/30/sociedade/noticia/nao-alta-ano-atraso-normas-endometriose-continuam-publicar-2184282"},"id":2184282,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":15,"title":"Joaquim, o pastor transumante, já levou os rebanhos de volta a Vila Nova de Tazem","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2112052?tp=UH&db=IMAGENS&type=JPG","author":[{"id":120,"nome":"Sandra Silva Costa","descricao":"Nunca fui bairrista mas também nunca fui de renegar as origens: nasci numa aldeia, Maceda, no concelho de Ovar, e lá vivi até aos 20 anos, mais coisa menos coisa. Nessa altura já estudava Jornalismo, na Universidade de Coimbra. Entrei para o PÚBLICO aos 22, tinha cabelos curtos e um mar de sonhos na cabeça. Vim estagiar, com experiência quase zero — mas justiça seja feita ao Jornal de Ovar, que me deu a primeira oportunidade, ainda nos tempos da faculdade. Estágio cumprido, integrei a secção de Educação, na altura uma editoria autónoma. Estávamos em 1998. Passei ainda pela Sociedade, como jornalista e como editora, até que, em 2008, assumi a edição da Fugas, onde fiquei até Dezembro de 2024. Em Janeiro de 2025, integrei a equipa do Local Porto.","email":"scosta@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"sandra-silva-costa","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"sc.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1091354?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#116;&#115;&#111;&#99;&#115;","contribuicao":"texto","tipo":"INTERNO"},{"id":3620,"nome":"Manuel Roberto","descricao":"","email":"manuel.roberto@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Fotojornalista","profissaoNaAltura":"","slug":"manuel-roberto","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Manuel Roberto.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1059727?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#116;&#114;&#101;&#98;&#111;&#114;&#46;&#108;&#101;&#117;&#110;&#97;&#109;","contribuicao":"fotografia","tipo":"INTERNO"}],"shares":0,"description":"Acompanhado de quase 500 ovelhas e cabras, Joaquim desceu dos altos da serra da Estrela a 23 de Agosto em direcção à vila do concelho de Gouveia. Há mais de 40 anos que sobe e desce com os animais.","url":"/2026/08/30/local/reportagem/pastagens-so-deus-apos-dois-meses-solidao-pastor-desceu-serra-2186195","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Reportagem","url":"/serra-da-estrela"},"id":2186195,"type":"NOTICIA","isMultipleRubric":true,"tag":{"id":1505,"nome":"Serra da Estrela","slug":"serra-da-estrela","tagEn":"","isPrincipal":false,"isVisible":true,"urlRoute":"/tserra-da-estrela","isPrincipalParaArtigo":true,"isTimeLine":false,"forcaConteudoAberto":false,"follow_type":null,"descricao":null,"imagem":null,"html":null,"isForForuns":false,"isUsedInForuns":false},"size":30},{"pos":16,"title":"Vinhos Madeira extraordinários, de uma riqueza que a ilha devia ostentar","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2111500?tp=UH&db=IMAGENS&type=JPG","author":[{"id":13993,"nome":"Ana Isabel Pereira","descricao":"Comecei o meu percurso profissional no extinto \"O Comércio do Porto\". A cidade é uma inquietação desde então. Desde antes, muito provavelmente. Passei por vários órgãos de comunicação social, como freelancer, trabalhei quase sempre sobre e a partir da cidade do Porto, fui co-fundadora de um jornal digital local, o Porto24. E nos últimos anos trabalhei em Multimédia e em gestão de projectos. Cheguei ao PÚBLICO no final de 2020 para lançar e ajudar a produzir um projecto de live streaming, o Ao Vivo. A cidade e as cidades em geral são constante motivo de reflexão, tentei contribuir para a sua problematização nas \"Conversas Urbanas\". Outro bichinho que trago de experiências anteriores são os vinhos, que agora volto a acompanhar na Fugas.","email":"ana.pereira@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"ana-isabel-pereira","imagem":{"w":null,"h":null,"largura":1059,"altura":1059,"nome":"AIP-junho2021-quadrado.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1597168?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#105;&#101;&#114;&#101;&#112;&#46;&#97;&#110;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"A Madeira Wine Company lançou recentemente nove ‘novos’ vinhos Madeira, das suas três marcas históricas, entre eles um fenomenal frasqueira de 1976 e um vinho inédito e raro de Terrantez.","url":"/2026/08/30/terroir/noticia/vinhos-madeira-extraordinarios-riqueza-ilha-ostentar-2185912","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":{"name":"fugas"},"brand":null,"rubric":{"name":"Crítica","url":"https://www.publico.pt/2026/08/30/terroir/noticia/vinhos-madeira-extraordinarios-riqueza-ilha-ostentar-2185912"},"id":2185912,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":17,"title":"Kalorama: Lauryn Hill, os filhos Marley, o avô deles e Wyclef Jean","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2112716?tp=UH&db=IMAGENS&type=JPG","author":[{"id":6858,"nome":"Rodrigo Nogueira","descricao":"","email":"rodrigo.nogueira@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"rodrigo-nogueira","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#105;&#101;&#117;&#103;&#111;&#110;&#46;&#111;&#103;&#105;&#114;&#100;&#111;&#114;","contribuicao":"texto","tipo":"INTERNO"},{"id":3976,"nome":"Nuno Ferreira Santos","descricao":"","email":"nuno.santos@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":""