rubric":{"name":"Conteúdo comercial","url":"https://www.publico.pt/2026/11/17/estudiop/noticia/domina-arte-preparar-bom-cafe-casa-2195106"},"id":2195106,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":2,"title":"Rendas: os cinco benefícios fiscais que os senhorios ainda têm ao seu dispor","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2132986?tp=UH&db=IMAGENS&type=JPG","author":[{"id":15415,"nome":"Rafaela Burd Relvas","descricao":"","email":"rafaela.relvas@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"rafaela-burd-relvas","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#97;&#118;&#108;&#101;&#114;&#46;&#97;&#108;&#101;&#97;&#102;&#97;&#114;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Apesar da revogação do imposto reduzido sobre rendas “moderadas”, proprietários beneficiam de uma série de outros descontos fiscais, que variam consoante o valor das rendas e a duração dos contratos.","url":"/2026/11/23/economia/noticia/desconto-rendas-moderadas-senhorios-cinco-beneficios-fiscais-dispor-2196020","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Habitação","url":"https://www.publico.pt/2026/11/23/economia/noticia/desconto-rendas-moderadas-senhorios-cinco-beneficios-fiscais-dispor-2196020"},"id":2196020,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":3,"title":"Aumento de pensões é “presente envenenado” e OE sai “pior” do Parlamento, diz Governo","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2132925?tp=UH&db=IMAGENS&type=JPG","author":[{"id":3898,"nome":"Liliana Borges","descricao":"","email":"liliana.borges@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"liliana-pascoal-borges","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"liliana-borges.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1172095?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#103;&#114;&#111;&#98;&#46;&#97;&#110;&#97;&#105;&#108;&#105;&#108;","contribuicao":"","tipo":"INTERNO"},{"id":157,"nome":"Maria Lopes","descricao":"Entrei para o PÚBLICO, vinda da universidade, quando se vivia a excitação das vésperas da primeira Exposição Mundial em Portugal. Calcorreei a Expo-98 de fio a pavio, de caderno, caneta e, por vezes, de Polaroid na mão. Esses poucos meses ensinaram-me a conjugar o verbo tão português “desenrascar-se”.\r\nNestes mais de 20 anos, passei depois pelas secções Local, Media (por duas vezes) e Economia. Estive no lançamento do suplemento Digital – que apesar do nome existiu apenas em papel – e pertenci à equipa do irreverente projecto Sexta, o jornal gratuito que o PÚBLICO partilhou com A Bola, em 2007 e 2008. Em simultâneo, durante dez anos, escrevi também para o Motores (da Fugas), vivendo os automóveis sob uma perspectiva menos técnica e mais prazenteira. Desde 2009 que integro a secção de Política e tento manter debaixo de olho o panorama dos media. \r\n\r\n","email":"maria.lopes@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"maria-lopes","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Maria_C_Lopes.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737865?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#112;&#111;&#108;&#46;&#97;&#105;&#114;&#97;&#109;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Executivo acentua a dramatização e acusa PS e Chega de colocarem em causa o equilíbrio das contas públicas com as alterações aprovadas na especialidade.","url":"/2026/11/23/politica/noticia/governo-chama-presente-envenenado-aumento-pensoes-oe-sai-pior-parlamento-2195975","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Orçamento do Estado 2027","url":"https://www.publico.pt/2026/11/23/politica/noticia/governo-chama-presente-envenenado-aumento-pensoes-oe-sai-pior-parlamento-2195975"},"id":2195975,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":4,"title":"Quatro dias para celebrar a Casa da Arquitetura","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2131494?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"Nono aniversário com programação gratuita entre 19 e 22 de Novembro.","url":"/2026/11/17/estudiop/noticia/quatro-dias-celebrar-casa-arquitetura-2195256","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":{"id":0,"name":"CASA DA ARQUITETURA","ImageUrl":"https://imagens.publico.pt/imagens.aspx/2099922?tp=UH&db=IMAGENS","slug":null,"url":null},"rubric":{"name":"Conteúdo comercial","url":"https://www.publico.pt/2026/11/17/estudiop/noticia/quatro-dias-celebrar-casa-arquitetura-2195256"},"id":2195256,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":5,"title":"Reviravolta na Nvidia: Jensen Huang regressa à presidência, acções disparam","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2132939?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1022,"nome":"Victor Ferreira","descricao":"Teria sido médico, se desse mais ouvidos aos meus pais, ou matemático ou bioquímico, se me tivesse aplicado a concluir os primeiros cursos superiores em que me matriculei. Porém, no Verão dos meus 18 anos, entrei pela primeira vez numa redacção. Era um jornal local, Guimarães, onde ainda hoje vive a minha família. Essa curta experiência, enquanto esperava pela universidade, mudou as minhas aspirações. Anos depois, pendurei um hipotético futuro de bata branca à volta de microscópios e abracei o sonho de transformar o mundo no meu laboratório. Porque o jornalismo é isso: um ensaio permanente. Desde 1999, já experimentei um pouco de tudo, do noticiário local ao desporto, fiz reportagem por todo o país, na Europa, em África, nos Estados Unidos. Tenho um MBA pela Porto Business School, com especialização em Comportamento Organizacional.","email":"voferreira@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"victor-ferreira","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Vitor Ferreira.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/2001908?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#105;&#101;&#114;&#114;&#101;&#102;&#111;&#118;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Fundador da Nvidia volta ao cargo de topo, de que saíra por causa de um escândalo amoroso envolvendo uma alegada espia chinesa. Investidores voltam a correr para as acções da empresa, que subiram 36%.","url":"/2026/11/23/economia/noticia/nvidia-reintegra-jensen-huang-presidente-ceo-apos-votacao-unanime-2195964","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Inteligência artificial","url":"https://www.publico.pt/2026/11/23/economia/noticia/nvidia-reintegra-jensen-huang-presidente-ceo-apos-votacao-unanime-2195964"},"id":2195964,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":6,"title":"Partidos não chamaram UTAO para avaliar medidas em que discordam do impacto\r\n","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2132998?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1053,"nome":"Sérgio Aníbal","descricao":"Sou jornalista desde 1998, tendo começado pouco tempo depois de ter concluído a minha licenciatura em economia no ISEG. Nesse ano, fiz um estágio não-remunerado de três meses no Semanário Económico, jornal onde acabei por ficar durante seis anos, como redactor, primeiro, e como editor da secção de Economia, no final. Passei depois pelo Jornal de Negócios e pelo Diário de Notícias, chegando finalmente ao PÚBLICO em 2006. Sempre a cobrir temas económicos. Nos últimos anos, a crise financeira internacional e a crise da dívida soberana europeia têm ocupado grande parte do meu tempo e atenção.","email":"sergio.anibal@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"sergio-anibal","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Sergio_Anibal.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737905?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#108;&#97;&#98;&#105;&#110;&#97;&#46;&#111;&#105;&#103;&#114;&#101;&#115;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Apesar da divergência superior a 1300 milhões de euros entre as contas do Governo e do PS para três medidas aprovadas no Parlamento, nenhum partido solicitou à unidade técnica uma avaliação.","url":"/2026/11/23/economia/noticia/partidos-nao-pediram-utao-avaliar-medidas-discordam-impacto-orcamental-2196029","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Orçamento do Estado 2027","url":"https://www.publico.pt/2026/11/23/economia/noticia/partidos-nao-pediram-utao-avaliar-medidas-discordam-impacto-orcamental-2196029"},"id":2196029,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":7,"title":"«Outlander» prossegue a viagem por uma América em revolução","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2131699?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"Na segunda metade da 7.ª temporada de «Outlander», Jamie, Claire e Ian voltam a Lallybroch, enquanto Roger e Buck procuram Jemmy no passado. Na América, há personagens com o futuro por resolver.","url":"/2026/11/18/estudiop/noticia/outlander-prossegue-viagem-america-revolucao-2195339","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":{"id":0,"name":"AXN","ImageUrl":"https://imagens.publico.pt/imagens.aspx/1953085?tp=UH&db=IMAGENS","slug":null,"url":null},"rubric":{"name":"Conteúdo comercial","url":"https://www.publico.pt/2026/11/18/estudiop/noticia/outlander-prossegue-viagem-america-revolucao-2195339"},"id":2195339,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":8,"title":"Passos diz que “crise está cá” e sugere que Parlamento pode escolher outro Governo","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2132992?tp=UH&db=IMAGENS&type=JPG","author":[{"id":90,"nome":"Lusa","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"lusa","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"","contribuicao":"","tipo":"AGENCIA"}],"shares":0,"description":"“O Parlamento não governa, mas pode escolher um Governo que governe de acordo com a sua vontade”, disse o antigo primeiro-ministro e presidente do PSD.","url":"/2026/11/23/politica/noticia/passos-crise-ca-sugere-parlamento-escolher-governo-2196025","comments":0,"spoon