":30},{"pos":5,"title":"“Não podia ter tido alta”: normas para a endometriose somam mais de um ano de atraso","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2108865?tp=UH&db=IMAGENS&type=JPG","author":[{"id":19963,"nome":"Catarina Pinho","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"jornalista estagiária","profissaoNaAltura":"Jornalista Estagiária","slug":"catarina-pinho","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":"texto","tipo":"EXTERNO"},{"id":3620,"nome":"Manuel Roberto","descricao":"","email":"manuel.roberto@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Fotojornalista","profissaoNaAltura":"","slug":"manuel-roberto","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Manuel Roberto.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1059727?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#116;&#114;&#101;&#98;&#111;&#114;&#46;&#108;&#101;&#117;&#110;&#97;&#109;","contribuicao":"fotografia","tipo":"INTERNO"}],"shares":0,"description":"Sem orientações comuns, mulheres com endometriose enfrentam dificuldades no acesso a tratamentos e apoio adequados. DGS admite atraso e garante que as normas estarão publicadas até ao final do ano.","url":"/2026/08/30/sociedade/noticia/nao-alta-ano-atraso-normas-endometriose-continuam-publicar-2184282","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Saúde","url":"https://www.publico.pt/2026/08/30/sociedade/noticia/nao-alta-ano-atraso-normas-endometriose-continuam-publicar-2184282"},"id":2184282,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":6,"title":"Tribunais prevêem “aumento exponencial” de processos depois de mudança nas leis","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2112684?tp=UH&db=IMAGENS&type=JPG","author":[{"id":455,"nome":"Joana Gorjão Henriques","descricao":"Entrei para o PÚBLICO no final de 1999, para estagiar na Cultura, onde fiquei durante dez anos. Entre fim de 2009 e de 2011 fiz uma pausa de dois anos, primeiro para ser bolseira da Nieman Foundation for Journalism na Universidade de Harvard, EUA; e depois para estudar Sociologia na London School of Economics, em Londres. Integro a secção de Sociedade, escrevendo sobre temas ligados a imigração, racismo, direitos humanos. Sou autora de 3 séries que deram livros: Racismo em português, sobre o racismo durante o sistema colonial, Racismo à Portuguesa, retrato de desigualdades raciais em Portugal e Colonos em Angola e Moçambique. Retornados em Portugal, que deu também origem ao documentário Racismo, uma descolonização em curso. Recebi a medalha de ouro de Direitos Humanos da Assembleia da República e alguns prémios: o Prémio Gazeta duas vezes, o Prémio AMI - Jornalismo contra a Indiferença por duas vezes, o prémio de Jornalismo de imprensa escrita de Direitos Humanos e Integração, da Comissão Nacional da UNESCO por duas vezes, o prémio de imprensa escrita Comunicação \"Pela Diversidade Cultural\" do Alto Comissariado para as Migrações, também por duas vezes, o prémio de jornalismo Corações com Coroa duas vezes, o prémio Os Direitos da Criança em Notícia.","email":"jgh@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"joana-gorjao-henriques","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#104;&#103;&#106;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Conselho Superior diz que mudanças nas leis “não podem continuar a ser aprovadas sem estudo de impacto nos tribunais”. Constitucional não apontou irregularidades a mudanças aprovadas pelo Parlamento.","url":"/2026/08/30/sociedade/noticia/tribunais-preveem-aumento-exponencial-processos-mudancas-lei-retorno-asilo-pedem-juizes-2186466","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Imigração","url":"https://www.publico.pt/2026/08/30/sociedade/noticia/tribunais-preveem-aumento-exponencial-processos-mudancas-lei-retorno-asilo-pedem-juizes-2186466"},"id":2186466,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":7,"title":"Jovem de 20 anos detido na Maia por suspeita de matar o padrasto","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2112749?tp=UH&db=IMAGENS&type=JPG","author":[{"id":90,"nome":"Lusa","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"lusa","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"","contribuicao":"","tipo":"AGENCIA"},{"id":973,"nome":"PÚBLICO","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"publico","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":"","tipo":"EXTERNO"}],"shares":0,"description":"Jovem tem uma queixa de violência doméstica, mas da companheira. Desferiu golpes com arma branca no padrasto. PSP deteve-o pelas 4h da manhã no centro do Porto.","url":"/2026/08/30/sociedade/noticia/jovem-20-anos-detido-maia-suspeita-matar-padrasto-2186508","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Crime","url":"https://www.publico.pt/2026/08/30/sociedade/noticia/jovem-20-anos-detido-maia-suspeita-matar-padrasto-2186508"},"id":2186508,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size"