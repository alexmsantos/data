aborda","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#100;&#114;&#111;&#98;&#97;&#116;&#46;&#111;&#108;&#97;&#99;&#110;&#111;&#103;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"A partir de 19 de Novembro, o roubo de automóveis e bancos, o uso de armas e o consumo de estupefacientes tornam-se na prática comum de muitas pessoas, mas tudo num mundo virtual.","url":"/2026/11/17/enter/reportagem/revolucionario-polemico-acido-grand-theft-auto-vi-promete-maiores-jogos-2195287","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":{"name":"p3"},"brand":null,"rubric":{"name":"Reportagem","url":"/videojogos"},"id":2195287,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":21,"title":"BCE vê “paralelo” entre a IA e as bolhas do <em>subprime </em>e das tecnológicas","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2131736?tp=UH&db=IMAGENS&type=JPG","author":[{"id":19360,"nome":"Diogo Cavaleiro","descricao":"Estagiei no PÚBLICO em 2009 no Local Lisboa, tendo no ano seguinte entrado no <em>Jornal de Negócios</em>, onde fiquei por quase nove anos. O sector bancário foi aquele em que me especializei, tendo publicado um livro – <em>Caixa Negra</em> – sobre décadas de gestão e polémica na Caixa Geral de Depósitos, em 2017. Em 2019, segui para o <em>Expresso</em>, continuando na mesma área, onde fiquei até Maio de 2025. Regresso agora ao PÚBLICO para continuar esse trabalho, integrando a secção de Economia. Licenciado em Ciências da Comunicação, tenho pós-graduações em Ciência Política – Relações Internacionais, na vertente de Estudos Europeus, e em Compliance.","email":"diogo.cavaleiro@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"diogo-cavaleiro","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Diogo Cavaleiro.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/2051033?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#114;&#105;&#101;&#108;&#97;&#118;&#97;&#99;&#46;&#111;&#103;&#111;&#105;&#100;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Estruturas opacas e financiamento circular são padrões detectados pelo Banco Central Europeu no mundo da inteligência artificial. Autoridade teme influência nos mercados accionistas e obrigacionistas.","url":"/2026/11/18/economia/noticia/bce-ve-paralelo-ia-bolhas-subprime-tecnologicas-2195354","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Inteligência artificial","url":"https://www.publico.pt/2026/11/18/economia/noticia/bce-ve-paralelo-ia-bolhas-subprime-tecnologicas-2195354"},"id":2195354,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":22,"title":"«Outlander» prossegue a viagem por uma América em revolução","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2131699?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"Na segunda metade da 7.ª temporada de «Outlander», Jamie, Claire e Ian voltam a Lallybroch, enquanto Roger e Buck procuram Jemmy no passado. Na América, há personagens com o futuro por resolver.","url":"/2026/11/18/estudiop/noticia/outlander-prossegue-viagem-america-revolucao-2195339","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":{"id":0,"name":"AXN","ImageUrl":"https://imagens.publico.pt/imagens.aspx/1953085?tp=UH&db=IMAGENS","slug":null,"url":null},"rubric":{"name":"Conteúdo comercial","url":"https://www.publico.pt/2026/11/18/estudiop/noticia/outlander-prossegue-viagem-america-revolucao-2195339"},"id":2195339,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size"