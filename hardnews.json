H&db=IMAGENS","slug":null,"url":null},"rubric":{"name":"Conteúdo comercial","url":"https://www.publico.pt/2026/07/23/estudiop/noticia/palco-ambicao-investimento-crescimento-2181595"},"id":2181595,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":2,"title":"A porta do gabinete que Ventura deixou aberta, a empregada e o deputado madrugador","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2105926?tp=UH&db=IMAGENS&type=JPG","author":[{"id":157,"nome":"Maria Lopes","descricao":"Entrei para o PÚBLICO, vinda da universidade, quando se vivia a excitação das vésperas da primeira Exposição Mundial em Portugal. Calcorreei a Expo-98 de fio a pavio, de caderno, caneta e, por vezes, de Polaroid na mão. Esses poucos meses ensinaram-me a conjugar o verbo tão português “desenrascar-se”.\r\nNestes mais de 20 anos, passei depois pelas secções Local, Media (por duas vezes) e Economia. Estive no lançamento do suplemento Digital – que apesar do nome existiu apenas em papel – e pertenci à equipa do irreverente projecto Sexta, o jornal gratuito que o PÚBLICO partilhou com A Bola, em 2007 e 2008. Em simultâneo, durante dez anos, escrevi também para o Motores (da Fugas), vivendo os automóveis sob uma perspectiva menos técnica e mais prazenteira. Desde 2009 que integro a secção de Política e tento manter debaixo de olho o panorama dos media. \r\n\r\n","email":"maria.lopes@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"maria-lopes","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Maria_C_Lopes.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737865?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#112;&#111;&#108;&#46;&#97;&#105;&#114;&#97;&#109;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Líder do Chega associa o vandalismo no seu gabinete ao facto de ter revelado que tinha “documentos relevantes” sobre Luís Neves. E diz que foi precisamente essa informação que desapareceu.","url":"/2026/07/28/politica/noticia/porta-ventura-deixou-aberta-empregada-deputado-madrugador-filme-gabinete-chega-2183285","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Chega","url":"https://www.publico.pt/2026/07/28/politica/noticia/porta-ventura-deixou-aberta-empregada-deputado-madrugador-filme-gabinete-chega-2183285"},"id":2183285,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":3,"title":"Quase meio milhão de chamadas para SNS 24 aguardaram 30 minutos para serem atendidas","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2105949?tp=UH&db=IMAGENS&type=JPG","author":[{"id":7050,"nome":"Ana Maia","descricao":"","email":"amaia@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"ana-maia","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#105;&#97;&#109;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Chamadas atendidas pela linha passaram de 2,57 milhões em 2024 para cerca de 4,09 milhões em 2025, graças ao alargamento do projecto que visa referenciar o acesso às urgências, refere estudo da ERS.","url":"/2026/07/29/sociedade/noticia/quase-meio-milhao-chamadas-sns-24-30-minutos-espera-serem-atendidas-2183312","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Saúde","url":"https://www.publico.pt/2026/07/29/sociedade/noticia/quase-meio-milhao-chamadas-sns-24-30-minutos-espera-serem-atendidas-2183312"},"id":2183312,"type":"NOTICIA","isMultipleRubric":fa