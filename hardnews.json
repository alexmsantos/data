[{"pos":0,"title":"Problema da habitação é “uma situação potencialmente explosiva”","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2123280?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1081,"nome":"Patrícia Carvalho","descricao":"Nasci no Porto, fiz a licenciatura em Ciências da Comunicação na Universidade Nova de Lisboa, entre 1993 e 1997, e estagiei no Jornal do Letras. Apesar da insistência de chefes e colegas para ficar pela capital, preferi voltar a casa e estive com a equipa que abriu o 24horas no Porto. Saí ao fim de um ano, para O Comércio do Porto, onde fiquei até ao seu encerramento, em 2005. Antes de ingressar no PÚBLICO, em 2008, colaborei com várias publicações, incluindo a Grande Reportagem, Visão, Notícias de Sábado e Sábado. No PÚBLICO, integro, desde a minha chegada, a equipa do Local Porto, mas fui sempre participando em outras áreas do jornal, com trabalhos para o P2 ou a Pública (que, entretanto, terminaram), a Fugas ou, mais recentemente, a revista 2.","email":"patricia.carvalho@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"patricia-carvalho","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Patricia Carvalho.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1381570?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#104;&#108;&#97;&#118;&#114;&#97;&#99;&#46;&#97;&#105;&#99;&#105;&#114;&#116;&#97;&#112;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Não é fácil prever como vai evoluir o protesto em curso no Porto, mas o problema da habitação não vai desaparecer mesmo que a <em>acampada </em>termine.","url":"/2026/10/15/sociedade/noticia/problema-habitacao-situacao-potencialmente-explosiva-ate-onde-irao-protestos-2191480","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Protesto","url":"https://www.publico.pt/2026/10/15/sociedade/noticia/problema-habitacao-situacao-potencialmente-explosiva-ate-onde-irao-protestos-2191480"},"id":2191480,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":1,"title":"O código da cura","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2121699?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"Um novo centro de investiga&ccedil;&atilde;o re&uacute;ne alguns dos maiores especialistas mundiais que est&atilde;o a explorar como o sistema imunit&aacute;rio pode contribuir para diagn&oacute;sticos mais precisos e terapias mais eficazes.","url":"https://www.publico.pt/estudiop/conteudo_patrocinado/codigo-cura","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Conteúdo Comercial","url":"/estudiop_saude_bem_estar"},"id":27321,"type":"EXTERNOS","isMultipleRubric":false,"tag":null,"size":30},{"pos":2,"title":"Supremo reduziu para oito anos e meio a pena de cadeia de Manuel Pinho","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2123151?tp=UH&db=IMAGENS&type=JPG","author":[{"id":963,"nome":"Ana Henriques","descricao":"","email":"ana.henriques@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"ana-henriques","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Ana_Henriques.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737742?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#117;&#113;&#105;&#114;&#110;&#101;&#104;&#46;&#97;&#110;&#97;","contribuicao":