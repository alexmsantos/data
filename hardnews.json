ico.pt/2026/07/29/mundo/noticia/narrativa-falsa-governo-ucraniano-torturou-matou-43-manifestantes-nao-ha-provas-2183341"},"id":2183341,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":21,"title":"Universidade de Aveiro: viver uma experiência que prepara para a profissão e o futuro","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2105694?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"Com cerca de 2500 vagas, 58 licenciaturas e duas novas licenciaturas, a UA combina uma formação sólida com experiência prática e uma ligação próxima às empresas e à sociedade.","url":"/2026/07/28/estudiop/noticia/universidade-aveiro-viver-experiencia-prepara-profissao-futuro-2183220","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":{"id":0,"name":"Universidade de Aveiro","ImageUrl":"https://imagens.publico.pt/imagens.aspx/2105099?tp=UH&db=IMAGENS","slug":null,"url":null},"rubric":{"name":"Conteúdo comercial","url":"https://www.publico.pt/2026/07/28/estudiop/noticia/universidade-aveiro-viver-experiencia-prepara-profissao-futuro-2183220"},"id":2183220,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":22,"title":"Director que prendeu funcionária com fita cola à cadeira já não trabalha no hospital","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2105951?tp=UH&db=IMAGENS&type=JPG","author":[{"id":18319,"nome":"Gina Pereira","descricao":"","email":"gina.pereira@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Editora de Sociedade","profissaoNaAltura":"","slug":"gina-pereira","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#105;&#101;&#114;&#101;&#112;&#46;&#97;&#110;&#105;&#103;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Caso ocorreu em meados de Maio e foi denunciado pela Ordem dos Enfermeiros à IGAS, que instaurou um processo de esclarecimento. ULS Lisboa Ocidental não esclarece desfecho do processo disciplinar.","url":"/2026/07/29/sociedade/noticia/director-recursos-humanos-prendeu-funcionaria-fita-cola-cadeira-ja-nao-trabalha-hospital-2183314","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Assédio laboral","url":"https://www.publico.pt/2026/07/29/sociedade/noticia/director-recursos-humanos-prendeu-funcionaria-fita-cola-cadeira-ja-nao-trabalha-hospital-2183314"},"id":2183314,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":23,"title":"A porta do gabinete que Ventura deixou aberta, a empregada e o deputado madrugador","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2105926?tp=UH&db=IMAGENS&type=JPG","author":[{"id":157,"nome":"Maria Lopes","descricao":"Entrei para o PÚBLICO, vinda da universidade, quando se vivia a excitação das vésperas da primeira Exposição Mundial em Portugal. Calcorreei a Expo-98 de fio a pavio, de caderno, caneta e, por vezes, de Polaroid na mão. Esses poucos meses ensinaram-me a conjugar o verbo tão português “desenrascar-se”.\r\nNestes mais de 20 anos, passei depois pelas secções Local, Media (por duas vezes) e Economia. Estive no lançamento do suplemento Digital – que apesar do nome existiu apenas em papel – e pertenci à equipa do irreverente projecto Sexta, o jornal gratuito que o PÚBLICO partilhou com A Bola, em 2007 e 2008. Em simultâneo, durante dez anos, escrevi também para o Motores (da Fugas), vivendo os automóveis sob uma perspectiva menos técnica e mais prazenteira. Desde 2009 que integro a secção de Política e tento manter debaixo de olho o panorama dos media. \r\n\r\n","email":"maria.lopes@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"maria-lopes","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Maria_C_Lopes.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737865?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#112;&#111;&#108;&#46;&#97;&#105;&#114;&#97;&#109;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Líder do Chega associa o vandalismo no seu gabinete ao facto de ter revelado que tinha “documentos relevantes” sobre Luís Neves. E diz que foi precisamente essa informação que desapareceu.","url":"/2026/07/28/politica/noticia/porta-ventura-deixou-aberta-empregada-deputado-madrugador-filme-gabinete-chega-2183285","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Chega","url":"https://www.publico.pt/2026/07/28/politica/noticia/porta-ventura-deixou-aberta-empregada-deputado-madrugador-filme-gabinete-chega-2183285"},"id":2183285,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":24,"title":"Mil dias de baixa chegam para um doente oncológico? Petição pede fim do limite","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2106029?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1081,"nome":"Patrícia Carvalho","descricao":"Nasci no Porto, fiz a licenciatura em Ciências da Comunicação na Universidade Nova de Lisboa, entre 1993 e 1997, e estagiei no Jornal do Letras. Apesar da insistência de chefes e colegas para ficar pela capital, preferi voltar a casa e estive com a equipa que abriu o 24horas no Porto. Saí ao fim de um ano, para O Comércio do Porto, onde fiquei até ao seu encerramento, em 2005. Antes de ingressar no PÚBLICO, em 2008, colaborei com várias publicações, incluindo a Grande Reportagem, Visão, Notícias de Sábado e Sábado. No PÚBLICO, integro, desde a minha chegada, a equipa do Local Porto, mas fui sempre participando em outras áreas do jornal, com trabalhos para o P2 ou a Pública (que, entretanto, terminaram), a Fugas ou, mais recentemente, a revista 2.","email":"patricia.carvalho@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"patricia-carvalho","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Patricia Carvalho.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1381570?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#104;&#108;&#97;&#118;&#114;&#97;&#99;&#46;&#97;&#105;&#99;&#105;&#114;&#116;&#97;&#112;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Peticionários querem que seja criada uma excepção para os doentes oncológicos, idêntica à que existe para a tuberculose, em que os limites não se aplicam.","url":"/2026/07/29/sociedade/noticia/peticao-pede-fim-limite-dias-baixo-doentes-oncologicos-2183355","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Cancro","url":"https://www.publico.pt/2026/07/29/sociedade/noticia/peticao-pede-fim-limite-dias-baixo-doentes-oncologicos-2183355"},"id":2183355,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":25,"title":"Trump aperta cerco aos imigrantes: entre greves de fome e acesso à universidade","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2105891?tp=UH&db=IMAGENS&type=JPG","author":[{"id":19691,"nome":"Manuel Monteiro","descricao":"","email":"Manuel.Monteiro@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"manuelc-monteiro","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#6