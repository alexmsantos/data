[{"pos":0,"title":"Sete partidos querem concursos para administrações hospitalares. AD rejeita mudanças","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2131245?tp=UH&db=IMAGENS&type=JPG","author":[{"id":3898,"nome":"Liliana Borges","descricao":"","email":"liliana.borges@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"liliana-pascoal-borges","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"liliana-borges.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1172095?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#103;&#114;&#111;&#98;&#46;&#97;&#110;&#97;&#105;&#108;&#105;&#108;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Da defesa de concursos públicos à eleição pelos profissionais, passando pela profissionalização da gestão, os partidos têm propostas diferentes para escolher os responsáveis pelos hospitais do SNS.","url":"/2026/11/16/politica/noticia/sete-partidos-querem-concursos-administracoes-hospitalares-ad-rejeita-mudancas-2195111","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Saúde","url":"https://www.publico.pt/2026/11/16/politica/noticia/sete-partidos-querem-concursos-administracoes-hospitalares-ad-rejeita-mudancas-2195111"},"id":2195111,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":1,"title":"<em>DOC</em>: quando salvar vidas é mais do que uma questão de números","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2130335?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"Na 4.ª temporada de «DOC», Andrea regressa a um hospital transformado pela crise e onde a pressão ameaça o pilar da medicina: cuidar de cada doente com humanidade. Estreia a 11 de Novembro no AXN.","url":"/2026/11/10/estudiop/noticia/doc-salvar-vidas-questao-numeros-2192399","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":{"id":0,"name":"AXN","ImageUrl":"https://imagens.publico.pt/imagens.aspx/1953085?tp=UH&db=IMAGENS","slug":null,"url":null},"rubric":{"name":"Conteúdo comercial","url":"https://www.publico.pt/2026/11/10/estudiop/noticia/doc-salvar-vidas-questao-numeros-2192399"},"id":2192399,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":2,"title":"Lídia Pereira: “Tecnologias limpas podem blindar a Europa de choques externos”","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2130372?tp=UH&db=IMAGENS&type=JPG","author":[{"id":6488,"nome":"Aline Flor","descricao":"Natural do Rio de Janeiro, vivo em Portugal há quase 30 anos. Criei raízes. Fui directora do Jornal Universitário do Porto, passei pela Ciência e Tecnologia no Canal Superior, editei notícias do portal AEIOU.pt. Fiz um mestrado em Cinema Documental que me abriu os olhos (e ouvidos) para a riqueza de cada encontro com o outro. Cheguei ao PÚBLICO para integrar a equipa de áudio, onde produzi podcasts em áreas desde a igualdade de género às questões europeias. Hoje sou jornalista do Azul, a nossa secção dedicada à crise climática e sustentabilidade, e aventurei-me num segundo mestrado: Economia e Gestão do Ambiente. Gosto de ouvir e de contar as histórias que ficam à margem e acredito que temos sempre algo a aprender quando encaramos o desafio de traduzir no preto e branco dos caracteres as infinitas tonalidades que nos rodeiam.","email":"aline.flor@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"aline-flor","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Aline Flor z.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1530339?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#114;&#111;&#108;&#102;&#46;&#101;&#110;&#105;&#108;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Lídia Pereira, que chefia a delegação do Parlamento Europeu na COP31, quer menos promessas e mais implementação. E vê na meta turca de electrificação “um princípio de conversa”.","url":"/2026/11/16/azul/noticia/lidia-pereira-tecnologias-limpas-podem-blindar-europa-choques-externos-2194699","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"COP31","url":"https://www.publico.pt/2026/11/16/azul/noticia/lidia-pereira-tecnologias-limpas-podem-blindar-europa-choques-externos-2194699"},"id":2194699,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":3,"title":"Ex-presidente da ULS de Aveiro fica em prisão preventiva indiciado por oito crimes","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2131294?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1050,"nome":"Mariana Oliveira","descricao":"Nasci no Porto em 1978 e fiz a licenciatura em Direito na Faculdade de Direito da Universidade do Porto. Quando optei por este curso, já tinha a intenção de me tornar jornalista, seguindo o conselho de alguns profissionais da classe. Depois de terminar a licenciatura, candidatei-me à Formação Geral – Especialização em Jornalismo no Centro Protocolar de Formação Profissional para Jornalistas (Cenjor), em Lisboa. Por isso vivi na capital quase oito meses, entre Dezembro de 2001 e Julho de 2002. Nesse mês, decidi regressar ao Porto para fazer o estágio integrado nessa formação. Fui jornalista estagiária no PÚBLICO entre Julho e Outubro e comecei a trabalhar em Fevereiro de 2003. No início, cobri mais intensivamente áreas ligadas à protecção civil. Actualmente, dedico-me à área da Justiça.","email":"meoliveira@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"mariana-oliveira","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#105;&#101;&#118;&#105;&#108;&#111;&#101;&#109;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Dois empresários, que foram detidos ao mesmo tempo, ficam sujeitos a uma caução de 25 mil euros, cada um, e proibidos de contactar restantes arguidos e funcionários da Ordem dos Enfermeiros.","url":"/2026/11/16/sociedade/noticia/expresidente-uls-aveiro-fica-prisao-preventiva-2195139","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Justiça","url":"https://www.publico.pt/2026/11/16/sociedade/noticia/expresidente-uls-aveiro-fica-prisao-preventiva-2195139"},"id":2195139,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":4,"title":"Congresso GRACE: “Reportar não é o mesmo que transformar”","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2129809?tp=UH&db=IMAGENS&type=JPG","author":[],"shares":0,"description":"O 2.º Congresso GRACE de Sustentabilidade realiza-se a 24 de Novembro, em Lisboa, e quer desafiar as empresas a olhar para lá das metas e dos compromissos.","url":"/2026/11/11/estudiop/noticia/congresso-grace-reportar-nao-transformar-2194453","comments":0,"spoonsored":true,"isOpinion":false,"homeBrand":null,"brand":{"id":0,"name":"Grace","ImageUrl":"https://imagens.publico.pt/imagens.aspx/2129732?tp=UH&db=IMAGENS","slug":null,"url":null},"rubric":{"name":"Conteúdo comercial","url":"https://www.publico.pt/2026/11/11/estudiop/noticia/congresso-grace-reportar-nao-transformar-2194453"},"id":2194453,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":5,"title":"Aluna de 13 anos agredida por colegas de 14 e 15, PSP está a acompanhar o caso","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2131325?tp=UH&db=IMAGENS&type=JPG","author":[{"id":495,"nome":"Andreia Sanches","descricao":"Entrei no PÚBLICO em 1996. Tinha 22 anos, terminado o curso de Ciências da Comunicação na Universidade Nova de Lisboa e estava no jornal onde queria, de facto, começar a fazer jornalismo. Estagiei no Internacional, quando ainda fazíamos fila para aceder ao computador da redacção que estava ligado à Internet. Seguiu-se a Educação, onde fiquei vários anos, quando aquela era uma secção autónoma, diária. Já na Sociedade, o leque de temas sobre os quais passei a escrever alargou-se – a pobreza e as desigualdades, a exclusão e as políticas de protecção social são alguns dos que tenho acompanhado de forma mais sistemática. Em 2013 foi publicado o meu primeiro livro. Chama-se \"Os Anjos Não Comem Chocolate\" e tem como ponto de partida uma reportagem que fiz no PÚBLICO sobre pais que perderam os seus filhos. Ao longo dos últimos anos desempenhei funções de editora do P2, editora da Sociedade, editora-executiva e directora-adjunta.","email":"asanches@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Redactora principal","profissaoNaAltura":"","slug":"andreia-sanches","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"andreia-sanches-nova.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1748990?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":"Andreia C. Faria","translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#104;&#99;&#110;&#97;&#115;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Vítima já regressou às aulas. PSP também voltou à escola “para outras diligências policiais”. Associação de pais diz que escola não é violenta, ma