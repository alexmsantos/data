ar as histórias que ficam à margem e acredito que temos sempre algo a aprender quando encaramos o desafio de traduzir no preto e branco dos caracteres as infinitas tonalidades que nos rodeiam.","email":"aline.flor@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"aline-flor","imagem":{"w":225,"h":225,"largura":225,"altura":225,"nome":"Aline Flor z.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1530339?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#114;&#111;&#108;&#102;&#46;&#101;&#110;&#105;&#108;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Um terço de Portugal já está degradado, mas país chega à COP17 da Desertificação com o combate parado. Hoje tem início a COP17 da Desertificação, na Mongólia.","url":"/2026/08/16/azul/noticia/desertificacao-portugal-nao-mora-so-alentejo-2185071","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Desertificação","url":"https://www.publico.pt/2026/08/16/azul/noticia/desertificacao-portugal-nao-mora-so-alentejo-2185071"},"id":2185071,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":5,"title":"Incêndios: reactivação em Torre de Moncorvo exigiu reforço de meios","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2110075?tp=UH&db=IMAGENS&type=JPG","author":[{"id":15939,"nome":"Fernando Costa","descricao":"","email":"fernando.costa@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"fernando-costa","imagem":{"w":225,"h":225,"largura":225,"altura":225,"nome":"fernando costa.png","legenda":null,"autor":null,"tipo":"PNG"