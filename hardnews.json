&db=IMAGENS&type=JPG","author":[{"id":18051,"nome":"Paula Sofia Luz","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"paula-sofia-luz","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Paula Sofia Luz.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/2062595?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Passaram-se seis meses desde a tempestade <em>Kristin</em> e apenas um dos casos que o PÚBLICO denunciou em Fevereiro tem a casa remediada. Pelo meio, há empreiteiros que se aproveitam.","url":"/2026/07/28/sociedade/noticia/filhos-estado-menor-meio-ano-casas-reparar-2183205","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Reportagem","url":"https://www.publico.pt/2026/07/28/sociedade/noticia/filhos-estado-menor-meio-ano-casas-reparar-2183205"},"id":2183205,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":18,"title":"Arruda dos Vinhos teve prejuízos de mais de 20 milhões, mas ainda só recebeu 580 mil","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2105758?tp=UH&db=IMAGENS&type=JPG","author":[{"id":161,"nome":"Jorge Talixa","descricao":"","email":"jorgetalixa@gmail.com","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"jorge-talixa","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#109;&#111;&#99;&#46;&#108;&#105;&#97;&#109;&#103;&#64;&#97;&#120;&#105;&#108;&#97;&#116;&#101;&#103;&#114;&#111;&#106;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Câmara considera que o Governo “está a falhar” no apoio aos municípios mais afectados pelas tempestades e contraiu empréstimo de 3,8 milhões para tentar fazer obras antes do próximo Inverno.","url":"/2026/07/28/local/noticia/arruda-vinhos-prejuizos-20-milhoes-so-recebeu-580-mil-2183261","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Arruda dos Vinhos","url":"https://www.publico.pt/2026/07/28/local/noticia/arruda-vinhos-prejuizos-20-milhoes-so-recebeu-580-mil-2183261"},"id":2183261,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":19,"title":"Gastos de 5,8 mil milhões na defesa sem fiscalização garantida do TdC e da PGR","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2105541?tp=UH&db=IMAGENS&type=JPG","author":[{"id":3520,"nome":"David Santiago","descricao":"","email":"david.santiago@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Editor de Política","profissaoNaAltura":"Editor de Política","slug":"david-santiago","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"David Santiago.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1765612?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#103;&#97;&#105;&#116;&#110;&#97;&#115;&#46;&#100;&#105;&#118;&#97;&#100;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Nuno Melo anunciou que Tribunal de Contas e Procuradoria-Geral da República integrariam entidade de fiscalização dos investimentos do SAFE, contudo, só o farão, se assim entenderem, informalmente.","url":"/2026/07/28/politica/noticia/investimento-58-mil-milhoes-defesa-fiscalizacao-garantida-tdc-pgr-2182822","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Defesa","url":"https://www.publico.pt/2026/07/28/politica/noticia/investimento-58-mil-milhoes-defesa-fiscalizacao-garantida-tdc-pgr-2182822"},"id":2182822,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":20,"title":"Mar profundo: adiada a participação das empresas mineiras na tomada de decisões","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2105653?tp=UH&db=IMAGENS&type=JPG","author":[{"id":227,"nome":"Clara Barata","descricao":"Gosto de compreender como funciona o mundo. Numa célula, de me espantar como uma máquina biológica esconde a centelha que a transforma numa coisa viva. Nas manobras de bastidores de uma campanha de um político que quer ser eleito Presidente da República, descobre-se um homem e uma teia de interesses tão mais vasta que ele e muito mais que isso: as aspirações, os traumas, os preconceitos e a cultura de um povo que pode ser muito diferente do nosso. Os meus interesses são variados, da ciência à política internacional, ambiente ou tendências sociais, na Europa, nos EUA. Um ponto comum entre eles é sempre a vontade de querer saber como funcionam as coisas — e aplicar uma atitude que aprendi a assumir fazendo jornalismo de ciência, que é não ter medo de fazer perguntas, mesmo que pareçam básicas.","email":"clara.barata@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"clara-barata","imagem":{"w":null,"h":null,"largura":368,"altura":331,"nome":"_RG__foto_Clara_Barata_DSCF4152-removebg-preview.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1926383?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#116;&#97;&#114;&#97;&#98;&#46;&#97;&#114;&#97;&#108;&#99;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Assembleia da ISA deverá decidir ainda nesta semana sobre estatuto de observador das empresas que querem explorar fundos marinhos. Greenpeace preocupada com Investidas legais das empresas","url":"/2026/07/28/azul/noticia/mar-profundo-adiada-participacao-empresas-mineiras-tomada-decisoes-2183196","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Mar profundo","url":"https://www.publico.pt/2026/07/28/azul/noticia/mar-profundo-adiada-participacao-empresas-mineiras-tomada-decisoes-2183196"},"id":2183196,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":21,"title":"Taxa de sucesso de 97%: em dez anos 22 mil doentes com hepatite C estão curados","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2105715?tp=UH&db=IMAGENS&type=JPG","author":[{"id":7050,"nome":"Ana Maia","descricao":"","email":"amaia@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"ana-maia","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#105;&#97;&#109;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Entre 2015 e 2025, refere o relatório da DGS, foram iniciados mais de 33 mil tratamentos com medicamentos antivíricos inovadores, cuja taxa de cura ronda os 97%.","url":"/2026/07/28/sociedade/noticia/taxa-sucesso-97-decada-22-mil-doentes-hepatite-c-ficaram-curados-2183193","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Saúde","url":"https://www.publico.pt/2026/07/28/sociedade/noticia/taxa-sucesso-97-decada-22-mil-doentes-hepatite-c-ficaram-curados-2183193"},"id":2183193,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":22,"title":"Zero teme que Plano de Restauro repita erros da Rede Natura 2000","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2105636?tp=UH&db=IMAGENS&type=JPG","author":[{"id":177,"nome":"Andréia Azevedo Soares","descricao":"Nasci no Rio de Janeiro, onde estudei jornalismo na Universidade Federal. Mudei-me para Portugal em 1999. Trabalho no PÚBLICO desde 2000, com duas interrupções – uma para um doutoramento em Comunicação de Ciência no Imperial College, em Londres, e outra para colaborar com a revista científica WHO Bulletin, em Genebra. Já fui estagiária, colaboradora, repórter e sub-editora em diferentes secções deste jornal. A ciência e a literatura são as áreas sobre as quais mais gosto de escrever; fascina-me o modo como o escritor e o cientista se empenham para detalhar e compreender o mundo que nos rodeia, incluindo os seres vivos que nele habitam.\r\n\r\n\r\n\r\n","email":"aasoares@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"andreia-azevedo-soares","imagem":{"w":null,"h":null,"largura":501,"altura":498,"nome":"andreia_soares-removebg-preview.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1725026?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#114;&#97;&#111;&#115;&#97;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Nos 50 anos do Parque Natural da Arrábida, associação ambientalista pede medidas concretas para garantir o sucesso do Plano Nacional de Restauro da Natureza. \r\n","url":"/2026/07/28/azul/noticia/zero-teme-plano-restauro-repita-erros-rede-natura-2000-2183195","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Conservação da natureza","url":"https://www.publico.pt/2026/07/28/azul/noticia/zero-teme-plano-restauro-repita-erros-rede-natura-2000-2183195"},"id":2183195,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":23,"title":"Fontanários de origem única sem água potável passam a exigir alternativa a 200 metros","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2105575?tp=UH&db=IMAGENS&type=JPG","author":[{"id":6488,"nome":"Aline Flor","descricao":"Natural do Rio de Janeiro, vivo em Portugal há quase 30 anos. Criei raízes. Fui directora do Jornal Universitário do Porto, passei pela Ciência e Tecnologia no Canal Superior, editei notícias do portal AEIOU.pt. Fiz um mestrado em Cinema Documental que me abriu os olhos (e ouvidos) para a riqueza de cada encontro com o outro. Cheguei ao PÚBLICO para integrar a equipa de áudio, onde produzi podcasts em áreas desde a igualdade de género às questões europeias. Hoje sou editora do Azul, a nossa secção dedicada à crise climática e sustentabilidade, e aventurei-me num segundo mestrado: Economia e Gestão do Ambiente. Gosto de ouvir e de contar as histórias que ficam à margem e acredito que temos sempre algo a aprender quando encaramos o desafio de traduzir no preto e branco dos caracteres as infinitas tonalidades que nos rodeiam.","email":"aline.flor@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"aline-flor","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Aline Flor z.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1530339?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#114;&#111;&#108;&#102;&#46;&#101;&#110;&#105;&#108;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Portugal tem 172 fontanários que são única forma de abastecimento público. Nova lei da água para consumo aperta regras e impõe prazos rigorosos às entidades.","url":"/2026/07/