"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Subeditora de Economia","profissaoNaAltura":"","slug":"isabel-aveiro","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Isabel  Aveiro.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1139753?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#114;&#105;&#101;&#118;&#97;&#46;&#108;&#101;&#98;&#97;&#115;&#105;","contribuicao":"","tipo":"INTERNO"},{"id":1053,"nome":"Sérgio Aníbal","descricao":"Sou jornalista desde 1998, tendo começado pouco tempo depois de ter concluído a minha licenciatura em economia no ISEG. Nesse ano, fiz um estágio não-remunerado de três meses no Semanário Económico, jornal onde acabei por ficar durante seis anos, como redactor, primeiro, e como editor da secção de Economia, no final. Passei depois pelo Jornal de Negócios e pelo Diário de Notícias, chegando finalmente ao PÚBLICO em 2006. Sempre a cobrir temas económicos. Nos últimos anos, a crise financeira internacional e a crise da dívida soberana europeia têm ocupado grande parte do meu tempo e atenção.","email":"sergio.anibal@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"sergio-anibal","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Sergio_Anibal.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737905?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#108;&#97;&#98;&#105;&#110;&#97;&#46;&#111;&#105;&#103;&#114;&#101;&#115;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Pontegadea Inversiones, divisão de investimento do universo empresarial do milionário espanhol Amancio Ortega, era o segundo maior accionista da REN, que gere a rede eléctrica portuguesa.","url":"/2026/08/14/economia/noticia/estado-volta-ren-compra-137-dono-zara-2185087","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Energia","url":"https://www.publico.pt/2026/08/14/economia/noticia/estado-volta-ren-compra-137-dono-zara-2185087"},"id":2185087,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":4,"title":"Morte de ciclista britânico na Volta a Portugal leva à suspensão da etapa","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2109821?tp=UH&db=IMAGENS&type=JPG","author":[{"id":973,"nome":"PÚBLICO","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"publico","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":"","tipo":"EXTERNO"}],"shares":0,"description":"Corredor da equipa NSN chocou com um carro que circulava em contramão, perto de Ponte de Lima, no dia em que se cumpria a 8.ª etapa da corrida.","url":"/2026/08/14/desporto/noticia/morte-ciclista-plena-etapa-forca-suspensao-volta-portugal-2185059","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Ciclismo","url":"https://www.publico.pt/2026/08/14/desporto/noticia/morte-ciclista-plena-etapa-forca-suspensao-volta-portugal-2185059"},"id":2185059,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":5,"title":"Jason Arday, ex-professor de Cambridge acusado de plágio, encontrado morto em casa","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2109864?tp=UH&db=IMAGENS&type=JPG","author":[{"id":14261,"nome":"Carolina Amado","descricao":"","email":"carolina.amado@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"carolina-amado","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#100;&#97;&#109;&#97;&#46;&#97;&#110;&#105;&#108;&#111;&#114;&#97;&#99;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"No início do mês, Jason Arday, conhecido por ser o homem negro mais jovem de sempre a tornar-se professor em Cambridge, tinha denunciado anos de um “implacável escrutínio público”.","url":"/2026/08/15/mundo/noticia/jason-arday-exprofessor-cambridge-acusado-plagio-encontrado-morto-casa-2185104","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Óbito","url":"https://www.publico.pt/2026/08/15/mundo/noticia/jason-arday-exprofessor-cambridge-acusado-plagio-encontrado-morto-casa-2185104"},"id":2185104,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":6,"title":"Vitória SC corajoso deixa em pânico um Sporting eficaz","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2109851?tp=UH&db=IMAGENS&type=JPG","author":[{"id":1059,"nome":"Nuno Sousa","descricao":"Primeiro, foi a informação local. Em Aveiro, durante um ano (o de 2003), ajudei a levantar um dos quatro cadernos regionais que o PÚBLICO chegou a oferecer aos leitores, antes de me tornar editor do entretanto extinto Local Centro. A viagem para norte foi relativamente rápida e, em 2005, assumi a editoria do Local Porto, da qual me despediria no final de 2007, para ocupar o cargo que actualmente desempenho, na chefia da secção de Desporto. Desde então, tenho olhado para a actualidade desportiva com a avidez e o interesse do dia de estreia. E acompanhado o relançamento do site de Desporto, a criação de canais dedicados (Jogos Olímpicos, Europeu, Mundial de futebol) e a edição de suplementos em papel com a mesma lupa que uso para aperfeiçoar o jornal que todos os dias sai para as bancas.","email":"nsousa@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Editor de Desporto","profissaoNaAltura":"","slug":"nuno-sousa","imagem":{"w":225,"h":225,"largura":225,"altura":225,"nome":"nsousa.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1951120?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":",Liga Europa da UEFA","translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#115;&#117;&#111;&#115;&#110;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"“Leões” venciam por 3-0 aos 65 minutos, mas foram suplantados pelo adversário na segunda parte e terminaram o jogo a defender vantagem mínima com unhas e dentes.","url":"/2026/08/14/desporto/cronica_de_jogo/vitoria-sc-corajoso-deixa-panico-sporting-eficaz-2185094","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Crónica de jogo","url":"/futebol-nacional"},"id":2185094,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30}]
