a de os ouvirem.","url":"/2026/11/19/sociedade/noticia/crises-sucessivas-geracao-preparada-exige-lugar-mesa-decisoes-2195126","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"População","url":"https://www.publico.pt/2026/11/19/sociedade/noticia/crises-sucessivas-geracao-preparada-exige-lugar-mesa-decisoes-2195126"},"id":2195126,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":15,"title":"Saúde: recurso a empresa para apoiar execução do plano de emergência levanta dúvidas","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2131924?tp=UH&db=IMAGENS&type=JPG","author":[{"id":19634,"nome":"Inês Schreck","descricao":"","email":"ines.schreck@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"ines-schreck","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#107;&#99;&#101;&#114;&#104;&#99;&#115;&#46;&#115;&#101;&#110;&#105;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Tutela fez dois contratos com a IQVIA, no valor de quase 83 mil euros. Tribunal de Contas estranha que não se tenha solicitado o apoio de estruturas internas, como a PLANAPP.","url":"/2026/11/19/sociedade/noticia/recurso-consultora-apoiar-execucao-plano-emergencia-saude-levanta-duvidas-tribunal-2195462","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Saúde","url":"https://www.publico.pt/2026/11/19/sociedade/noticia/recurso-consultora-apoiar-execucao-plano-emergencia-saude-levanta-duvidas-tribunal-2195462"},"id":2195462,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":16,"title":"Quatro dias para celebrar a Casa da Arquitetura","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2131494?tp=UH&db=IMAGENS&type=JPG","author":[],