m a bolsa Knight para jornalistas de ciência no MIT.","email":"teresa.firmino@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Editora de ciência","profissaoNaAltura":"","slug":"teresa-firmino","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Teresa_Firmino.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737916?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#110;&#105;&#109;&#114;&#105;&#102;&#46;&#97;&#115;&#101;&#114;&#101;&#116;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"O livro mais recente do botânico Jorge Paiva serviu de mote para criar um roteiro – nos jardins da Universidade de Coimbra – de plantas referidas por Luís de Camões.","url":"/2026/08/23/ciencia/noticia/jorge-paiva-apaixonouse-plantas-camoes-quis-mostralas-vivo-jardim-2185329","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":{"name":"fugas"},"brand":null,"rubric":{"name":"Cultura científica","url":"https://www.publico.pt/2026/08/23/ciencia/noticia/jorge-paiva-apaixonouse-plantas-camoes-quis-mostralas-vivo-jardim-2185329"},"id":2185329,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":11,"title":"Bitcoin valoriza 20% numa semana","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2111382?tp=UH&db=IMAGENS&type=JPG","author":[{"id":90,"nome":"Lusa","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"lusa","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"","contribuicao":"","tipo":"AGENCIA"}],"shares":0,"description":"Pedido de Trump para acelerar regulação dos criptoactivos e preocupação com a dívida da maior economia do 