spx/1818311?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#105;&#101;&#118;&#105;&#108;&#111;&#46;&#97;&#116;&#114;&#97;&#109;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Deputados já têm cálculos que servem de ponto de partida para o Orçamento do Estado para 2027. Finanças admitem gastar quase 2000 milhões de euros a mais em pensões no próximo ano.","url":"/2026/09/01/economia/noticia/novas-medidas-saldo-orcamental-agravase-4800-milhoes-euros-2027-2186705","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Orçamento do Estado","url":"https://www.publico.pt/2026/09/01/economia/noticia/novas-medidas-saldo-orcamental-agravase-4800-milhoes-euros-2027-2186705"},"id":2186705,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":2,"title":"A Europa dos grandes fechou o mercado (com um recorde). Portugal ficou com a chave","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2113141?tp=UH&db=IMAGENS&type=JPG","author":[{"id":6063,"nome":"Diogo Cardoso Oliveira","descricao":"Ver desporto, escrever e contar histórias: costumo dizer que sou pago para fazer algo que faria <i>pro-bono</i>. Tudo começou numa t-shirt branca, feita na escola primária, que já identificava um gaiato com más ideias: dizia “Diogo, o jornalista”. Feito um raide incompleto pela aviação, formei-me em Comunicação Social, época em que fazia do jornal universitário <i>Pontivirgula</i> uma tela para rascunhos do que estaria por vir. Comecei a carreira como estagiário no PÚBLICO, no mês em que Éder decidiu dar um chuto aos franceses. Ainda estive no <i>Record</i>, antes de fazer parte do início do site <i>Bancada</i>. Voltei para o PÚBLICO, que já me levou ao Mundial do Qatar, aos Jogos Olímpicos de Paris e onde faço um pouco de tudo no desporto. Gosto de ciclismo, basquetebol, ginástica, futebol, História e histórias — também por isso escrevi o livro <i>Futebol numa conversa de café</i>.","email":"diogo.oliveira@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"diogo-cardoso-oliveira","imagem":{"w":859,"h":1831,"largura":859,"altura":1831,"nome":"WhatsApp Image 2026-06-09 at 00.03.14.jpeg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/2094160?tp=UH&db=IMAGENS&type=JPG","is_vertical":true,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#105;&#101;&#118;&#105;&#108;&#111;&#46;&#111;&#103;&#111;&#105;&#100;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"O período para negócios no futebol fechou nesta terça-feira para os principais clubes. A Liga portuguesa é um caso à parte e vai poder comprar jogadores até ao final da semana.","url":"/2026/09/01/desporto/noticia/europa-fechou-mercado-recorde-portugal-ficou-chave-2186733","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Futebol","url":"https://www.publico.pt/2026/09/01/desporto/noticia/europa-fechou-mercado-recorde-portugal-ficou-chave-2186733"},"id":2186733,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":3,"title":"Neves garante que vai continuar a governar, Chega mantém em aberto moção de censura","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2113167?tp=UH&db=IMAGENS&type=JPG","author":[{"id":18186,"nome":"Joana Mesquita","descricao":"","email":"joana.mesquita@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"joana-mesquita","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#116;&#105;&#117;&#113;&#115;&#101;&#109;&#46;&#97;&#110;&#97;&#111;&#106;","contribuicao":"","tipo":"INTERNO"},{"id":3898,"nome":"Liliana Borges","descricao":"","email":"liliana.borges@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"liliana-pascoal-borges","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"liliana-borges.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1172095?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#103;&#114;&#111;&#98;&#46;&#97;&#110;&#97;&#105;&#108;&#105;&#108;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"O ministro da Administração Interna acredita que tem condições para continuar no cargo. Decisão do Chega sobre apresentação de uma moção de censura será conhecida esta quarta-feira.","url":"/2026/09/01/politica/noticia/neves-garante-vai-continuar-governar-chega-mantem-aberto-mocao-censura-2186743","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Ministro da Administração Interna","url":"https://www.publico.pt/2026/09/01/politica/noticia/neves-garante-vai-continuar-governar-chega-mantem-aberto-mocao-censura-2186743"},"id":2186743,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":4,"title":"EUA volta a atacar o Irão e Teerão retalia contra alvos norte-americanos na região","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2113132?tp=UH&db=IMAGENS&type=JPG","author":[{"id":19691,"nome":"Manuel Monteiro","descricao":"","email":"Manuel.Monteiro@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"manuelc-monteiro","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#114;&#105;&#101;&#116;&#110;&#111;&#77;&#46;&#108;&#101;&#117;&#110;&#97;&#77;","contribuicao":"","tipo":"INTERNO"},{"id":1026,"nome":"Agências","descricao":"","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"","profissaoNaAltura":"","slug":"agencias","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":"","tipo":"AGENCIAS"}],"shares":0,"description":"O Comando Central dos EUA anunciou de ataques contra alvos do Corpo dos Guardas da Revolução Islâmica e Irão lançou mísseis e drones visando interesses norte-americanos em toda a região.","url":"/2026/09/01/mundo/noticia/eua-estar-novamente-atacar-alvos-irao-2186726","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"EUA","url":"https://www.publico.pt/2026/09/01/mundo/noticia/eua-estar-novamente-atacar-alvos-irao-2186726"},"id":2186726,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":5,"title":"O Bangladesh chega a Veneza através de uma realizadora que o vai filmar em Portugal","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2112712?tp=UH&db=IMAGENS&type=JPG","author":[{"id":885,"nome":"Vasco Câmara","descricao":"Foi depois de ter entrado pela casa que Gloria Swanson teve em Sintra, onde vi junto à piscina um animal empalhado, que me deixaram, aqui no PÚBLICO, meter as mãos no cinema. Isto foi no início deste projecto jornalístico. Eu fui um dos 25 estagiários admitidos depois de um curso de meses que começou com 500 candidatos de todo o país. Após a história da estrela dos anos 20 que vinha descansar perto da praia das Maçãs, alguém me disse: “Faça as malas, amanhã vai para Cannes”. E foi, no ano do fósforo a arder no ecrã gigante do Palais des Festivals, o ano de “Wild at Heart” de Lynch. Se não fossem os filmes não saberia o que estaria a fazer aqui – e isso é verdade para o bigger picture: sem os filmes não saberia o que fazer.","email":"vasco.camara@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"vasco-camara","imagem":{"w":225,"h":225,"largura":225,"altura":225,"nome":"Vasco Camara.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/2113106?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#114;&#97;&#109;&#97;&#99;&#46;&#111;&#99;&#115;&#97;&#118;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Uma bela miniatura a concurso na secção Horizontes do Festival de Veneza, <em>A Noiva Difícil</em>, tem o dedo de Leonor Teles. Rubaiyat Hossain filmará a seguir em Lisboa o seu “isto não é o Bangladesh”.","url":"/2026/09/01/culturaipsilon/noticia/bangladesh-chega-veneza-atraves-realizadora-vai-filmar-portugal-2186231","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Cinema","url":"https://www.publico.pt/2026/09/01/culturaipsilon/noticia/bangladesh-chega-veneza-atraves-realizadora-vai-filmar-portugal-2186231"},"id":2186231,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30}]
