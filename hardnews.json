ize":30},{"pos":15,"title":"Brasil será o grande teste para o uso de IA em eleições, diz executivo da OpenAI","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2117146?tp=UH&db=IMAGENS&type=JPG","author":[{"id":14761,"nome":"Patrícia Campos Mello","descricao":"Folha de S.Paulo","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"patricia-campos-mello","imagem":{"w":null,"h":null,"largura":320,"altura":320,"nome":"Patricia Campos Mello.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1767374?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":",Jornalista","translations":null},"hasImage":true,"isExternal":true,"encodedEmail":"","contribuicao":"","tipo":"EXTERNO"}],"shares":0,"description":"Bruno Lewicki, responsável de políticas públicas da OpenAI para a América Latina, diz que muito do testado no Brasil “constituirá uma aprendizagem”, nomeadamente para as eleições de 2027 em França.","url":"/2026/09/19/mundo/entrevista/brasil-sera-teste-uso-inteligencia-artificial-eleicoes-mundo-executivo-openai-2188634","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Entrevista","url":"/brasil"},"id":2188634,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":16,"title":"Uma exposição para recordar que Arpad Szenes foi muito mais do que “o senhor Silva”","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2117021?tp=UH&db=IMAGENS&type=JPG","author":[{"id":431,"nome":"Isabel Salema","descricao":"Se pensar no que sou profissionalmente não sei se o que me define mais é a minha formação académica em História de Arte ou o meu percurso jornalístico entre a ciência e a cultura. Acho que o que aprendi nesses primeiros tempos na secção de ciência foi que não havia perguntas que não se fizessem, porque o pior mesmo era continuar sem perceber nada.\r\nFiquei oito anos a fazer jornalismo científico, que adorei, e depois passei para a secção de cultura, onde me tornei editora. Não foi bem um salto, porque trabalhar na área da cultura é trabalhar com a criação, com o novo, com ideias e algo de semelhante se passa na ciência. Depois, editei o caderno P2 e coordenei os suplementos do jornal. Actualmente, sou jornalista da Cultura.","email":"isabel.salema@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"isabel-salema","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Isabel_Salema.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/737807?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#109;&#101;&#108;&#97;&#115;&#46;&#108;&#101;&#98;&#97;&#115;&#105;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Quase 170 obras na Fundação Arpad Szenes — Vieira da Silva para apresentar o artista a uma nova geração: “uma fonte luminosa que ficou na sombra por uma causa maior”.","url":"/2026/09/19/culturaipsilon/noticia/exposicao-recordar-arpad-szenes-senhor-silva-2188582","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Artes","url":"https://www.publico.pt/2026/09/19/culturaipsilon/noticia/exposicao-recordar-arpad-szenes-senhor-silva-2188582"},"id":2188582,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":17,"title":"Caracalpaquistão? Um segredo entre rios, desertos e um mar desaparecido","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2117020?tp=UH&db=IMAGENS&type=JPG","author":[{"id":20404,"nome":"Miguel Judas","descricao":"Jornalista","email":"","facebook":null,"googlePlus":null,"twitter":null