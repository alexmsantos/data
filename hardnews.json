06175?tp=UH&db=IMAGENS&type=JPG","author":[{"id":6552,"nome":"Isabel Aveiro","descricao":"","email":"isabel.aveiro@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Subeditora de Economia","profissaoNaAltura":"","slug":"isabel-aveiro","imagem":{"w":null,"h":null,"largura":null,"altura":null,"nome":"Isabel  Aveiro.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1139753?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":null,"translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#114;&#105;&#101;&#118;&#97;&#46;&#108;&#101;&#98;&#97;&#115;&#105;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Parpública, <em>holding</em> pública que gere as participações empresariais do Estado, tem agora 30 dias para entregar relatório ao Governo.","url":"/2026/07/29/economia/noticia/privatizacao-tap-avanca-propostas-vinculativas-lufthansa-air-franceklm-2183429","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Aviação","url":"https://www.publico.pt/2026/07/29/economia/noticia/privatizacao-tap-avanca-propostas-vinculativas-lufthansa-air-franceklm-2183429"},"id":2183429,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":3,"title":"Árbitros recusam encontro com Proença após áudios polémicos","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2106154?tp=UH&db=IMAGENS&type=JPG","author":[{"id":7165,"nome":"Miguel Dantas","descricao":"","email":"miguel.dantas@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"miguel-dantas","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#97;&#116;&#110;&#97;&#100;&#46;&#108;&#101;&#117;&#103;&#105;&#109;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Presidente da FPF tentou marcar reunião, mas nenhum árbitro se mostrou disponível para conversar. Proença havia dito que eram “muito fracos”.","url":"/2026/07/29/desporto/noticia/arbitros-recusam-encontro-proenca-apos-audios-polemicos-2183408","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Futebol","url":"https://www.publico.pt/2026/07/29/desporto/noticia/arbitros-recusam-encontro-proenca-apos-audios-polemicos-2183408"},"id":2183408,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":4,"title":"Bolsa incentivo de 1075 euros será paga no próximo ano aos alunos mais pobres","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2106094?tp=UH&db=IMAGENS&type=JPG","author":[{"id":495,"nome":"Andreia Sanches","descricao":"Entrei no PÚBLICO em 1996. Tinha 22 anos, terminado o curso de Ciências da Comunicação na Universidade Nova de Lisboa e estava no jornal onde queria, de facto, começar a fazer jornalismo. Estagiei no Internacional, quando ainda fazíamos fila para aceder ao computador da redacção que estava ligado à Internet. Seguiu-se a Educação, onde fiquei vários anos, quando aquela era uma secção autónoma, diária. Já na Sociedade, o leque de temas sobre os quais passei a escrever alargou-se – a pobreza e as desigualdades, a exclusão e as políticas de protecção social são alguns dos que tenho acompanhado de forma mais sistemática. Em 2013 foi publicado o meu primeiro livro. Chama-se \"Os Anjos Não Comem Chocolate\" e tem como ponto de partida uma reportagem que fiz no PÚBLICO sobre pais que perderam os seus filhos. Ao longo dos últimos anos desempenhei funções de editora do P2, editora da Sociedade, editora-executiva e directora-adjunta.","email":"asanches@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Redactora principal","profissaoNaAltura":"Redactora principal","slug":"andreia-sanches","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"andreia-sanches-nova.png","legenda":null,"autor":null,"tipo":"PNG","url":"https://imagens.publico.pt/imagens.aspx/1748990?tp=UH&db=IMAGENS&type=PNG","is_vertical":false,"tags":"Andreia C. Faria","translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#115;&#101;&#104;&#99;&#110;&#97;&#115;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Bolsas não terão ainda em conta custo real de estudar. A grande mudança do novo regime de acção social foi adiada. Mas há medidas que avançam, como a Bolsa Incentivo. Que vai premiar os bons alunos.","url":"/2026/07/29/sociedade/noticia/bolsa-incentivo-1075-euros-sera-paga-proximo-ano-pobres-melhores-alunos-podem-continuar-recebela-anos-seguintes-2183379","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Acesso ao Ensino Superior 2026","url":"https://www.publico.pt/2026/07/29/sociedade/noticia/bolsa-incentivo-1075-euros-sera-paga-proximo-ano-pobres-melhores-alunos-podem-continuar-recebela-anos-seguintes-2183379"},"id":2183379,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":5,"title":"Governo aumenta valor a pagar por utentes que recebem cuidados continuados","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2106074?tp=UH&db=IMAGENS&type=JPG","author":[{"id":7050,"nome":"Ana Maia","descricao":"","email":"amaia@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"ana-maia","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#105;&#97;&#109;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Actualização junta revisão anual e uma majoração das diárias a pagar por utente. Governo reconhece necessidade de “garantir uma maior adequação aos custos reais”.","url":"/2026/07/29/sociedade/noticia/governo-aumenta-valor-pagar-utentes-recebem-cuidados-continuados-2183363","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Saúde","url":"https://www.publico.pt/2026/07/29/sociedade/noticia/governo-aumenta-valor-pagar-utentes-recebem-cuidados-continuados-2183363"},"id":2183363,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":6,"title":"Trabalhistas superam Reform nas sondagens: “efeito Burnham” ou declínio de Farage?","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2106148?tp=UH&db=IMAGENS&type=JPG","author":[{"id":5355,"nome":"António Saraiva Lima","descricao":"Pertenço a uma geração indefinida e vesti a camisola como poucos. Experimentei Direito, viajei e desviei-me. Pelo meio, escrevi. Licenciei-me em Ciência Política e Relações Internacionais, andei a debater sobre a Europa num <i>think tank</i>, e estagiei numa afamada organização internacional. Continuei a escrever. Tropecei no jornalismo em 2015, e logo no PÚBLICO, para um estágio na inigualável secção Mundo. Três meses de instrução diária, com os melhores dos melhores, que se alongaram para cinco. Sempre a escrever, mas também a perguntar e a ouvir. Ainda testei o ofício diplomático-consular, em Inglaterra, apenas para confirmar que a indefinição que me corria no sangue estava afinal fora de prazo. Voltei para Lisboa, realistei-me no jornalismo, pela mão do <i>i</i> e do <i>Sol</i>, e terminei um mestrado em Estudos Europeus. Permanentemente a escrever. No início de 2018 voltei à casa de partida – precisamente no meio do tabuleiro e deste texto.","email":"antonio.lima@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"Jornalista","slug":"antonio-saraiva-lima","imagem":{"w":null,"h":null,"largura":225,"altura":225,"nome":"Antonio Saraiva Lima.jpg","legenda":null,"autor":null,"tipo":"JPG","url":"https://imagens.publico.pt/imagens.aspx/1527215?tp=UH&db=IMAGENS&type=JPG","is_vertical":false,"tags":",Norges teknisk-naturvitenskaplige universitet","translations":null},"hasImage":true,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#97;&#109;&#105;&#108;&#46;&#111;&#105;&#110;&#111;&#116;&#110;&#97;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Com novo líder e primeiro-ministro, Partido Trabalhista ultrapassa direita radical nas intenções de voto dos britânicos. Polémica dos donativos castiga Reform.","url":"/2026/07/29/mundo/noticia/ano-labour-supera-reform-sondagens-efeito-burnham-declinio-farage-2183407","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Reino Unido","url":"https://www.publico.pt/2026/07/29/mundo/noticia/ano-labour-supera-reform-sondagens-efeito-burnham-declinio-farage-2183407"},"id":2183407,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":7,"title":"EUA e Arábia Saudita juntam-se para ataque no Iraque, Irão volta aos mísseis","isPremium":true,"image":"https://imagens.publico.pt/imagens.aspx/2105998?tp=UH&db=IMAGENS&type=JPG","author":[{"id":17560,"nome":"Leonor Alhinho","descricao":"","email":"leonor.alhinho@publico.pt","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista","profissaoNaAltura":"","slug":"leonor-alhinho","imagem":null,"hasImage":false,"isExternal":false,"encodedEmail":"&#116;&#112;&#46;&#111;&#99;&#105;&#108;&#98;&#117;&#112;&#64;&#111;&#104;&#110;&#105;&#104;&#108;&#97;&#46;&#114;&#111;&#110;&#111;&#101;&#108;","contribuicao":"","tipo":"INTERNO"}],"shares":0,"description":"Teerão reivindicou um ataque com mísseis contra uma base dos EUA na Jordânia. Riade assume papel militar mais activo perante ataque dos houthis, aumentando a tensão ao nível regional.","url":"/2026/07/29/mundo/noticia/eua-arabia-saudita-juntamse-atacar-iraque-irao-lanca-misseis-base-norteamericana-2183337","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Médio Oriente","url":"https://www.publico.pt/2026/07/29/mundo/noticia/eua-arabia-saudita-juntamse-atacar-iraque-irao-lanca-misseis-base-norteamericana-2183337"},"id":2183337,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":8,"title":"Ou Jair Bolsonaro volta para a prisão ou Flávio Bolsonaro violou a lei eleitoral","isPremium":false,"image":"https://imagens.publico.pt/imagens.aspx/2106156?tp=UH&db=IMAGENS&type=JPG","author":[{"id":15052,"nome":"Mônica Bergamo","descricao":"Jornalista e colunista Folha de S.Paulo","email":"","facebook":null,"googlePlus":null,"twitter":null,"site":null,"url":null,"localizacao":"","profissaoActual":"Jornalista e colunista Folha de S.Paulo","profissaoNaAltura":"Jornalista e colunista Folha de S.Paulo","slug":"monica-bergamo","imagem":null,"hasImage":false,"isExternal":true,"encodedEmail":"","contribuicao":"","tipo":"EXTERNO"}],"shares":0,"description":"Senador lançou a candidatura presidencial no sábado com um vídeo de IA com a imagem do ex-Presidente actualmente em prisão domiciliária e impedido pela justiça de intervenções públicas.","url":"/2026/07/29/mundo/noticia/jair-bolsonaro-volta-prisao-flavio-bolsonaro-violou-lei-eleitoral-brasil-2183418","comments":0,"spoonsored":false,"isOpinion":false,"homeBrand":null,"brand":null,"rubric":{"name":"Jair Bolsonaro","url":"https://www.publico.pt/2026/07/29/mundo/noticia/jair-bolsonaro-volta-prisao-flavio-bolsonaro-violou-lei-eleitoral-brasil-2183418"},"id":2183418,"type":"NOTICIA","isMultipleRubric":false,"tag":null,"size":30},{"pos":9,"title":"“Baratas” que fizeram a maior crise de Modi não baixam os braços na Índia","isPremium":true,"image":"https://imagens.publico.pt